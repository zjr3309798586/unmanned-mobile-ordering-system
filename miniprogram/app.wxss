page {
  min-height: 100vh;
  color: #102033;
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
  background: #f4f8ff;
}

view,
text,
button,
input,
textarea,
image,
navigator {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  border: 0;
  line-height: 1.2;
  background: transparent;
}

button::after {
  border: 0;
}

.app-shell {
  position: relative;
  width: 100%;
  min-height: 100vh;
  overflow-x: hidden;
  background: #f4f8ff;
}

.page {
  min-height: 100vh;
}

.top-area {
  position: relative;
  z-index: 8;
  padding: 24rpx 24rpx 20rpx;
  background: rgba(244, 248, 255, 0.96);
}

.page-main {
  padding: 0 24rpx 172rpx;
}

.page-main.with-floating-bar,
.with-floating-bar {
  padding-bottom: 294rpx;
}

.store-card,
.section-card,
.card {
  border: 1rpx solid #e2ecfb;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 36rpx rgba(20, 48, 96, 0.06);
}

.store-card {
  padding: 26rpx;
}

.compact-store {
  padding: 24rpx;
}

.section-card,
.card {
  margin-top: 20rpx;
  padding: 26rpx;
}

.section-card:first-child {
  margin-top: 0;
}

.store-header,
.section-head,
.price-line,
.summary-row,
.quantity-row,
.order-card-head,
.cart-item-head,
.detail-price-line,
.row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.store-label {
  display: inline-flex;
  align-items: center;
  min-height: 44rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  color: #1f6fff;
  font-size: 22rpx;
  font-weight: 700;
  background: #eaf1ff;
}

.store-name,
.page-title {
  margin-top: 14rpx;
  line-height: 1.2;
}

.store-name {
  font-size: 42rpx;
  font-weight: 800;
}

.page-title,
.title {
  font-size: 44rpx;
  font-weight: 800;
}

.store-meta,
.action-row,
.tag-row,
.choice-row,
.hero-actions,
.floating-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.store-meta {
  margin-top: 18rpx;
}

.meta-pill,
.store-meta text {
  display: inline-flex;
  align-items: center;
  min-height: 48rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  color: #66748a;
  font-size: 22rpx;
  font-weight: 600;
  background: #f7fbff;
}

.store-address,
.info-text,
.product-desc,
.profile-text,
.section-note,
.tiny-note,
.muted {
  margin-top: 16rpx;
  color: #66748a;
  font-size: 24rpx;
  line-height: 1.58;
}

.search-bar,
.search {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 16rpx;
  padding: 20rpx 22rpx;
  border: 1rpx solid #e2ecfb;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(20, 48, 96, 0.06);
}

.search-icon,
.nav-icon,
.feature-icon,
.service-icon,
.benefit-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  color: #1f6fff;
  font-size: 24rpx;
  font-weight: 800;
  background: #eaf1ff;
}

.nav-icon {
  overflow: hidden;
  flex: 0 0 auto;
}

.nav-logo-icon {
  width: 44rpx;
  height: 44rpx;
}

.search-input,
.search input {
  flex: 1;
  min-width: 0;
  color: #102033;
  font-size: 26rpx;
}

.section-head {
  margin-bottom: 20rpx;
}

.compact-head {
  margin-bottom: 16rpx;
}

.section-title,
.product-name,
.member-title,
.info-title {
  font-size: 31rpx;
  font-weight: 800;
  line-height: 1.35;
}

.section-link,
.mini-link,
.text-action,
.back-link {
  color: #1f6fff;
  font-size: 24rpx;
  font-weight: 700;
}

.button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 80rpx;
  padding: 0 30rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
  font-weight: 800;
}

.button-primary,
.button.primary {
  color: #ffffff;
  background: #1f6fff;
  box-shadow: 0 16rpx 36rpx rgba(31, 94, 255, 0.22);
}

.button[disabled] {
  color: #93a2b8;
  background: #f1f3f6;
  box-shadow: none;
}

.button-secondary,
.button.secondary {
  color: #1f6fff;
  border: 1rpx solid #d7e3ff;
  background: #eaf1ff;
}

.hero-badge,
.tag,
.choice-chip,
.status-pill,
.tab-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 48rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
}

.hero-badge,
.tag {
  color: #1f6fff;
  background: #eaf1ff;
}

.warm-badge {
  color: #ff6b2c;
  background: #fff1e6;
}

.muted-tag,
.status-pill,
.tab-chip {
  color: #66748a;
  background: #edf5ff;
}

.status-pill.is-open {
  color: #24b47e;
  background: #e9f8f1;
}

.choice-chip {
  min-height: 64rpx;
  padding: 0 24rpx;
  border: 1rpx solid transparent;
  color: #66748a;
  background: #edf5ff;
}

.choice-chip.is-active,
.tab-chip.is-active {
  color: #1f6fff;
  border-color: #cfdcff;
  background: #eaf1ff;
}

.product-stack,
.summary-list,
.announcement-list,
.benefit-list,
.order-list,
.menu-item-list,
.cart-item-list,
.service-list,
.coupon-stack,
.coupon-select-list,
.submit-item-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.product-card,
.cart-item,
.menu-item-card {
  display: grid;
  grid-template-columns: 168rpx minmax(0, 1fr);
  gap: 20rpx;
  padding: 22rpx;
  border: 1rpx solid #e2ecfb;
  border-radius: 20rpx;
  background: #ffffff;
}

.cover-thumb,
.avatar-thumb {
  width: 100%;
  border-radius: 16rpx;
  background: #f7fbff;
}

.cover-thumb {
  width: 168rpx;
  height: 168rpx;
}

.avatar-thumb {
  width: 152rpx;
  height: 152rpx;
}

.product-body,
.cart-item-main,
.profile-copy {
  min-width: 0;
}

.price-line,
.detail-price-line {
  margin-top: 16rpx;
  align-items: center;
}

.price,
.accent-price,
.floating-price,
.hero-price {
  color: #f04b1f;
  font-size: 40rpx;
  font-weight: 900;
  line-height: 1;
}

.small-price {
  font-size: 36rpx;
}

.discount-price {
  color: #e4543f;
}

.summary-row {
  align-items: center;
  min-height: 48rpx;
  font-size: 26rpx;
}

.total-row {
  padding-top: 20rpx;
  border-top: 1rpx solid #e2ecfb;
}

.info-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  padding: 20rpx 0;
}

.info-row + .info-row {
  border-top: 1rpx solid #e2ecfb;
}

.no-divider {
  padding-top: 0;
  padding-bottom: 0;
}

.floating-bar {
  position: fixed;
  left: 20rpx;
  right: 20rpx;
  bottom: calc(152rpx + env(safe-area-inset-bottom));
  z-index: 9;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 20rpx;
  border: 1rpx solid rgba(31, 111, 255, 0.1);
  border-radius: 48rpx;
  color: #102033;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 40rpx 92rpx rgba(31, 111, 255, 0.18);
}

.floating-summary {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.floating-label {
  color: #66748a;
  font-size: 22rpx;
}

.floating-bar .floating-price {
  color: #f04b1f;
}

.floating-bar .button-secondary {
  color: #ffffff;
  border-color: #1f6fff;
  background: linear-gradient(135deg, #2f80ff 0%, #1f6fff 100%);
}

.bottom-nav {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 4rpx;
  min-height: 152rpx;
  padding: 16rpx 16rpx calc(16rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #e2ecfb;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 -16rpx 40rpx rgba(20, 48, 96, 0.08);
}

.nav-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  min-height: 108rpx;
  color: #93a2b8;
  font-size: 22rpx;
  font-weight: 700;
}

.nav-item.is-active {
  color: #1f6fff;
}

.nav-item.is-active .nav-icon {
  color: #ffffff;
  background: #1f6fff;
  box-shadow: 0 12rpx 28rpx rgba(31, 94, 255, 0.2);
}

.nav-item.is-active .nav-logo-icon {
  transform: scale(1.05);
}

.stepper {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  padding: 6rpx;
  border-radius: 999rpx;
  background: #edf5ff;
}

.stepper button,
.stepper text {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  font-size: 26rpx;
  font-weight: 800;
}

.stepper button {
  color: #1f6fff;
  background: #ffffff;
}

.text-input,
.text-area,
.field {
  width: 100%;
  padding: 24rpx;
  border: 1rpx solid #e2ecfb;
  border-radius: 20rpx;
  color: #102033;
  font-size: 26rpx;
  background: #f7fbff;
}

.text-area,
.remark-field {
  min-height: 160rpx;
}

.hidden-card {
  display: none;
}

.empty-state,
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx 12rpx;
  color: #66748a;
  text-align: center;
}

.empty-title {
  color: #102033;
  font-size: 30rpx;
  font-weight: 800;
}

.row-arrow {
  color: #93a2b8;
  font-size: 44rpx;
  line-height: 1;
}

.mt {
  margin-top: 16rpx;
}

/* Yunbao public components: shared WXSS theme, no business behavior. */
.theme-card,
.store-card,
.section-card,
.card,
.product-card,
.cart-item,
.menu-item-card {
  border: 1rpx solid rgba(31, 111, 255, 0.1);
  border-radius: 36rpx;
  background: #ffffff;
  box-shadow: 0 28rpx 72rpx rgba(31, 111, 255, 0.1);
}

.theme-card.is-large,
.hero-card,
.pass-card {
  border-radius: 48rpx;
}

.button,
.btn,
.button-primary,
.button-secondary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 0 36rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 900;
}

.button-primary,
.btn-primary,
.button.primary {
  color: #ffffff;
  background: linear-gradient(135deg, #2f80ff 0%, #1f6fff 54%, #075cff 100%);
  box-shadow: 0 28rpx 56rpx rgba(31, 111, 255, 0.24);
}

.button-secondary,
.btn-secondary,
.button.secondary {
  color: #1f6fff;
  border: 1rpx solid #cfe0f7;
  background: rgba(255, 255, 255, 0.92);
}

.price,
.accent-price,
.floating-price,
.hero-price,
.summary-total,
.pay-price {
  color: #f04b1f;
  font-weight: 900;
}

.tag,
.hero-badge,
.status-pill,
.tab-chip,
.mini-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 48rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  color: #1f6fff;
  font-size: 24rpx;
  font-weight: 800;
  background: #eaf3ff;
}

.warm-badge,
.tag.is-warm,
.mini-tag.is-warm {
  color: #ff6b2c;
  background: #fff0e8;
}

.status-pill.is-open,
.tag.is-success,
.mini-tag.is-success {
  color: #24b47e;
  background: #e9f8f2;
}

.choice-chip,
.tab-chip {
  border: 1rpx solid #e2ecfb;
  color: #102033;
  background: #f7fbff;
}

.choice-chip.is-active,
.tab-chip.is-active {
  color: #ffffff;
  border-color: #1f6fff;
  background: linear-gradient(135deg, #2f80ff 0%, #1f6fff 100%);
  box-shadow: 0 16rpx 44rpx rgba(31, 111, 255, 0.18);
}

.cover-thumb,
.avatar-thumb,
.image-placeholder {
  border-radius: 36rpx;
  background:
    linear-gradient(135deg, rgba(31, 111, 255, 0.08), rgba(255, 255, 255, 0.9)),
    #edf5ff;
}
