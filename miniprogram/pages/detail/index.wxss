.detail-top-area {
  padding-bottom: 0;
}

.detail-hero-card {
  margin-top: 0;
  padding: 20rpx;
}

.detail-cover {
  width: 100%;
  aspect-ratio: 4 / 3;
  border-radius: 20rpx;
  background: #f7f9fd;
}

.detail-badge-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.quantity-row {
  align-items: center;
}

.detail-action-bar .button {
  min-width: 208rpx;
}

.action-stack {
  justify-content: flex-end;
}
