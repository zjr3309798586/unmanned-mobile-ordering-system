<view class="app-shell" wx:if="{{product}}">
  <view class="top-area detail-top-area">
    <navigator class="back-link" url="/pages/menu/index" open-type="redirect">返回菜单</navigator>
    <view class="page-title">商品详情</view>
  </view>

  <view class="page-main with-floating-bar">
    <view class="section-card detail-hero-card">
      <image class="detail-cover" src="{{product.imageUrl}}" mode="aspectFill" />
      <view class="detail-badge-row">
        <text class="tag">热卖单品</text>
        <text class="tag muted-tag">支持自定义口味</text>
      </view>
    </view>

    <view class="section-card">
      <view class="section-head">
        <view>
          <view class="section-title">{{product.name}}</view>
          <view class="section-note">月售 {{product.sales}} 杯，好评率 98%</view>
        </view>
      </view>
      <view class="product-desc">{{product.description}}</view>
      <view class="detail-price-line">
        <text class="price">{{product.priceText}}</text>
        <text class="tiny-note">默认中杯，支持温度、甜度和加料选择</text>
      </view>
    </view>

    <view class="section-card">
      <view class="section-head compact-head">
        <view>
          <view class="section-title">温度选择</view>
          <view class="section-note">会保存到购物车规格</view>
        </view>
      </view>
      <view class="choice-row">
        <button class="choice-chip {{item.active ? 'is-active' : ''}}" wx:for="{{temperatureOptions}}" wx:key="value" data-value="{{item.value}}" bindtap="chooseTemperature">{{item.value}}</button>
      </view>
    </view>

    <view class="section-card">
      <view class="section-head compact-head">
        <view>
          <view class="section-title">甜度选择</view>
          <view class="section-note">会保存到购物车规格</view>
        </view>
      </view>
      <view class="choice-row">
        <button class="choice-chip {{item.active ? 'is-active' : ''}}" wx:for="{{sugarOptions}}" wx:key="value" data-value="{{item.value}}" bindtap="chooseSugar">{{item.value}}</button>
      </view>
    </view>

    <view class="section-card">
      <view class="section-head compact-head">
        <view>
          <view class="section-title">加料选择</view>
          <view class="section-note">可多选，按所选规格保存</view>
        </view>
      </view>
      <view class="choice-row">
        <button class="choice-chip {{item.active ? 'is-active' : ''}}" wx:for="{{toppingOptions}}" wx:key="value" data-value="{{item.value}}" bindtap="toggleTopping">{{item.value}}</button>
      </view>
    </view>

    <view class="section-card quantity-card">
      <view class="section-head compact-head">
        <view>
          <view class="section-title">购买数量</view>
          <view class="section-note">支持加减调节</view>
        </view>
      </view>
      <view class="quantity-row">
        <text class="tiny-note">当前选择会同步到底部金额区域</text>
        <view class="stepper">
          <button data-delta="-1" bindtap="changeQuantity">-</button>
          <text>{{quantity}}</text>
          <button data-delta="1" bindtap="changeQuantity">+</button>
        </view>
      </view>
    </view>

    <view class="section-card">
      <view class="section-head">
        <view>
          <view class="section-title">商品描述</view>
          <view class="section-note">商品说明</view>
        </view>
      </view>
      <view class="info-text">{{product.description}}</view>
    </view>
  </view>

  <view class="floating-bar detail-action-bar">
    <view class="floating-summary">
      <text class="floating-label">合计金额</text>
      <text class="floating-price">{{totalText}}</text>
      <text class="floating-label">当前已选 {{quantity}} 杯</text>
    </view>
    <view class="floating-actions action-stack">
      <button class="button button-secondary" bindtap="addToCart">加入购物车</button>
      <button class="button button-primary" data-buy="true" bindtap="addToCart">立即购买</button>
    </view>
  </view>

  <view class="bottom-nav">
    <navigator class="nav-item" url="/pages/home/index" open-type="redirect"><text class="nav-icon">首</text><text>首页</text></navigator>
    <navigator class="nav-item is-active" url="/pages/menu/index" open-type="redirect"><text class="nav-icon">餐</text><text>点餐</text></navigator>
    <navigator class="nav-item" url="/pages/saving-card/index" open-type="redirect"><text class="nav-icon">卡</text><text>省钱卡</text></navigator>
    <navigator class="nav-item" url="/pages/order/index" open-type="redirect"><text class="nav-icon">单</text><text>订单</text></navigator>
    <navigator class="nav-item" url="/pages/mine/index" open-type="redirect"><text class="nav-icon">我</text><text>我的</text></navigator>
  </view>
</view>
