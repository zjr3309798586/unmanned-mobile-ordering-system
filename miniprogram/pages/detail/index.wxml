<view class="detail-shell">

  <view class="d-img-wrap">
    <view class="d-topbar">
      <view class="d-icon-btn" bindtap="goBack">
        <image class="d-icon-img" src="/images/icons/d-back.svg" mode="aspectFit"/>
      </view>
      <view class="d-top-right">
        <view class="d-icon-btn">
          <image class="d-icon-img is-share" src="/images/icons/detail-share.svg" mode="aspectFit"/>
        </view>
        <view class="d-top-pill">
          <view class="d-pill-dots"><view class="d-dot"></view><view class="d-dot"></view><view class="d-dot"></view></view>
          <view class="d-pill-sep"></view>
          <image class="d-pill-loc" src="/images/icons/detail-target.svg" mode="aspectFit"/>
        </view>
      </view>
    </view>
    <image class="d-hero-img" src="{{product.imageUrl}}" mode="aspectFit"/>
  </view>

  <view class="d-main">

    <view class="d-head-row">
      <view class="d-head-text">
        <text class="d-name">{{product.name}}</text>
        <text class="d-desc">{{product.description}}</text>
      </view>
      <view class="d-fav {{isFav ? 'is-active' : ''}}" bindtap="toggleFav">
        <text class="d-fav-icon">{{isFav ? '★' : '☆'}}</text>
        <text class="d-fav-label">口味收藏</text>
      </view>
    </view>

    <view class="d-divider"></view>

    <view class="d-options">
      <view class="d-opt-row">
        <view class="d-opt-label"><text>规格</text><text class="d-opt-star">*</text></view>
        <view class="d-opt-btns">
          <view class="d-opt-btn is-active"><text>中¥{{product.priceInt}}</text></view>
        </view>
      </view>

      <view class="d-opt-row">
        <view class="d-opt-label"><text>温度</text><text class="d-opt-star">*</text></view>
        <view class="d-opt-btns">
          <view class="d-opt-btn {{tempIdx === idx ? 'is-active' : ''}}" wx:for="{{tempOpts}}" wx:key="*this" wx:for-index="idx" data-group="temp" data-idx="{{idx}}" bindtap="chooseOpt">
            <text>{{item}}</text>
          </view>
        </view>
      </view>

      <view class="d-opt-row">
        <view class="d-opt-label"><text>选糖</text><text class="d-opt-star">*</text></view>
        <view class="d-opt-btns">
          <view class="d-opt-btn {{sugarTypeIdx === idx ? 'is-active' : ''}}" wx:for="{{sugarTypeOpts}}" wx:key="*this" wx:for-index="idx" data-group="sugarType" data-idx="{{idx}}" bindtap="chooseOpt">
            <text>{{item}}</text>
          </view>
        </view>
      </view>

      <view class="d-opt-row">
        <view class="d-opt-label"><text>甜度</text><text class="d-opt-star">*</text></view>
        <view class="d-opt-btns">
          <view class="d-opt-btn {{sweetIdx === idx ? 'is-active' : ''}}" wx:for="{{sweetOpts}}" wx:key="*this" wx:for-index="idx" data-group="sweet" data-idx="{{idx}}" bindtap="chooseOpt">
            <text>{{item}}</text>
          </view>
        </view>
      </view>
    </view>

  </view>

  <view class="d-footer">
    <view class="d-foot-row">
      <view class="d-price-line">
        <text class="d-pr-yuan">¥</text>
        <text class="d-pr-int">{{totalPrice}}</text>
        <text class="d-pr-tip">到手价<text class="d-pr-tip-q">?</text></text>
        <text class="d-pr-origin">¥15</text>
        <text class="d-pr-origin">¥{{product.priceInt}}</text>
      </view>
      <view class="d-qty">
        <view class="d-qty-minus" bindtap="minusQty"><text>−</text></view>
        <text class="d-qty-num">{{quantity}}</text>
        <view class="d-qty-plus" bindtap="plusQty"><text>+</text></view>
      </view>
    </view>

    <view class="d-spec-summary">{{specSummary}}</view>

    <view class="d-cta" bindtap="addToCart">加入购物车</view>
  </view>

</view>
