<view class="page menu-page with-bar">
  <view class="card" wx:if="{{store}}">
    <view class="row">
      <view>
        <text class="tag blue">点餐门店</text>
        <view class="title mt">{{store.name}}</view>
      </view>
      <text class="tag">制作中约12分钟</text>
    </view>
    <view class="muted mt">{{store.distance}} · {{store.businessHours}}</view>
  </view>

  <view class="search">
    <text>搜</text>
    <input placeholder="搜索商品、口味、套餐" value="{{keyword}}" bindinput="onKeywordInput" />
  </view>

  <view class="menu-layout">
    <scroll-view class="category-panel" scroll-y>
      <view class="category {{activeCategory === 'all' ? 'active' : ''}}" data-id="all" bindtap="selectCategory">全部商品</view>
      <view class="category {{activeCategory === item.id ? 'active' : ''}}" wx:for="{{categories}}" wx:key="id" data-id="{{item.id}}" bindtap="selectCategory">{{item.name}}</view>
    </scroll-view>

    <scroll-view class="product-panel" scroll-y>
      <view class="product-card" wx:for="{{visibleProducts}}" wx:key="id">
        <image class="product-img" src="{{item.imageUrl}}" mode="aspectFill" data-id="{{item.id}}" bindtap="goDetail" />
        <view class="product-info">
          <view class="tag-row">
            <text class="tag" wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this">{{tag}}</text>
          </view>
          <view class="product-name" data-id="{{item.id}}" bindtap="goDetail">{{item.name}}</view>
          <view class="product-desc">{{item.description}}</view>
          <view class="row mt">
            <text class="price">{{item.priceText}}</text>
            <view class="add-area">
              <text class="count">{{item.selectedCount}}</text>
              <button class="add-btn" data-id="{{item.id}}" bindtap="addToCart">+</button>
            </view>
          </view>
        </view>
      </view>
      <view class="empty" wx:if="{{visibleProducts.length === 0}}">
        <view class="empty-title">暂无匹配商品</view>
        <view class="muted">换个关键词试试。</view>
      </view>
    </scroll-view>
  </view>

  <view class="floating-bar cart-bar {{cartExpanded ? 'expanded' : ''}}" wx:if="{{cartSummary.totalQuantity}}" bindtap="toggleCart">
    <view class="cart-preview" wx:if="{{cartExpanded}}">
      <view class="cart-row" wx:for="{{cartSummary.items}}" wx:key="id">
        <text>{{item.productName}} × {{item.quantity}}</text>
        <text>{{item.spec}}</text>
      </view>
    </view>
    <view class="row cart-main">
      <view>
        <view class="muted">已选 {{cartSummary.totalQuantity}} 件</view>
        <view class="bar-price">{{cartSummary.totalText}}</view>
      </view>
      <button class="button primary" catchtap="goCart">去结算</button>
    </view>
  </view>
</view>
