<view class="menu-shell">

  <view class="menu-header">

    <view class="mh-top-row">
      <view class="mh-tabs">
        <view class="mh-tab {{orderMode === 'pickup' ? 'is-active' : ''}}" data-mode="pickup" bindtap="switchOrderMode"><text>自取</text><view class="mh-tab-bar"></view></view>
        <text class="mh-tab-sep">|</text>
        <view class="mh-tab {{orderMode === 'delivery' ? 'is-active' : ''}}" data-mode="delivery" bindtap="switchOrderMode"><text>外卖</text><view class="mh-tab-bar"></view></view>
      </view>
      <view class="mh-actions">
        <view class="mh-icon-btn" bindtap="openSearch"><image class="mh-action-icon" src="/images/icons/mh-search.svg" mode="aspectFit"/></view>
        <view class="mh-pill-group">
          <view class="mh-pill-btn"><image class="mh-pill-icon" src="/images/icons/mh-dots.svg" mode="aspectFit"/></view>
          <view class="mh-pill-sep"></view>
          <view class="mh-pill-btn"><image class="mh-pill-icon" src="/images/icons/mh-scan.svg" mode="aspectFit"/></view>
        </view>
      </view>
    </view>

    <view class="mh-store">
      <image class="mh-store-star" src="/images/icons/mh-star.svg" mode="aspectFit"/>
      <text class="mh-store-name">云豹小点·校园店</text>
      <image class="mh-store-arrow" src="/images/icons/mh-store-arrow.svg" mode="aspectFit"/>
    </view>

    <view class="mh-meta">
      <text>距离您1.10km</text>
      <text class="mh-meta-sep">|</text>
      <view class="mh-meta-tag">{{orderModeText}}</view>
    </view>

    <view class="mh-promo-row">
      <view class="mh-promo-text">
        <image class="mh-promo-icon" src="/images/icons/mh-promo.svg" mode="aspectFit"/>
        <text class="mh-promo-label">高品质茶饮全场9.9元喝</text>
        <image class="mh-promo-arrow" src="/images/icons/mh-down.svg" mode="aspectFit"/>
      </view>
      <view class="mh-promo-btn">拼单</view>
    </view>
  </view>

  <view class="menu-body">

    <scroll-view class="menu-side" scroll-y="true" enable-flex="true">
      <view class="ms-list">
        <view class="ms-item {{activeCat === item.id ? 'is-active' : ''}}" wx:for="{{categories}}" wx:key="id" data-id="{{item.id}}" bindtap="switchCat">
          <view class="ms-active-bar" wx:if="{{activeCat === item.id}}"></view>
          <text class="ms-label">{{item.name}}</text>
        </view>
      </view>
    </scroll-view>

    <scroll-view class="menu-list" scroll-y="true" enable-flex="true">
      <view class="ml-cat-head">{{catTitle}}</view>
      <view class="ml-items">

        <view class="m-card" wx:for="{{products}}" wx:key="id" data-id="{{item.id}}" bindtap="goDetail">
          <view class="m-cover">
            <image class="m-cover-img" src="{{item.imageUrl}}" mode="aspectFit"/>
          </view>
          <view class="m-body">
            <view class="m-name">{{item.name}}</view>
            <view class="m-attr-row">
              <view class="m-tag-attr">{{item.description}}</view>
            </view>
            <view class="m-price-row">
              <view class="m-price">
                <text class="m-yuan">¥</text><text class="m-int">{{item.priceInt}}</text><text class="m-dec">{{item.priceDec}}</text>
              </view>
              <view class="m-stepper" catchtap="noop">
                <view class="m-minus {{item.qty > 0 ? 'is-show' : ''}}" catchtap="minusCart" data-id="{{item.id}}"><image class="m-minus-icon" src="/images/icons/d-minus.svg" mode="aspectFit"/></view>
                <text class="m-qty" wx:if="{{item.qty > 0}}">{{item.qty}}</text>
                <view class="m-add" catchtap="addCart" data-id="{{item.id}}"><image class="m-add-icon" src="/images/icons/plus-white.svg" mode="aspectFit"/></view>
              </view>
            </view>
          </view>
        </view>

        <view class="ml-empty" wx:if="{{products.length === 0}}">
          <text>该分类暂无商品</text>
        </view>

      </view>
    </scroll-view>
  </view>

  <view class="coupon-float" bindtap="openCouponDrawer">
    <text class="cf-num">{{couponCount || 0}}</text>
    <text class="cf-label">优惠券</text>
  </view>

  <view class="coupon-mask {{couponDrawerOpen ? 'is-open' : ''}}" bindtap="closeCouponDrawer"></view>
  <view class="coupon-drawer {{couponDrawerOpen ? 'is-open' : ''}}" catchtap="noop">
    <view class="coupon-drawer-head">
      <view>
        <text class="coupon-title">我的优惠券</text>
      </view>
      <text class="coupon-close" bindtap="closeCouponDrawer">关闭</text>
    </view>
    <view class="coupon-list">
      <block wx:if="{{couponItems.length}}">
        <view class="coupon-item" wx:for="{{couponItems}}" wx:key="id">
          <view class="coupon-money">¥{{item.discountAmount}}</view>
          <view class="coupon-copy">
            <text class="coupon-copy-title">{{item.title}}</text>
            <text class="coupon-copy-desc">{{item.conditionText}}</text>
          </view>
        </view>
      </block>
      <view class="coupon-empty" wx:else>
        <text>还没领过优惠券</text>
        <view class="coupon-empty-action" catchtap="goSavingCard">去省钱卡领券</view>
      </view>
    </view>
    <navigator class="cd-go-cart" url="/pages/cart/index" open-type="navigate">去购物车使用 ›</navigator>
  </view>

  <!-- 搜索 overlay -->
  <view class="search-overlay {{searchOpen ? 'is-open' : ''}}">
    <view class="so-bar">
      <view class="so-input-wrap">
        <image class="so-input-icon" src="/images/icons/mh-search.svg" mode="aspectFit"/>
        <input class="so-input" placeholder="搜索商品名称" value="{{searchKw}}" bindinput="onSearchInput" focus="{{searchOpen}}"/>
      </view>
      <view class="so-cancel" bindtap="closeSearch">取消</view>
    </view>
    <scroll-view class="so-results" scroll-y="true">
      <view class="so-empty" wx:if="{{!searchKw}}">输入关键字搜索商品</view>
      <view class="so-empty" wx:elif="{{searchHits.length === 0}}">没找到相关商品</view>
      <block wx:else>
        <navigator class="so-item" wx:for="{{searchHits}}" wx:key="id" url="/pages/detail/index?id={{item.id}}" hover-class="none">
          <image class="so-thumb" src="{{item.imageUrl}}" mode="aspectFit"/>
          <view class="so-body">
            <text class="so-name">{{item.name}}</text>
            <text class="so-desc">{{item.description}}</text>
          </view>
          <text class="so-price">¥{{item.priceText}}</text>
        </navigator>
      </block>
    </scroll-view>
  </view>

  <!-- 购物车抽屉 -->
  <view class="cart-mask {{drawerOpen ? 'is-open' : ''}}" bindtap="closeDrawer"></view>
  <view class="cart-drawer {{drawerOpen ? 'is-open' : ''}}" catchtap="noop">
    <view class="cd-head">
      <text class="cd-title">已选商品</text>
      <view class="cd-clear" bindtap="clearCart">
        <image class="cd-clear-icon" src="/images/icons/trash.svg" mode="aspectFit"/>
        <text>清空</text>
      </view>
    </view>
    <scroll-view class="cd-list" scroll-y="true">
      <block wx:if="{{cartItems.length > 0}}">
        <view class="cd-item" wx:for="{{cartItems}}" wx:key="id">
          <image class="cd-thumb" src="{{item.imageUrl}}" mode="aspectFit"/>
          <view class="cd-body">
            <text class="cd-name">{{item.productName}}</text>
            <text class="cd-spec">{{item.specText}}</text>
            <text class="cd-price">¥{{item.subtotalText}}</text>
          </view>
          <view class="cd-stepper">
            <view class="cd-step-minus" data-id="{{item.id}}" data-quantity="{{item.quantity}}" bindtap="drawerMinus">−</view>
            <text class="cd-qty">{{item.quantity}}</text>
            <view class="cd-step-plus" data-id="{{item.id}}" data-quantity="{{item.quantity}}" bindtap="drawerPlus">+</view>
          </view>
        </view>
      </block>
      <view class="cd-empty" wx:else>购物车空空,点商品旁的 + 加进来吧</view>
    </scroll-view>
  </view>

  <view class="cart-bar">
    <view class="cart-bar-left">
      <view class="cart-bag-circle" bindtap="openDrawer">
        <image class="cart-bag-icon" src="/images/icons/cart-bag.svg" mode="aspectFit"/>
        <text class="cart-bag-badge" wx:if="{{cartQty > 0}}">{{cartQty}}</text>
      </view>
      <text class="cart-bar-text" wx:if="{{cartQty === 0}}">未选购商品</text>
      <text class="cart-bar-total" wx:if="{{cartQty > 0}}">¥{{cartTotal}}</text>
    </view>
    <view class="cart-bar-btn {{cartQty > 0 ? '' : 'is-disabled'}}" bindtap="goCart">去结算</view>
  </view>

  <view class="bottom-nav">
    <navigator class="nav-item" url="/pages/home/index" open-type="reLaunch"><view class="nav-icon"><image class="nav-logo-icon" src="/images/nav/nav-home.svg" mode="aspectFit"/></view><text>首页</text></navigator>
    <navigator class="nav-item is-active" url="/pages/menu/index" open-type="reLaunch"><view class="nav-icon"><image class="nav-logo-icon" src="/images/nav/nav-menu.svg" mode="aspectFit"/></view><text>点餐</text></navigator>
    <navigator class="nav-item" url="/pages/saving-card/index" open-type="reLaunch"><view class="nav-icon"><image class="nav-logo-icon" src="/images/nav/nav-saving.svg" mode="aspectFit"/></view><text>省钱卡</text></navigator>
    <navigator class="nav-item" url="/pages/order/index" open-type="reLaunch"><view class="nav-icon"><image class="nav-logo-icon" src="/images/nav/nav-order.svg" mode="aspectFit"/></view><text>订单</text></navigator>
    <navigator class="nav-item" url="/pages/mine/index" open-type="reLaunch"><view class="nav-icon"><image class="nav-logo-icon" src="/images/nav/nav-mine.svg" mode="aspectFit"/></view><text>我的</text></navigator>
  </view>
</view>
