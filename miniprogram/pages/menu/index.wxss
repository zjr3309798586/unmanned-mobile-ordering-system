page { background: #f8fafc; color: #1f2937; }

.menu-shell {
  background: #f8fafc;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* Header */
.menu-header {
  position: relative;
  z-index: 20;
  flex-shrink: 0;
  background: #fff;
  padding: 24rpx 32rpx 20rpx;
  box-shadow: 0 2rpx 4rpx rgba(0,0,0,0.04);
}

.mh-top-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 28rpx; }
.mh-tabs { display: flex; align-items: center; gap: 20rpx; font-size: 36rpx; }
.mh-tab { position: relative; color: #9ca3af; font-weight: 500; padding-bottom: 4rpx; }
.mh-tab.is-active { color: #111827; font-weight: 700; }
.mh-tab-bar { position: absolute; left: 50%; bottom: -8rpx; width: 32rpx; height: 4rpx; border-radius: 999rpx; background: #111827; transform: translateX(-50%); }
.mh-tab-sep { color: #e5e7eb; font-weight: 300; }

.mh-actions { display: flex; align-items: center; gap: 16rpx; }
.mh-icon-btn { display: inline-flex; align-items: center; justify-content: center; width: 88rpx; height: 88rpx; border-radius: 50%; border: 1rpx solid #e5e7eb; background: #fff; box-shadow: 0 2rpx 4rpx rgba(0,0,0,0.04); }
.mh-icon-btn image { width: 36rpx; height: 36rpx; }
.mh-pill-group { display: inline-flex; align-items: center; min-height: 88rpx; padding: 0 12rpx; border-radius: 999rpx; border: 1rpx solid #e5e7eb; background: #fff; box-shadow: 0 2rpx 4rpx rgba(0,0,0,0.04); }
.mh-pill-btn { display: inline-flex; align-items: center; justify-content: center; min-width: 88rpx; min-height: 88rpx; padding: 0 8rpx; }
.mh-pill-btn image { width: 36rpx; height: 36rpx; }
.mh-pill-sep { width: 2rpx; height: 24rpx; background: #e5e7eb; margin: 0 4rpx; }

.mh-store { display: flex; align-items: center; font-size: 34rpx; font-weight: 700; color: #111827; margin-bottom: 12rpx; }
.mh-store-star { width: 36rpx; height: 36rpx; margin-right: 8rpx; flex: 0 0 auto; }
.mh-store-arrow { width: 28rpx; height: 28rpx; margin-left: 4rpx; }
.mh-store-name { flex: 0 1 auto; }

.mh-meta { display: flex; align-items: center; font-size: 22rpx; color: #6b7280; margin-bottom: 24rpx; }
.mh-meta-sep { color: #d1d5db; margin: 0 16rpx; }
.mh-meta-tag { display: inline-flex; align-items: center; padding: 4rpx 12rpx; border: 1rpx solid #1a73e8; border-radius: 999rpx; color: #1a73e8; font-size: 20rpx; font-weight: 500; }

.mh-promo-row { display: flex; align-items: center; justify-content: space-between; margin-top: 8rpx; }
.mh-promo-text { display: inline-flex; align-items: center; gap: 8rpx; color: #1a73e8; font-size: 28rpx; font-weight: 500; }
.mh-promo-icon { width: 32rpx; height: 32rpx; }
.mh-promo-arrow { width: 24rpx; height: 24rpx; }
.mh-promo-btn { display: inline-flex; align-items: center; justify-content: center; min-height: 88rpx; padding: 0 32rpx; border: 1rpx solid #e5e7eb; border-radius: 999rpx; background: #fff; color: #374151; font-size: 24rpx; font-weight: 500; box-shadow: 0 2rpx 4rpx rgba(0,0,0,0.04); }

/* Main */
.menu-body { flex: 1 1 auto; display: flex; overflow: hidden; }

.menu-side {
  width: 176rpx;
  flex-shrink: 0;
  overflow-y: auto;
  background: #f8fafc;
  padding-bottom: 280rpx;
}
.ms-list { display: flex; flex-direction: column; }
.ms-item { position: relative; padding: 32rpx 16rpx; display: flex; flex-direction: column; align-items: center; text-align: center; color: #6b7280; font-size: 26rpx; }
.ms-item.is-active { background: #fff; color: #111827; }
.ms-active-bar { position: absolute; left: 0; top: 50%; width: 8rpx; height: 40rpx; border-radius: 0 16rpx 16rpx 0; background: #1a73e8; transform: translateY(-50%); display: none; }
.ms-item.is-active .ms-active-bar { display: block; }
.ms-item.is-active .ms-label { font-weight: 700; }
.ms-icon { display: flex; align-items: center; justify-content: center; width: 56rpx; height: 56rpx; margin-bottom: 8rpx; border-radius: 50%; }
.ms-icon image { width: 100%; height: 100%; }
.ms-icon-img { overflow: hidden; }
.ms-pill-tag { display: inline-flex; align-items: center; padding: 2rpx 12rpx; border-radius: 999rpx; background: #1a73e8; color: #fff; font-size: 18rpx; font-weight: 600; margin-bottom: 8rpx; transform: scale(0.92); white-space: nowrap; }
.ms-label { display: block; line-height: 1.3; font-weight: 500; }

.menu-list {
  flex: 1 1 auto;
  overflow-y: auto;
  background: #fff;
  padding: 0 32rpx 300rpx 24rpx;
}
.ml-cat-head { position: sticky; top: 0; z-index: 10; padding: 24rpx 0; background: rgba(255,255,255,0.95); font-size: 28rpx; font-weight: 500; color: #111827; letter-spacing: 1rpx; }
.ml-items { display: flex; flex-direction: column; gap: 64rpx; margin-top: 16rpx; }

.m-card { display: flex; gap: 24rpx; width: 100%; }
.m-cover { position: relative; flex-shrink: 0; width: 200rpx; height: 200rpx; border-radius: 16rpx; background: #f9fafb; overflow: hidden; box-shadow: 0 2rpx 4rpx rgba(0,0,0,0.06); }
.m-cover image { width: 100%; height: 100%; }
.m-cover-new { position: absolute; top: 0; right: 0; z-index: 2; display: inline-flex; align-items: center; justify-content: center; width: 40rpx; height: 40rpx; background: #6eb92b; color: #fff; font-size: 20rpx; font-weight: 500; border-radius: 0 0 0 16rpx; }

.m-body { flex: 1 1 auto; min-width: 0; display: flex; flex-direction: column; }
.m-name { font-size: 32rpx; font-weight: 700; color: #111827; line-height: 1.2; }
.m-tag-row { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 12rpx; }
.m-tag-promo { display: inline-flex; align-items: center; padding: 4rpx 12rpx; border-radius: 8rpx; background: #fef2f2; color: #e53935; font-size: 20rpx; font-weight: 500; }
.m-attr-row { display: flex; flex-wrap: wrap; gap: 8rpx; margin-top: 12rpx; }
.m-tag-attr { display: inline-flex; align-items: center; padding: 2rpx 12rpx; border: 1rpx solid #e5e7eb; border-radius: 4rpx; color: #9ca3af; font-size: 20rpx; }

.m-price-row { margin-top: auto; padding-top: 16rpx; display: flex; align-items: flex-end; justify-content: space-between; }
.m-price { display: flex; align-items: baseline; color: #e53935; flex-wrap: wrap; }
.m-yuan { font-size: 24rpx; font-weight: 700; }
.m-int { font-size: 36rpx; font-weight: 700; letter-spacing: -1rpx; line-height: 1; margin: 0 2rpx; }
.m-dec { font-size: 24rpx; font-weight: 700; line-height: 1; }
.m-price-hint { display: inline-flex; align-items: center; margin-left: 8rpx; color: #9ca3af; font-size: 20rpx; font-weight: 400; }
.m-help-tip { display: inline-flex; align-items: center; justify-content: center; width: 24rpx; height: 24rpx; margin-left: 4rpx; border: 1rpx solid #d1d5db; border-radius: 50%; color: #d1d5db; font-size: 16rpx; line-height: 1; }
.m-add { display: inline-flex; align-items: center; justify-content: center; width: 88rpx; height: 88rpx; flex-shrink: 0; border-radius: 50%; background: #333; box-shadow: 0 2rpx 4rpx rgba(0,0,0,0.08); }
.m-add image { width: 32rpx; height: 32rpx; }
.m-add-icon { color: #fff; font-size: 36rpx; font-weight: 300; line-height: 1; }

.m-stepper { display: inline-flex; align-items: center; gap: 8rpx; }
.m-minus { display: none; align-items: center; justify-content: center; width: 88rpx; height: 88rpx; border-radius: 50%; border: 2rpx solid #d1d5db; background: #fff; color: #333; font-size: 38rpx; line-height: 1; }
.m-minus.is-show { display: inline-flex; }
.m-qty { min-width: 32rpx; text-align: center; font-size: 28rpx; font-weight: 600; color: #111827; }

.ml-empty { padding: 60rpx 0; text-align: center; color: #9ca3af; font-size: 26rpx; }
.m-origin { margin-top: 8rpx; color: #9ca3af; font-size: 20rpx; text-decoration: line-through; }

/* 左下优惠券 */
.coupon-float {
  position: fixed;
  left: 32rpx;
  bottom: 296rpx;
  z-index: 30;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.95);
  box-shadow: 0 8rpx 30rpx rgba(0,0,0,0.08);
  border: 1rpx solid #f3f4f6;
}
.cf-num { font-size: 32rpx; font-weight: 700; color: #111827; line-height: 1; }
.cf-label { margin-top: 4rpx; font-size: 18rpx; color: #6b7280; }

.coupon-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 90;
  background: rgba(11, 27, 55, 0.36);
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.2s ease;
}

.coupon-mask.is-open {
  opacity: 1;
  pointer-events: auto;
}

.coupon-drawer {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(288rpx + env(safe-area-inset-bottom));
  z-index: 91;
  max-height: 560rpx;
  padding: 30rpx;
  border-radius: 40rpx;
  background: rgba(255,255,255,0.98);
  box-shadow: 0 -24rpx 80rpx rgba(31,111,255,0.18);
  transform: translateY(130%);
  transition: transform 0.22s ease;
}

.coupon-drawer.is-open {
  transform: translateY(0);
}

.coupon-drawer-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 22rpx;
}

.coupon-title {
  display: block;
  color: #102033;
  font-size: 34rpx;
  font-weight: 900;
}

.coupon-sub {
  display: block;
  margin-top: 8rpx;
  color: #7a8aa0;
  font-size: 24rpx;
}

.coupon-close {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 0 16rpx;
  color: #1f6fff;
  font-size: 26rpx;
  font-weight: 900;
}

.coupon-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.coupon-item {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 22rpx;
  border: 2rpx solid rgba(31,111,255,0.12);
  border-radius: 28rpx;
  background: linear-gradient(135deg, #f4f9ff 0%, #ffffff 100%);
}

.coupon-money {
  min-width: 112rpx;
  color: #f04b1f;
  font-size: 42rpx;
  font-weight: 900;
}

.coupon-copy {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 8rpx;
}

.coupon-copy text:first-child {
  color: #102033;
  font-size: 28rpx;
  font-weight: 900;
}

.coupon-copy text:last-child {
  color: #7a8aa0;
  font-size: 24rpx;
}

.coupon-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 18rpx;
  padding: 46rpx 0;
  color: #7a8aa0;
  font-size: 26rpx;
}

.coupon-empty view {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 16rpx 34rpx;
  border-radius: 999rpx;
  color: #ffffff;
  background: #1f6fff;
  font-weight: 900;
}

.cd-go-cart {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  margin-top: 18rpx;
  border-radius: 999rpx;
  color: #ffffff;
  background: #1f6fff;
  font-size: 26rpx;
  font-weight: 900;
}

/* 底部购物车(在 nav 上方) */
.cart-bar {
  position: fixed;
  left: 0; right: 0;
  bottom: calc(156rpx + env(safe-area-inset-bottom));
  z-index: 40;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 112rpx;
  padding: 0 32rpx;
  background: rgba(255,255,255,0.95);
  border-top: 1rpx solid #f3f4f6;
  box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.04);
}
.cart-bar-left { display: flex; align-items: center; }
.cart-bag-circle { position: relative; display: inline-flex; align-items: center; justify-content: center; width: 88rpx; height: 88rpx; border-radius: 50%; background: #f3f4f6; border: 4rpx solid #fff; box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.06); }
.cart-bag-circle image { width: 40rpx; height: 40rpx; }
.cart-bag-badge { position: absolute; top: -6rpx; right: -6rpx; min-width: 32rpx; height: 32rpx; padding: 0 8rpx; border-radius: 999rpx; background: #e53935; color: #fff; font-size: 20rpx; font-weight: 700; line-height: 32rpx; text-align: center; }
.cart-bar-text { margin-left: 20rpx; color: #9ca3af; font-size: 26rpx; font-weight: 500; }
.cart-bar-total { margin-left: 20rpx; color: #e53935; font-size: 32rpx; font-weight: 700; line-height: 1; }
.cart-bar-btn { display: inline-flex; align-items: center; justify-content: center; min-height: 88rpx; padding: 0 40rpx; border-radius: 12rpx; background: #1a73e8; color: #fff; font-size: 28rpx; font-weight: 500; box-shadow: 0 4rpx 16rpx rgba(26,115,232,0.18); }
.cart-bar-btn.is-disabled { opacity: 0.5; }

/* 底部导航 */

/* 搜索 overlay */
.search-overlay { position: fixed; left: 0; right: 0; top: 0; bottom: 0; z-index: 60; background: #fff; display: none; flex-direction: column; }
.search-overlay.is-open { display: flex; }
.so-bar { display: flex; align-items: center; gap: 24rpx; padding: 24rpx 32rpx; border-bottom: 1rpx solid #f3f4f6; }
.so-input-wrap { flex: 1 1 auto; display: flex; align-items: center; gap: 16rpx; padding: 16rpx 28rpx; border-radius: 999rpx; background: #f3f4f6; }
.so-input-icon { width: 30rpx; height: 30rpx; opacity: 0.62; flex: 0 0 auto; }
.so-input { flex: 1 1 auto; font-size: 28rpx; color: #111827; background: transparent; }
.so-cancel { display: inline-flex; align-items: center; justify-content: center; min-height: 88rpx; color: #1a73e8; font-size: 28rpx; font-weight: 500; padding: 0 16rpx; }
.so-results { flex: 1 1 auto; padding: 32rpx; }
.so-empty { padding: 160rpx 0; text-align: center; color: #9ca3af; font-size: 26rpx; }
.so-item { display: flex; align-items: center; gap: 24rpx; padding: 24rpx 0; border-bottom: 1rpx solid #f3f4f6; }
.so-thumb { width: 112rpx; height: 112rpx; border-radius: 20rpx; background: #f3f4f6; flex: 0 0 auto; }
.so-body { flex: 1 1 auto; min-width: 0; }
.so-name { font-size: 28rpx; font-weight: 600; color: #111827; display: block; }
.so-desc { margin-top: 4rpx; color: #9ca3af; font-size: 24rpx; display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.so-price { color: #e53935; font-size: 28rpx; font-weight: 700; flex: 0 0 auto; }

/* 购物车抽屉 */
.cart-mask { position: fixed; left: 0; right: 0; top: 0; bottom: 0; z-index: 35; background: rgba(0,0,0,0.4); opacity: 0; pointer-events: none; transition: opacity 0.2s ease; }
.cart-mask.is-open { opacity: 1; pointer-events: auto; }

.cart-drawer {
  position: fixed;
  left: 0; right: 0;
  bottom: calc(284rpx + env(safe-area-inset-bottom));
  z-index: 38;
  max-height: 60vh;
  display: flex;
  flex-direction: column;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  box-shadow: 0 -16rpx 56rpx rgba(0,0,0,0.08);
  transform: translateY(120%);
  transition: transform 0.28s cubic-bezier(0.2, 0.7, 0.2, 1);
  overflow: hidden;
}
.cart-drawer.is-open { transform: translateY(0); }

.cd-head { display: flex; align-items: center; justify-content: space-between; padding: 28rpx 32rpx; border-bottom: 1rpx solid #f3f4f6; }
.cd-title { font-size: 30rpx; font-weight: 700; color: #111827; }
.cd-clear { display: inline-flex; align-items: center; justify-content: center; min-height: 88rpx; gap: 8rpx; color: #6b7280; font-size: 24rpx; }
.cd-clear-icon { width: 26rpx; height: 26rpx; opacity: 0.72; flex: 0 0 auto; }

.cd-list { flex: 1 1 auto; max-height: 50vh; padding: 0 32rpx 24rpx; }
.cd-empty { padding: 56rpx 0; text-align: center; color: #9ca3af; font-size: 26rpx; }

.cd-item { display: flex; align-items: center; gap: 24rpx; padding: 24rpx 0; border-bottom: 1rpx solid #f3f4f6; }
.cd-thumb { width: 104rpx; height: 104rpx; border-radius: 20rpx; background: #f3f4f6; flex: 0 0 auto; }
.cd-body { flex: 1 1 auto; min-width: 0; display: flex; flex-direction: column; gap: 4rpx; }
.cd-name { font-size: 28rpx; font-weight: 600; color: #111827; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.cd-spec { color: #9ca3af; font-size: 22rpx; }
.cd-price { color: #e53935; font-size: 28rpx; font-weight: 700; margin-top: 4rpx; }

.cd-stepper { display: inline-flex; align-items: center; gap: 10rpx; flex: 0 0 auto; }
.cd-step-minus { display: inline-flex; align-items: center; justify-content: center; width: 88rpx; height: 88rpx; border-radius: 50%; border: 2rpx solid #d1d5db; background: #fff; color: #333; font-size: 34rpx; line-height: 1; }
.cd-step-plus { display: inline-flex; align-items: center; justify-content: center; width: 88rpx; height: 88rpx; border-radius: 50%; background: #1a73e8; color: #fff; font-size: 34rpx; line-height: 1; }
.cd-qty { min-width: 36rpx; text-align: center; font-size: 28rpx; font-weight: 600; color: #111827; }

