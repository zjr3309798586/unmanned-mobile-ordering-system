.menu-header {
  position: relative;
  z-index: 8;
  padding: 24rpx 24rpx 20rpx;
  border-bottom: 1rpx solid #edf1f7;
  background: rgba(255, 255, 255, 0.96);
}

.menu-title-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 20rpx;
}

.menu-title-row text:first-child {
  font-size: 44rpx;
  font-weight: 900;
}

.menu-title-row text:last-child {
  color: #6d7788;
  font-size: 22rpx;
}

.menu-store-panel {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 20rpx 22rpx;
  border-radius: 28rpx;
  background: #f6f8fc;
}

.menu-store-panel .store-label {
  min-height: auto;
  padding: 0;
  color: #6d7788;
  font-size: 22rpx;
  background: transparent;
}

.menu-store-panel .store-name {
  margin-top: 8rpx;
  font-size: 36rpx;
  font-weight: 900;
}

.menu-store-status {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
  color: #6d7788;
  font-size: 22rpx;
  white-space: nowrap;
}

.menu-order-mode {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 24rpx;
  padding: 8rpx;
  border-radius: 999rpx;
  background: #f1f4f8;
}

.mode-pill {
  min-height: 68rpx;
  border-radius: 999rpx;
  color: #6d7788;
  font-size: 26rpx;
  font-weight: 900;
}

.mode-pill.is-active {
  color: #ffffff;
  background: #1f5eff;
  box-shadow: 0 16rpx 32rpx rgba(31, 94, 255, 0.18);
}

.menu-header .search-bar {
  margin-top: 18rpx;
  border: 0;
  border-radius: 999rpx;
  background: #f6f8fc;
  box-shadow: none;
}

.menu-main {
  padding: 0 0 260rpx;
}

.menu-campaign-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin: 0 24rpx 20rpx;
  padding: 24rpx;
  border-radius: 28rpx;
  color: #1453d9;
  background: #eaf1ff;
}

.campaign-title {
  margin-top: 6rpx;
  color: #1453d9;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.2;
}

.campaign-note {
  max-width: 58%;
  color: #5570a7;
  font-size: 24rpx;
  line-height: 1.45;
  text-align: right;
}

.campaign-tag {
  display: inline-flex;
  min-height: 42rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 42rpx;
  background: #1453d9;
}

.menu-layout {
  display: grid;
  grid-template-columns: 180rpx minmax(0, 1fr);
  align-items: start;
  min-height: calc(100vh - 440rpx);
  border-top: 1rpx solid #e5eaf1;
  background: #ffffff;
}

.category-panel {
  min-height: calc(100vh - 440rpx);
  padding: 0;
  background: #f1f4f8;
}

.category-list {
  display: flex;
  flex-direction: column;
}

.category-button {
  position: relative;
  min-height: 104rpx;
  padding: 0 18rpx;
  color: #6d7788;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1.25;
  text-align: center;
}

.category-button.is-active {
  color: #1f5eff;
  background: #ffffff;
}

.category-button.is-active::before {
  content: "";
  position: absolute;
  top: 32rpx;
  left: 0;
  width: 8rpx;
  height: 40rpx;
  border-radius: 999rpx;
  background: #1f5eff;
}

.menu-content {
  min-width: 0;
  padding: 26rpx 20rpx 24rpx 22rpx;
  background: #ffffff;
}

.menu-group {
  margin: 0 0 28rpx;
}

.menu-group .section-head {
  margin-bottom: 18rpx;
}

.menu-item-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.menu-item-card {
  display: grid;
  grid-template-columns: 188rpx minmax(0, 1fr);
  gap: 22rpx;
  padding: 18rpx;
  border: 1rpx solid #edf1f7;
  border-radius: 30rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(20, 48, 96, 0.04);
}

.menu-cover-link {
  display: block;
  width: 188rpx;
  height: 204rpx;
  overflow: hidden;
  border-radius: 26rpx;
  background: #eef4ff;
}

.menu-item-card .cover-thumb {
  width: 100%;
  height: 100%;
  border-radius: 20rpx;
}

.menu-item-card .product-name {
  margin-top: 8rpx;
  font-size: 30rpx;
  font-weight: 900;
}

.menu-item-card .tag-row {
  gap: 8rpx;
}

.menu-item-card .tag {
  min-height: 36rpx;
  padding: 0 10rpx;
  font-size: 20rpx;
  font-weight: 800;
}

.menu-item-card .product-desc {
  display: -webkit-box;
  overflow: hidden;
  min-height: 64rpx;
  margin-top: 8rpx;
  color: #6d7788;
  font-size: 23rpx;
  line-height: 1.45;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.sales-line {
  display: block;
  margin-top: 10rpx;
  color: #98a2b3;
  font-size: 22rpx;
}

.menu-item-card .price-line {
  margin-top: 14rpx;
}

.menu-item-card .price {
  color: #ef5f20;
  font-size: 38rpx;
}

.menu-item-action {
  display: inline-flex;
  align-items: center;
  gap: 14rpx;
}

.item-counter {
  min-width: 44rpx;
  height: 44rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  color: #1f5eff;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 44rpx;
  text-align: center;
  background: #eaf1ff;
}

.add-button {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  color: #ffffff;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 56rpx;
  background: #1f5eff;
  box-shadow: 0 16rpx 32rpx rgba(31, 94, 255, 0.22);
}

.settlement-bar {
  display: block;
  padding: 16rpx 20rpx;
  border-radius: 999rpx;
  background: #111827;
}

.settlement-main {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.cart-bag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 900;
  background: #1f5eff;
}

.settlement-bar .floating-summary {
  flex: 1;
}

.settlement-bar .button-primary {
  min-height: 72rpx;
  border-radius: 999rpx;
}

.cart-preview {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  width: 100%;
  padding: 4rpx 16rpx 16rpx 104rpx;
  margin-bottom: 16rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.12);
}

.cart-preview-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 6rpx 16rpx;
  color: #ffffff;
  font-size: 24rpx;
}

.cart-preview-row text,
.cart-preview-row .preview-spec {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cart-preview-row .preview-spec {
  grid-column: 1 / 2;
  color: rgba(255, 255, 255, 0.6);
}

.cart-preview-row .preview-price {
  grid-row: 1 / span 2;
  grid-column: 2 / 3;
  align-self: center;
  font-weight: 800;
}

.settlement-bar.is-hidden {
  opacity: 0;
  pointer-events: none;
  transform: translateY(28rpx);
}

.settlement-bar.is-visible {
  opacity: 1;
  pointer-events: auto;
  transform: translateY(0);
}
