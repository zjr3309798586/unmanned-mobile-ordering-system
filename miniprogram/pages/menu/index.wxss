.menu-shell {
  height: 100vh;
  max-height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #f8fafc;
}

.menu-header {
  position: relative;
  z-index: 30;
  flex-shrink: 0;
  padding: 24rpx 32rpx 20rpx;
  box-sizing: border-box;
  background: #ffffff;
  box-shadow: 0 2rpx 8rpx rgba(16, 32, 51, 0.04);
}

.mh-top-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 26rpx;
}

.mh-tabs {
  display: flex;
  align-items: center;
  gap: 18rpx;
  font-size: 36rpx;
}

.mh-tab {
  position: relative;
  min-height: 72rpx;
  display: flex;
  align-items: center;
  padding: 0 8rpx;
  color: #9aa5b5;
  font-weight: 600;
  line-height: 1.25;
}

.mh-tab.is-active {
  color: #111827;
  font-weight: 800;
}

.mh-tab-bar {
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 34rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: #111827;
  transform: translateX(-50%);
  display: none;
}

.mh-tab.is-active .mh-tab-bar {
  display: block;
}

.mh-tab-sep {
  color: #e5eaf1;
  font-weight: 300;
}

.mh-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.mh-icon-btn {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #e5eaf1;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: 0 4rpx 14rpx rgba(16, 32, 51, 0.06);
}

.mh-action-icon {
  width: 36rpx;
  height: 36rpx;
}

.mh-pill-group {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  padding: 0 12rpx;
  border: 1rpx solid #e5eaf1;
  border-radius: 999rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 14rpx rgba(16, 32, 51, 0.06);
}

.mh-pill-btn {
  min-width: 82rpx;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.mh-pill-icon {
  width: 36rpx;
  height: 36rpx;
}

.mh-pill-sep {
  width: 2rpx;
  height: 28rpx;
  margin: 0 4rpx;
  background: #e5eaf1;
}

.mh-store {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
  color: #111827;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.28;
}

.mh-store-star {
  width: 36rpx;
  height: 36rpx;
  margin-right: 8rpx;
  flex: 0 0 auto;
}

.mh-store-name {
  min-width: 0;
}

.mh-store-arrow {
  width: 28rpx;
  height: 28rpx;
  margin-left: 4rpx;
  flex: 0 0 auto;
}

.mh-meta {
  display: flex;
  align-items: center;
  margin-bottom: 22rpx;
  color: #718096;
  font-size: 23rpx;
  line-height: 1.35;
}

.mh-meta-sep {
  margin: 0 16rpx;
  color: #d8dee8;
}

.mh-meta-tag {
  display: flex;
  align-items: center;
  min-height: 34rpx;
  padding: 0 14rpx;
  border: 1rpx solid #1f6fff;
  border-radius: 999rpx;
  color: #1f6fff;
  font-size: 21rpx;
  font-weight: 700;
}

.mh-promo-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.mh-promo-text {
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: #1f6fff;
  font-size: 28rpx;
  font-weight: 700;
}

.mh-promo-label {
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.mh-promo-icon {
  width: 32rpx;
  height: 32rpx;
  flex: 0 0 auto;
}

.mh-promo-arrow {
  width: 24rpx;
  height: 24rpx;
  flex: 0 0 auto;
}

.mh-promo-btn {
  min-width: 96rpx;
  min-height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 26rpx;
  border: 1rpx solid #e5eaf1;
  border-radius: 999rpx;
  background: #ffffff;
  color: #4b5563;
  font-size: 25rpx;
  font-weight: 700;
  box-shadow: 0 4rpx 14rpx rgba(16, 32, 51, 0.06);
  flex: 0 0 auto;
}

.menu-body {
  flex: 1 1 auto;
  min-height: 0;
  display: flex;
  overflow: hidden;
}

.menu-side {
  width: 176rpx;
  height: 100%;
  min-height: 0;
  flex: 0 0 176rpx;
  box-sizing: border-box;
  background: #f4f7fb;
  padding-bottom: 300rpx;
}

.ms-list {
  display: flex;
  flex-direction: column;
}

.ms-item {
  position: relative;
  min-height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 18rpx 12rpx;
  box-sizing: border-box;
  color: #718096;
  font-size: 27rpx;
  font-weight: 600;
  text-align: center;
}

.ms-item.is-active {
  background: #ffffff;
  color: #111827;
}

.ms-item.is-active .ms-label {
  font-weight: 800;
}

.ms-active-bar {
  position: absolute;
  left: 0;
  top: 50%;
  width: 8rpx;
  height: 42rpx;
  border-radius: 0 999rpx 999rpx 0;
  background: #1f6fff;
  transform: translateY(-50%);
}

.ms-label {
  display: block;
  line-height: 1.3;
}

.menu-list {
  flex: 1 1 auto;
  height: 100%;
  min-width: 0;
  min-height: 0;
  box-sizing: border-box;
  background: #ffffff;
  padding: 0 32rpx 300rpx 24rpx;
}

.ml-cat-head {
  position: sticky;
  top: 0;
  z-index: 10;
  padding: 24rpx 0 20rpx;
  background: rgba(255, 255, 255, 0.96);
  color: #111827;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.3;
}

.ml-items {
  display: flex;
  flex-direction: column;
  gap: 64rpx;
  padding-top: 16rpx;
}

.m-card {
  min-height: 200rpx;
  display: flex;
  gap: 24rpx;
  width: 100%;
}

.m-cover {
  width: 200rpx;
  height: 200rpx;
  flex: 0 0 200rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #f9fafb;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.06);
}

.m-cover-img {
  width: 100%;
  height: 100%;
}

.m-body {
  min-width: 0;
  flex: 1 1 auto;
  display: flex;
  flex-direction: column;
}

.m-name {
  color: #111827;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.2;
}

.m-attr-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 12rpx;
}

.m-tag-attr {
  max-width: 100%;
  display: -webkit-box;
  padding: 2rpx 12rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 4rpx;
  color: #9ca3af;
  font-size: 20rpx;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.m-price-row {
  margin-top: auto;
  padding-top: 16rpx;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}

.m-price {
  display: flex;
  align-items: baseline;
  color: #e53935;
  flex-wrap: wrap;
  white-space: nowrap;
}

.m-yuan {
  font-size: 24rpx;
  font-weight: 700;
}

.m-int {
  margin: 0 2rpx;
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
  line-height: 1;
}

.m-dec {
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1;
}

.m-stepper {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex: 0 0 auto;
}

.m-add,
.m-minus {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  box-sizing: border-box;
}

.m-add {
  width: 88rpx;
  height: 88rpx;
  background: #333333;
  color: #ffffff;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.08);
}

.m-add-icon {
  width: 32rpx;
  height: 32rpx;
}

.m-minus-icon {
  width: 24rpx;
  height: 24rpx;
}

.m-minus {
  width: 88rpx;
  height: 88rpx;
  display: none;
  border: 2rpx solid #d1d5db;
  background: #ffffff;
  color: #333333;
  font-size: 38rpx;
  line-height: 1;
}

.m-minus.is-show {
  display: flex;
}

.m-qty {
  min-width: 32rpx;
  color: #111827;
  font-size: 28rpx;
  font-weight: 800;
  text-align: center;
}

.ml-empty {
  padding: 80rpx 0;
  color: #9aa5b5;
  font-size: 26rpx;
  text-align: center;
}

.coupon-float {
  position: fixed;
  left: 32rpx;
  bottom: calc(300rpx + env(safe-area-inset-bottom));
  z-index: 60;
  width: 96rpx;
  height: 96rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #edf2f8;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 12rpx 36rpx rgba(16, 32, 51, 0.08);
}

.cf-num {
  color: #111827;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1;
}

.cf-label {
  margin-top: 4rpx;
  color: #718096;
  font-size: 18rpx;
  line-height: 1;
}

.cart-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(156rpx + env(safe-area-inset-bottom));
  z-index: 70;
  height: 112rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  padding: 0 32rpx;
  border-top: 1rpx solid #edf2f8;
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 -12rpx 32rpx rgba(31, 111, 255, 0.06);
}

.cart-bar-left {
  min-width: 0;
  display: flex;
  align-items: center;
}

.cart-bag-circle {
  position: relative;
  width: 88rpx;
  height: 88rpx;
  flex: 0 0 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #ffffff;
  border-radius: 50%;
  background: #f2f6fc;
  box-shadow: 0 8rpx 22rpx rgba(16, 32, 51, 0.08);
}

.cart-bag-icon {
  width: 44rpx;
  height: 44rpx;
}

.cart-bag-badge {
  position: absolute;
  top: -6rpx;
  right: -6rpx;
  min-width: 34rpx;
  height: 34rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: #f04b1f;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 34rpx;
  text-align: center;
  box-sizing: border-box;
}

.cart-bar-text {
  margin-left: 20rpx;
  color: #9aa5b5;
  font-size: 26rpx;
  font-weight: 700;
  white-space: nowrap;
}

.cart-bar-total {
  margin-left: 20rpx;
  color: #e53935;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1;
  white-space: nowrap;
}

.cart-bar-btn {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 56rpx;
  border-radius: 16rpx;
  background: #1a73e8;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 500;
  box-shadow: 0 8rpx 24rpx rgba(26, 115, 232, 0.18);
}

.cart-bar-btn.is-disabled {
  background: #cfd8e8;
  box-shadow: none;
  opacity: 0.78;
}

.cart-mask,
.coupon-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.18s ease;
}

.cart-mask {
  z-index: 55;
  background: rgba(0, 0, 0, 0.4);
}

.coupon-mask {
  z-index: 100;
  background: rgba(0, 0, 0, 0.4);
}

.cart-mask.is-open,
.coupon-mask.is-open {
  opacity: 1;
  pointer-events: auto;
}

.cart-drawer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(268rpx + env(safe-area-inset-bottom));
  z-index: 58;
  max-height: 60vh;
  display: flex;
  flex-direction: column;
  border-radius: 32rpx 32rpx 0 0;
  background: #ffffff;
  box-shadow: 0 -16rpx 56rpx rgba(0, 0, 0, 0.08);
  transform: translateY(calc(100% + 300rpx));
  transition: transform 0.2s cubic-bezier(0.2, 0.7, 0.2, 1);
  pointer-events: none;
  overflow: hidden;
  will-change: transform;
}

.cart-drawer.is-open {
  transform: translateY(0);
  pointer-events: auto;
}

.cd-head {
  flex: 0 0 auto;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
