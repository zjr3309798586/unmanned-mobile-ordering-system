.promo-tip-card {
  margin-top: 0;
  border-color: #cfdcff;
  background: #eaf1ff;
  box-shadow: none;
}

.promo-tip-card .section-title {
  color: #1f5eff;
}

.menu-layout {
  display: grid;
  grid-template-columns: 172rpx minmax(0, 1fr);
  gap: 16rpx;
  align-items: start;
  margin-top: 20rpx;
}

.category-panel {
  position: sticky;
  top: 236rpx;
  padding: 16rpx;
  border-radius: 20rpx;
  box-shadow: none;
}

.category-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.category-button {
  position: relative;
  padding: 20rpx 16rpx;
  border-radius: 16rpx;
  color: #6d7788;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.25;
  text-align: left;
}

.category-button.is-active {
  color: #1f5eff;
  background: #eaf1ff;
}

.category-button.is-active::before {
  content: "";
  position: absolute;
  top: 50%;
  left: 0;
  width: 6rpx;
  height: 36rpx;
  border-radius: 999rpx;
  background: #1f5eff;
  transform: translateY(-50%);
}

.menu-content {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.menu-group {
  margin-top: 0;
  padding: 20rpx;
  box-shadow: none;
}

.menu-item-card {
  grid-template-columns: 152rpx minmax(0, 1fr);
  padding: 16rpx;
  box-shadow: none;
}

.menu-item-card .cover-thumb {
  width: 152rpx;
  height: 152rpx;
}

.product-desc {
  display: -webkit-box;
  overflow: hidden;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.menu-item-action {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
}

.item-counter {
  min-width: 44rpx;
  height: 44rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  color: #6d7788;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 44rpx;
  text-align: center;
  background: #eef2f7;
}

.add-button {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  color: #ffffff;
  font-size: 40rpx;
  line-height: 60rpx;
  background: #1f5eff;
  box-shadow: 0 12rpx 28rpx rgba(31, 94, 255, 0.22);
}

.settlement-bar {
  display: block;
}

.settlement-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.cart-preview {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  width: 100%;
  padding-bottom: 16rpx;
  margin-bottom: 16rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.12);
}

.cart-preview-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 6rpx 16rpx;
  color: #ffffff;
  font-size: 24rpx;
}

.cart-preview-row text,
.cart-preview-row .preview-spec {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cart-preview-row .preview-spec {
  grid-column: 1 / 2;
  color: rgba(255, 255, 255, 0.62);
}

.cart-preview-row .preview-price {
  grid-row: 1 / span 2;
  grid-column: 2 / 3;
  align-self: center;
  font-weight: 800;
}

.settlement-bar.is-hidden {
  opacity: 0;
  pointer-events: none;
  transform: translateY(28rpx);
}

.settlement-bar.is-visible {
  opacity: 1;
  pointer-events: auto;
  transform: translateY(0);
}
