page { background: #F4F8FF; }

.order-shell {
  background: #F4F8FF;
  min-height: 100vh;
  padding-bottom: 200rpx;
  color: #191c23;
}

/* 顶部 tab */
.order-topbar {
  position: sticky; top: 0; z-index: 40;
  display: flex;
  justify-content: space-around;
  align-items: flex-end;
  height: 176rpx;
  padding: 80rpx 32rpx 0;
  background: rgba(255,255,255,0.9);
}
.order-tab { position: relative; display: flex; flex-direction: column; align-items: center; padding: 0 48rpx 24rpx; }
.order-tab text { font-size: 36rpx; font-weight: 600; color: #414754; }
.order-tab.is-active text { color: #191c23; font-weight: 700; }
.order-tab-bar { position: absolute; left: 50%; bottom: 0; width: 64rpx; height: 8rpx; border-radius: 999rpx; background: transparent; transform: translateX(-50%); }
.order-tab.is-active .order-tab-bar { background: #1a73e8; }

/* 主区 */
.order-main { padding: 32rpx; }
.order-list { display: flex; flex-direction: column; gap: 32rpx; }

.order-empty-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 360rpx;
  padding: 56rpx 32rpx;
  border: 1rpx solid #e6e8f2;
  border-radius: 32rpx;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(0,91,191,0.04);
  text-align: center;
}

.order-empty-title {
  color: #191c23;
  font-size: 34rpx;
  font-weight: 700;
}

.order-empty-desc {
  margin-top: 14rpx;
  color: #697386;
  font-size: 26rpx;
  line-height: 1.6;
}

.order-empty-btn {
  margin-top: 32rpx;
  min-width: 180rpx;
  min-height: 68rpx;
  padding: 0 32rpx;
  border-radius: 999rpx;
  line-height: 68rpx;
  color: #fff;
  background: #1f6fff;
  font-size: 26rpx;
  font-weight: 700;
}

/* 订单卡 */
.order-card {
  position: relative;
  padding: 32rpx;
  border-radius: 32rpx;
  background: #fff;
  border: 1rpx solid #e6e8f2;
  box-shadow: 0 8rpx 24rpx rgba(0,91,191,0.04);
}

.oc-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; }
.oc-store { display: flex; align-items: center; gap: 16rpx; min-width: 0; flex: 1 1 auto; }
.oc-store-name { font-size: 30rpx; font-weight: 600; color: #191c23; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 360rpx; }
.oc-icon-btn { display: inline-flex; align-items: center; justify-content: center; width: 48rpx; height: 48rpx; border-radius: 50%; border: 1rpx solid #c1c6d6; flex: 0 0 auto; }
.oc-icon-btn image { width: 28rpx; height: 28rpx; }
.oc-status { display: inline-flex; align-items: center; color: #575f6b; font-size: 26rpx; flex: 0 0 auto; }
.oc-status image { width: 28rpx; height: 28rpx; margin-left: 4rpx; }

.oc-meta { font-size: 22rpx; font-weight: 500; color: #575f6b; margin-bottom: 32rpx; }
.oc-meta-sep { margin: 0 8rpx; }

.oc-body { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 32rpx; }
.oc-thumbs { display: flex; gap: 16rpx; flex: 1 1 auto; min-width: 0; overflow: hidden; }
.oc-thumb { width: 112rpx; height: 112rpx; border-radius: 24rpx; background: #f2f3fd; overflow: hidden; flex: 0 0 auto; }
.oc-thumb image { width: 100%; height: 100%; }

.oc-price { text-align: right; margin-left: 32rpx; flex: 0 0 auto; }
.oc-pay { font-size: 34rpx; font-weight: 600; color: #191c23; line-height: 1.2; }
.oc-qty { display: block; font-size: 22rpx; font-weight: 500; color: #575f6b; margin-top: 8rpx; }

.oc-actions { display: flex; justify-content: flex-end; gap: 24rpx; margin-top: 16rpx; }
.oc-btn { display: inline-flex; align-items: center; justify-content: center; padding: 12rpx 32rpx; min-height: 60rpx; border-radius: 999rpx; font-size: 26rpx; font-weight: 400; }
.oc-btn-outline { border: 1rpx solid #c1c6d6; color: #191c23; background: transparent; }
.oc-btn-dark { background: #2d3038; color: #eff0fa; border: 1rpx solid #2d3038; }

/* 底部导航 */
.bottom-nav { position: fixed; left: 0; right: 0; bottom: 0; z-index: 50; display: grid; grid-template-columns: repeat(5, minmax(0,1fr)); min-height: 156rpx; padding: 16rpx 16rpx calc(16rpx + env(safe-area-inset-bottom)); background: rgba(255,255,255,0.96); border-top: 1rpx solid rgba(31,111,255,0.1); box-shadow: 0 -16rpx 40rpx rgba(31,111,255,0.08); }
.nav-item { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4rpx; color: #5c6a80; font-size: 24rpx; }
.nav-icon { display: flex; align-items: center; justify-content: center; width: 68rpx; height: 68rpx; }
.nav-logo-icon { width: 56rpx; height: 56rpx; filter: grayscale(1) brightness(0.55); opacity: 0.9; }
.nav-item.is-active { color: #1f6fff; }
.nav-item.is-active .nav-logo-icon { filter: none; opacity: 1; }
