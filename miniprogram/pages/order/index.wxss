.order-tabs {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.order-goods {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  padding-top: 4rpx;
  color: #6d7788;
  font-size: 24rpx;
  line-height: 1.58;
}

.order-card {
  padding: 24rpx;
  box-shadow: 0 8rpx 28rpx rgba(20, 48, 96, 0.04);
}

.order-card-head {
  margin-bottom: 20rpx;
}

.status-pill.waiting {
  color: #1f5eff;
  background: #eaf1ff;
}

.status-pill.done {
  color: #18a66a;
  background: #e9f8f1;
}

.status-pill.cancel {
  color: #6d7788;
  background: #eef2f7;
}

.order-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 20rpx;
}
