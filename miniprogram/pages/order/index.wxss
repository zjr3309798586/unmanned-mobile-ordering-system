.tab-card {
  display: flex;
  gap: 14rpx;
  margin-top: 22rpx;
  padding: 10rpx;
  border-radius: 999rpx;
  background: #ffffff;
}

.tab {
  flex: 1;
  min-height: 68rpx;
  border-radius: 999rpx;
  color: #737f91;
  font-size: 26rpx;
  font-weight: 800;
}

.tab.active {
  color: #ffffff;
  background: #ff7a1a;
}

.login-button,
.empty-action {
  width: 100%;
  margin-top: 24rpx;
}

.order-no {
  font-size: 27rpx;
  font-weight: 800;
}

.status {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
  font-weight: 900;
}

.status.waiting {
  color: #ff7a1a;
  background: #fff1e6;
}

.status.done {
  color: #1c8b54;
  background: #e9f8f0;
}

.status.cancel {
  color: #737f91;
  background: #eef2f7;
}

.order-items {
  margin-top: 20rpx;
  padding: 18rpx;
  border-radius: 20rpx;
  background: #f8fafc;
}

.order-item {
  display: flex;
  justify-content: space-between;
  gap: 18rpx;
  padding: 12rpx 0;
}

.item-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6rpx;
  color: #737f91;
  font-size: 24rpx;
}

.amount {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 18rpx;
  color: #737f91;
  font-size: 24rpx;
}

.payable {
  color: #182033;
  font-weight: 900;
}

.actions {
  display: flex;
  justify-content: flex-end;
  gap: 14rpx;
  margin-top: 22rpx;
}
