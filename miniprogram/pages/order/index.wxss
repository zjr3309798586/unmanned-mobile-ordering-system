page { background: #F4F8FF; }

.order-shell {
  background: #F4F8FF;
  min-height: 100vh;
  padding-bottom: 200rpx;
  color: #191c23;
}

/* 顶部标题与 tab：避开微信胶囊区域。 */
.order-titlebar {
  position: sticky;
  top: 0;
  z-index: 42;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  min-height: 112rpx;
  padding: 58rpx 200rpx 16rpx;
  box-sizing: border-box;
  background: rgba(255,255,255,0.96);
}

.order-title {
  color: #071a44;
  font-size: 38rpx;
  font-weight: 900;
  line-height: 1.2;
}

.order-topbar {
  position: sticky; top: 112rpx; z-index: 40;
  display: flex;
  justify-content: space-around;
  align-items: flex-end;
  height: 96rpx;
  padding: 0 32rpx;
  background: rgba(255,255,255,0.9);
}
.order-tab { position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 88rpx; padding: 0 48rpx 24rpx; }
.order-tab text { font-size: 36rpx; font-weight: 600; color: #414754; }
.order-tab.is-active text { color: #191c23; font-weight: 700; }
.order-tab-bar { position: absolute; left: 50%; bottom: 0; width: 64rpx; height: 8rpx; border-radius: 999rpx; background: transparent; transform: translateX(-50%); }
.order-tab.is-active .order-tab-bar { background: #1a73e8; }

/* 主区 */
.order-main { padding: 32rpx; }
.order-list { display: flex; flex-direction: column; gap: 32rpx; }

.order-empty {
  padding: 120rpx 32rpx;
  text-align: center;
  color: #414754;
  font-size: 28rpx;
}

.order-empty-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  margin-top: 24rpx;
  min-width: 180rpx;
  padding: 0 32rpx;
  border-radius: 999rpx;
  line-height: 88rpx;
  color: #fff;
  background: #1f6fff;
  font-size: 26rpx;
  font-weight: 700;
}

/* 订单卡 */
.order-card {
  position: relative;
  padding: 32rpx;
  border-radius: 32rpx;
  background: #fff;
  border: 1rpx solid #e6e8f2;
  box-shadow: 0 8rpx 24rpx rgba(0,91,191,0.04);
}

.oc-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; }
.oc-store { display: flex; align-items: center; gap: 16rpx; min-width: 0; flex: 1 1 auto; }
.oc-store-name { font-size: 30rpx; font-weight: 600; color: #191c23; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 360rpx; }
.oc-icon-btn { display: inline-flex; align-items: center; justify-content: center; width: 48rpx; height: 48rpx; border-radius: 50%; border: 1rpx solid #c1c6d6; flex: 0 0 auto; }
.oc-icon-btn image { width: 28rpx; height: 28rpx; }
.oc-status { display: inline-flex; align-items: center; color: #575f6b; font-size: 26rpx; flex: 0 0 auto; }
.oc-status image { width: 28rpx; height: 28rpx; margin-left: 4rpx; }

.oc-meta { font-size: 22rpx; font-weight: 500; color: #575f6b; margin-bottom: 32rpx; }
.oc-meta-sep { margin: 0 8rpx; }
.oc-delivery {
  margin: -12rpx 0 28rpx;
  padding: 18rpx 20rpx;
  border-radius: 24rpx;
  background: #f4f8ff;
  color: #5c6b8a;
  font-size: 22rpx;
  line-height: 1.45;
}

.oc-body { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 32rpx; }
.oc-thumbs { display: flex; gap: 16rpx; flex: 1 1 auto; min-width: 0; overflow: hidden; }
.oc-thumb { width: 112rpx; height: 112rpx; border-radius: 24rpx; background: #f2f3fd; overflow: hidden; flex: 0 0 auto; }
.oc-thumb image { width: 100%; height: 100%; }

.oc-price { text-align: right; margin-left: 32rpx; flex: 0 0 auto; }
.oc-pay { font-size: 34rpx; font-weight: 600; color: #191c23; line-height: 1.2; }
.oc-qty { display: block; font-size: 22rpx; font-weight: 500; color: #575f6b; margin-top: 8rpx; }

.oc-actions { display: flex; justify-content: flex-end; gap: 24rpx; margin-top: 16rpx; }
.oc-btn { display: inline-flex; align-items: center; justify-content: center; padding: 0 32rpx; min-height: 88rpx; border-radius: 999rpx; font-size: 26rpx; font-weight: 400; }
.oc-btn-outline { border: 1rpx solid #c1c6d6; color: #191c23; background: transparent; }
.oc-btn-dark { background: #2d3038; color: #eff0fa; border: 1rpx solid #2d3038; }

/* UI polish: order list density and readable card hierarchy. */
.order-shell {
  padding-bottom: 188rpx;
}

.order-topbar {
  height: 160rpx;
  padding: 72rpx 28rpx 0;
}

.order-tab {
  padding: 0 38rpx 22rpx;
}

.order-tab text {
  font-size: 34rpx;
  line-height: 1.2;
}

.order-main {
  padding: 28rpx;
}

.order-list {
  gap: 24rpx;
}

.order-card {
  border-color: rgba(31, 111, 255, 0.1);
  box-shadow: 0 20rpx 52rpx rgba(31, 111, 255, 0.08);
}

.order-card {
  padding: 28rpx;
}

.oc-head {
  margin-bottom: 14rpx;
}

.oc-store-name,
.oc-pay {
  line-height: 1.25;
}

.oc-meta {
  margin-bottom: 26rpx;
  line-height: 1.35;
}

.oc-body {
  margin-bottom: 26rpx;
}

.oc-actions {
  gap: 18rpx;
  margin-top: 12rpx;
}

.oc-btn {
  min-height: 84rpx;
  padding: 0 28rpx;
}

/* Alignment fix: keep order cards stable on small screens. */
.oc-head {
  align-items: flex-start;
  gap: 16rpx;
}

.oc-store {
  flex: 1 1 0;
  min-width: 0;
  gap: 12rpx;
}

.oc-store-name {
  max-width: none;
  flex: 1 1 auto;
}

.oc-status {
  justify-content: flex-end;
  max-width: 160rpx;
  line-height: 1.25;
  text-align: right;
}

.oc-body {
  align-items: center;
}

.oc-price {
  min-width: 128rpx;
  margin-left: 20rpx;
}

.oc-actions {
  align-items: center;
}

.oc-btn {
  box-sizing: border-box;
  min-width: 176rpx;
  text-align: center;
}

/* 底部导航 */

/* Final order page fix from screenshots: safe top, real item summary, no card drift. */
.order-shell {
  padding-bottom: calc(188rpx + env(safe-area-inset-bottom));
}

.order-titlebar {
  position: sticky;
  top: 0;
  z-index: 45;
  min-height: 176rpx;
  padding: 88rpx 200rpx 18rpx;
  background: rgba(255, 255, 255, 0.98);
}

.order-topbar {
  top: 176rpx;
  height: 92rpx;
  padding: 0 40rpx;
  border-bottom: 1rpx solid rgba(219, 231, 246, 0.7);
}

.order-tab {
  min-height: 88rpx;
  padding: 0 44rpx 18rpx;
}

.order-main {
  padding: 24rpx 28rpx 0;
}

.order-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  min-height: 520rpx;
  padding: 0;
}

.order-empty text {
  display: block;
  color: #5c6b8a;
  font-size: 28rpx;
  line-height: 1.4;
}

.order-empty-btn {
  margin-top: 8rpx;
}

.order-card {
  padding: 30rpx;
  border-radius: 30rpx;
  box-shadow: 0 16rpx 44rpx rgba(31, 111, 255, 0.08);
}

.oc-head {
  align-items: flex-start;
}

.oc-store {
  gap: 10rpx;
}

.oc-icon-btn {
  display: none;
}

.oc-store-name {
  color: #071a44;
  font-size: 30rpx;
  font-weight: 900;
}

.oc-status {
  max-width: 150rpx;
  color: #f04b1f;
  font-size: 25rpx;
  font-weight: 800;
}

.oc-status image {
  display: none;
}

.oc-meta {
  margin-bottom: 24rpx;
  color: #5c6b8a;
  font-size: 23rpx;
  line-height: 1.45;
  word-break: break-all;
}

.oc-body {
  display: grid;
  grid-template-columns: 112rpx minmax(0, 1fr) 118rpx;
  align-items: center;
  gap: 22rpx;
  margin-bottom: 28rpx;
}

.oc-cover {
  width: 112rpx;
  height: 112rpx;
  overflow: hidden;
  border-radius: 24rpx;
  background: #eef5ff;
}

.oc-cover image {
  width: 100%;
  height: 100%;
}

.oc-summary {
  min-width: 0;
}

.oc-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  color: #102033;
  font-size: 25rpx;
  line-height: 1.48;
}

.oc-product-name {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.oc-product-qty {
  flex: 0 0 auto;
  color: #5c6b8a;
}

.oc-more {
  margin-top: 8rpx;
  color: #7a8aa0;
  font-size: 22rpx;
}

.oc-no-items {
  color: #7a8aa0;
  font-size: 25rpx;
  line-height: 1.48;
}

.oc-price {
  min-width: 0;
  margin-left: 0;
  text-align: right;
}

.oc-pay {
  color: #f04b1f;
  font-size: 34rpx;
  font-weight: 900;
}

.oc-actions {
  gap: 18rpx;
}

.oc-btn {
  min-width: 168rpx;
  min-height: 72rpx;
  padding: 0 24rpx;
  font-size: 25rpx;
  line-height: 72rpx;
}

.oc-btn-dark {
  background: #1f6fff;
  border-color: #1f6fff;
}
