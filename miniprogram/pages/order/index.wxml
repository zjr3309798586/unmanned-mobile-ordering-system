<view class="page order-page">
  <view class="title">我的订单</view>
  <view class="muted mt">查看待取餐、历史订单，也可以再来一单。</view>

  <view class="login-card card" wx:if="{{needsLogin}}">
    <view class="section-title">请先登录</view>
    <view class="muted mt">登录后可以查看你的全部订单。</view>
    <button class="button primary login-button" bindtap="login">微信登录</button>
  </view>

  <view wx:if="{{loggedIn}}">
    <view class="tab-card">
      <button class="tab {{item.active ? 'active' : ''}}" wx:for="{{tabs}}" wx:key="id" data-id="{{item.id}}" bindtap="selectTab">{{item.name}}</button>
    </view>

    <view class="empty card" wx:if="{{empty}}">
      <view class="empty-title">暂无订单</view>
      <view class="muted mt">完成第一笔下单后会显示在这里。</view>
      <button class="button primary empty-action" bindtap="goMenu">去点餐</button>
    </view>

    <view class="order-card card" wx:for="{{visibleOrders}}" wx:key="id">
      <view class="row">
        <view>
          <view class="order-no">订单号 {{item.orderNo}}</view>
          <view class="muted mt">{{item.createdText}} · {{item.pickupTypeText}}</view>
        </view>
        <text class="status {{item.statusClass}}">{{item.statusText}}</text>
      </view>

      <view class="order-items">
        <view class="order-item" wx:for="{{item.items}}" wx:for-item="food" wx:key="productId">
          <view>
            <view class="product-name">{{food.productName}}</view>
            <view class="muted">{{food.spec}}</view>
          </view>
          <view class="item-right">
            <text>× {{food.quantity}}</text>
            <text>{{food.subtotalText}}</text>
          </view>
        </view>
      </view>

      <view class="amount">
        <text>合计 {{item.totalText}}</text>
        <text>优惠 -{{item.discountText}}</text>
        <text class="payable">实付 {{item.payableText}}</text>
      </view>

      <view class="actions">
        <button class="button secondary" wx:if="{{item.canCancel}}" data-id="{{item.id}}" bindtap="cancelOrder">取消订单</button>
        <button class="button primary" data-id="{{item.id}}" bindtap="repeatOrder">再来一单</button>
      </view>
    </view>
  </view>
</view>
