<view class="order-shell">

  <view class="order-topbar">
    <view class="order-tab {{tab === 'self' ? 'is-active' : ''}}" data-tab="self" bindtap="switchTab">
      <text>自取</text><view class="order-tab-bar"></view>
    </view>
    <view class="order-tab {{tab === 'delivery' ? 'is-active' : ''}}" data-tab="delivery" bindtap="switchTab">
      <text>外卖</text><view class="order-tab-bar"></view>
    </view>
  </view>

  <view class="order-main">
    <view class="order-list">

      <view class="order-card" wx:for="{{orders}}" wx:key="id">
        <view class="oc-head">
          <view class="oc-store">
            <view class="oc-store-name">{{item.storeName}}</view>
            <view class="oc-icon-btn"><image src="/images/icons/ord-call.svg" mode="aspectFit"/></view>
            <view class="oc-icon-btn"><image src="/images/icons/ord-near.svg" mode="aspectFit"/></view>
          </view>
          <view class="oc-status">
            <text>{{item.statusText}}</text>
            <image src="/images/icons/chev-right.svg" mode="aspectFit"/>
          </view>
        </view>
        <view class="oc-meta">
          <text>{{item.timeText}}</text>
          <text class="oc-meta-sep">|</text>
          <text>取茶号 {{item.pickupNo}}</text>
        </view>
        <view class="oc-body">
          <view class="oc-thumbs">
            <view class="oc-thumb" wx:for="{{item.thumbs}}" wx:for-item="thumb" wx:key="*this">
              <image src="{{thumb}}" mode="aspectFit"/>
            </view>
          </view>
          <view class="oc-price">
            <view class="oc-pay">¥{{item.amount}}</view>
            <text class="oc-qty">共{{item.qty}}件</text>
          </view>
        </view>
        <view class="oc-actions">
          <view class="oc-btn oc-btn-outline">评价一下</view>
          <view class="oc-btn oc-btn-dark" data-id="{{item.id}}" bindtap="repeatOrder">再来一单</view>
        </view>
      </view>

    </view>
  </view>

  <view class="bottom-nav">
    <navigator class="nav-item" url="/pages/home/index" open-type="redirect"><view class="nav-icon"><image class="nav-logo-icon" src="/images/nav/nav-home.svg" mode="aspectFit"/></view><text>首页</text></navigator>
    <navigator class="nav-item" url="/pages/menu/index" open-type="redirect"><view class="nav-icon"><image class="nav-logo-icon" src="/images/nav/nav-menu.svg" mode="aspectFit"/></view><text>点餐</text></navigator>
    <navigator class="nav-item" url="/pages/saving-card/index" open-type="redirect"><view class="nav-icon"><image class="nav-logo-icon" src="/images/nav/nav-saving.svg" mode="aspectFit"/></view><text>省钱卡</text></navigator>
    <navigator class="nav-item is-active" url="/pages/order/index" open-type="redirect"><view class="nav-icon"><image class="nav-logo-icon" src="/images/nav/nav-order.svg" mode="aspectFit"/></view><text>订单</text></navigator>
    <navigator class="nav-item" url="/pages/mine/index" open-type="redirect"><view class="nav-icon"><image class="nav-logo-icon" src="/images/nav/nav-mine.svg" mode="aspectFit"/></view><text>我的</text></navigator>
  </view>
</view>
