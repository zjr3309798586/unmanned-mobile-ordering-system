.profile-hero {
  display: grid;
  grid-template-columns: 152rpx minmax(0, 1fr);
  gap: 24rpx;
  padding: 28rpx;
  border: 1rpx solid #e5eaf1;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 36rpx rgba(20, 48, 96, 0.06);
}

.avatar-thumb {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #1f5eff;
  font-size: 44rpx;
  font-weight: 900;
  background: #eaf1ff;
}

.profile-title {
  margin-top: 16rpx;
  font-size: 40rpx;
  font-weight: 900;
  line-height: 1.22;
}

.member-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #123f9c 0%, #1f5eff 100%);
}

.member-card .info-text {
  color: rgba(255, 255, 255, 0.76);
}

.member-card .hero-badge {
  color: #1f5eff;
  background: #ffffff;
}

.asset-grid,
.more-grid {
  display: grid;
  gap: 16rpx;
}

.asset-grid {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.asset-card {
  padding: 24rpx 16rpx;
  border: 1rpx solid #e5eaf1;
  border-radius: 20rpx;
  text-align: center;
  background: #ffffff;
  box-shadow: 0 8rpx 28rpx rgba(20, 48, 96, 0.04);
}

.asset-card text:first-child {
  display: block;
  color: #1f5eff;
  font-size: 36rpx;
  font-weight: 900;
}

.asset-card text:last-child {
  display: block;
  margin-top: 6rpx;
  color: #6d7788;
  font-size: 22rpx;
}

.service-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  padding: 20rpx 0;
}

.service-row + .service-row {
  border-top: 1rpx solid #e5eaf1;
}

.more-grid {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.compact-feature {
  min-height: 200rpx;
  padding: 20rpx;
}

.feature-card {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  border: 1rpx solid #e5eaf1;
  border-radius: 20rpx;
  background: #ffffff;
}

.feature-strong {
  font-size: 28rpx;
  font-weight: 800;
}

.feature-copy {
  color: #6d7788;
  font-size: 22rpx;
  line-height: 1.5;
}
