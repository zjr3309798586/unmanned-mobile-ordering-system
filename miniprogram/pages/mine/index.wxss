.profile-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 34rpx;
  border-radius: 32rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #ff7a1a 0%, #ffaf63 100%);
  box-shadow: 0 18rpx 38rpx rgba(255, 122, 26, 0.22);
}

.avatar {
  display: flex;
  width: 116rpx;
  height: 116rpx;
  align-items: center;
  justify-content: center;
  border-radius: 34rpx;
  color: #ff7a1a;
  font-size: 38rpx;
  font-weight: 900;
  background: #ffffff;
}

.profile-main {
  flex: 1;
  min-width: 0;
}

.profile-name {
  font-size: 36rpx;
  font-weight: 900;
}

.profile-level {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.8);
  font-size: 24rpx;
}

.login-link {
  display: inline-flex;
  margin-top: 18rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  color: #ff7a1a;
  font-size: 24rpx;
  font-weight: 800;
  background: #ffffff;
}

.asset-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  margin-top: 20rpx;
}

.asset-card {
  padding: 24rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(20, 48, 96, 0.06);
}

.asset-value {
  color: #182033;
  font-size: 34rpx;
  font-weight: 900;
}

.service-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #edf1f6;
}

.service-line:last-child {
  border-bottom: 0;
}

.service-name {
  font-size: 28rpx;
  font-weight: 800;
}

.arrow {
  color: #a3adba;
  font-size: 42rpx;
}
