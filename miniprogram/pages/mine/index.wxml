<view class="mine-shell">

  <view class="mine-hero">
    <view class="hero-actions">
      <view class="hero-icon-btn"><image src="/images/icons/chat.svg" mode="aspectFit"/></view>
      <view class="hero-icon-btn"><image src="/images/icons/settings.svg" mode="aspectFit"/></view>
    </view>

    <image class="hero-mascot-cup" src="/images/home/home-mascot-cup.png" mode="widthFix"/>

    <view class="hero-profile" bindtap="handleProfileTap">
      <image class="hero-avatar" src="/images/mascot/mascot-yunbao-144.png" mode="aspectFill"/>
      <view class="hero-text">
        <view class="hero-title">{{loggedIn ? profile.nickname : '登录 / 注册'}}</view>
        <view class="hero-subtitle">{{loginSubtitle}}</view>
      </view>
    </view>
  </view>

  <view class="mine-main">

    <view class="member-card">
      <view class="member-icon"><image src="/images/icons/diamond.svg" mode="aspectFit"/></view>
      <view class="member-text">
        <view class="member-title-line">云豹会员 <text class="member-arrow">›</text></view>
        <view class="member-sub">享专属优惠 · 生日礼遇 · 下单更省</view>
      </view>
      <navigator class="member-btn" url="/pages/saving-card/index" open-type="redirect">查看会员权益</navigator>
    </view>

    <view class="asset-card">
      <view class="block-title">我的资产</view>
      <view class="asset-grid">
        <view class="asset-item">
          <view class="asset-icon"><image src="/images/icons/coupon.svg" mode="aspectFit"/></view>
          <view class="asset-num-row">
            <text class="asset-num">{{profile.couponCount}}</text>
            <text class="asset-unit">张</text>
          </view>
          <view class="asset-label">优惠券 ›</view>
        </view>
        <view class="asset-item">
          <view class="asset-icon"><image src="/images/icons/wallet.svg" mode="aspectFit"/></view>
          <view class="asset-num-row">
            <text class="asset-num balance">{{profile.savingAmountText}}</text>
          </view>
          <view class="asset-label">已省 ›</view>
        </view>
        <view class="asset-item">
          <view class="asset-icon"><image src="/images/icons/wallet.svg" mode="aspectFit"/></view>
          <view class="asset-num-row">
            <text class="asset-num balance">{{profile.balanceText}}</text>
          </view>
          <view class="asset-label">余额 ›</view>
        </view>
      </view>
    </view>

    <view class="orders-card">
      <view class="block-title">我的订单</view>
      <view class="orders-grid">
        <navigator class="order-item" url="/pages/order/index" open-type="redirect">
          <view class="order-icon"><image src="/images/icons/ord-wallet.svg" mode="aspectFit"/></view>
          <view class="order-label">待付款</view>
        </navigator>
        <navigator class="order-item" url="/pages/order/index" open-type="redirect">
          <view class="order-icon order-icon-badge">
            <image src="/images/icons/ord-cal.svg" mode="aspectFit"/>
            <text class="badge-dot" wx:if="{{waitingCount > 0}}">{{waitingCount}}</text>
          </view>
          <view class="order-label">待取餐</view>
        </navigator>
        <navigator class="order-item" url="/pages/order/index" open-type="redirect">
          <view class="order-icon"><image src="/images/icons/ord-check.svg" mode="aspectFit"/></view>
          <view class="order-label">已完成</view>
        </navigator>
        <navigator class="order-item" url="/pages/order/index" open-type="redirect">
          <view class="order-icon"><image src="/images/icons/ord-head.svg" mode="aspectFit"/></view>
          <view class="order-label">售后</view>
        </navigator>
      </view>
    </view>

    <view class="features-card">
      <view class="block-title">我的功能</view>
      <view class="features-grid">
        <navigator class="feature-item" url="/pages/address/index"><view class="feature-icon-svg"><image src="/images/icons/fn-pin.svg" mode="aspectFit"/></view><view class="feature-label">收货地址</view></navigator>
        <navigator class="feature-item" url="/pages/support/index"><view class="feature-icon-svg"><image src="/images/icons/fn-headset.svg" mode="aspectFit"/></view><view class="feature-label">联系客服</view></navigator>
        <view class="feature-item"><view class="feature-icon-svg"><image src="/images/icons/fn-receipt.svg" mode="aspectFit"/></view><view class="feature-label">发票助手</view></view>
        <view class="feature-item"><view class="feature-icon-svg"><image src="/images/icons/fn-hex.svg" mode="aspectFit"/></view><view class="feature-label">设置</view></view>
        <view class="feature-item"><view class="feature-icon-svg"><image src="/images/icons/fn-help.svg" mode="aspectFit"/></view><view class="feature-label">帮助中心</view></view>
        <navigator class="feature-item" url="/pages/favorites/index"><view class="feature-icon-svg"><image src="/images/icons/fn-star.svg" mode="aspectFit"/></view><view class="feature-label">口味收藏</view></navigator>
        <view class="feature-item"><view class="feature-icon-svg"><image src="/images/icons/fn-coin.svg" mode="aspectFit"/></view><view class="feature-label">省钱明细</view></view>
        <view class="feature-item"><view class="feature-icon-svg"><image src="/images/icons/fn-gift.svg" mode="aspectFit"/></view><view class="feature-label">券包记录</view></view>
      </view>
    </view>

    <view class="story-row">
      <view class="story-card">
        <view class="story-text">
          <view class="story-title">云豹故事</view>
          <view class="story-sub">了解云豹小点</view>
        </view>
        <image class="story-img" src="/images/mine/mine-story-leopard.png" mode="widthFix"/>
      </view>
      <view class="story-card">
        <view class="story-text">
          <view class="story-title">加入云豹</view>
          <view class="story-sub">成为校园合作伙伴</view>
        </view>
        <image class="story-cup" src="/images/mine/mine-cup-cloud.png" mode="widthFix"/>
      </view>
    </view>
  </view>

  <view class="bottom-nav">
    <navigator class="nav-item" url="/pages/home/index" open-type="redirect"><view class="nav-icon"><image class="nav-logo-icon" src="/images/nav/nav-home.svg" mode="aspectFit"/></view><text>首页</text></navigator>
    <navigator class="nav-item" url="/pages/menu/index" open-type="redirect"><view class="nav-icon"><image class="nav-logo-icon" src="/images/nav/nav-menu.svg" mode="aspectFit"/></view><text>点餐</text></navigator>
    <navigator class="nav-item" url="/pages/saving-card/index" open-type="redirect"><view class="nav-icon"><image class="nav-logo-icon" src="/images/nav/nav-saving.svg" mode="aspectFit"/></view><text>省钱卡</text></navigator>
    <navigator class="nav-item" url="/pages/order/index" open-type="redirect"><view class="nav-icon"><image class="nav-logo-icon" src="/images/nav/nav-order.svg" mode="aspectFit"/></view><text>订单</text></navigator>
    <navigator class="nav-item is-active" url="/pages/mine/index" open-type="redirect"><view class="nav-icon"><image class="nav-logo-icon" src="/images/nav/nav-mine-active.svg" mode="aspectFit"/></view><text>我的</text></navigator>
  </view>
</view>
