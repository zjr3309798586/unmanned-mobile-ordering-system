.saving-hero {
  padding: 38rpx 32rpx;
  border-radius: 32rpx;
  color: #ffffff;
  background:
    radial-gradient(circle at 90% 20%, rgba(255, 255, 255, 0.35), transparent 150rpx),
    linear-gradient(135deg, #1d2433 0%, #333f55 48%, #ff7a1a 100%);
  box-shadow: 0 18rpx 38rpx rgba(20, 48, 96, 0.18);
}

.saving-title {
  margin-top: 24rpx;
  font-size: 48rpx;
  font-weight: 900;
}

.saving-text {
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 26rpx;
}

.hero-button {
  width: 100%;
  margin-top: 28rpx;
  color: #ff7a1a;
  background: #ffffff;
}

.benefit-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 22rpx;
}

.benefit {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  color: #ff7a1a;
  font-size: 23rpx;
  font-weight: 800;
  background: #fff1e6;
}

.coupon-line,
.saving-product {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 18rpx;
  padding: 20rpx;
  border-radius: 22rpx;
  background: #f8fafc;
}

.coupon-title {
  font-size: 28rpx;
  font-weight: 800;
}

.coupon-value {
  color: #ff7a1a;
  font-size: 30rpx;
  font-weight: 900;
}

.saving-img {
  width: 128rpx;
  height: 128rpx;
  flex: none;
  border-radius: 20rpx;
  background: #f0f3f8;
}

.saving-info {
  flex: 1;
  min-width: 0;
}

.old-price {
  color: #a3adba;
  font-size: 24rpx;
  text-decoration: line-through;
}
