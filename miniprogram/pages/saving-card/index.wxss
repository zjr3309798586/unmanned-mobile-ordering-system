page { background: #f5faff; }

.saving-shell {
  background: linear-gradient(180deg, #005bbf 0%, #1a73e8 22%, #eaf3ff 38%, #f5faff 100%);
  min-height: 100vh;
  padding-bottom: 360rpx;
}

/* 顶栏 */
.saving-topbar {
  position: relative;
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  padding: 28rpx 32rpx 12rpx;
  color: #fff;
}
.saving-brand-mini { display: flex; align-items: center; gap: 8rpx; color: #fff; font-size: 22rpx; font-weight: 800; letter-spacing: 0.8rpx; justify-self: start; }
.sb-mini-icon { width: 32rpx; height: 32rpx; background: #fff; border-radius: 50%; padding: 4rpx; }
.saving-page-title { color: #fff; font-size: 36rpx; font-weight: 900; justify-self: center; }
.saving-rule { color: #fff; font-size: 24rpx; opacity: .95; justify-self: end; }

/* 主卡 */
.pass-hero { position: relative; padding: 16rpx 32rpx 0; }

.pass-card {
  position: relative;
  overflow: hidden;
  padding: 36rpx 36rpx 156rpx;
  border-radius: 48rpx;
  color: #fff;
  background:
    radial-gradient(circle at 12% 110%, rgba(255,255,255,0.12), transparent 38%),
    linear-gradient(160deg, #1a73e8 0%, #004493 70%, #005bbf 100%);
  box-shadow: 0 36rpx 72rpx rgba(20,83,217,0.28);
  min-height: 420rpx;
}

.pass-mascot {
  position: absolute;
  right: 12rpx;
  bottom: 156rpx;
  width: 264rpx;
  z-index: 4;
}

.pass-card-row {
  position: relative;
  z-index: 3;
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 8rpx;
  padding-right: 200rpx;
}

.pass-card-title { font-size: 52rpx; font-weight: 900; letter-spacing: -1.2rpx; }
.pass-card-tag { display: inline-flex; align-items: center; height: 44rpx; padding: 0 16rpx; border-radius: 999rpx; background: rgba(255,255,255,0.22); color: #fff; font-size: 24rpx; font-weight: 700; }

.pass-save-line { position: relative; z-index: 2; margin-top: 24rpx; font-size: 28rpx; color: rgba(255,255,255,0.92); }
.pass-save-num { color: #ffe066; font-size: 44rpx; font-weight: 900; margin: 0 4rpx; letter-spacing: -0.8rpx; }

.pass-footer {
  position: absolute;
  left: 24rpx; right: 24rpx; bottom: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 24rpx 28rpx;
  border-radius: 32rpx;
  background: #fff;
  box-shadow: 0 12rpx 32rpx rgba(0,0,0,0.08);
  z-index: 3;
}

.pass-price-block { display: flex; align-items: baseline; flex-wrap: wrap; gap: 12rpx; }
.pass-price-amount { display: flex; align-items: baseline; color: #ff5722; line-height: 1; }
.pp-yuan { font-size: 32rpx; font-weight: 800; margin-right: 2rpx; }
.pp-int { font-size: 52rpx; font-weight: 900; letter-spacing: -1.2rpx; }
.pp-mo { color: #999; font-size: 24rpx; font-weight: 600; margin-left: 4rpx; }

.pass-price-badge { display: inline-flex; align-items: center; height: 36rpx; padding: 0 12rpx; border-radius: 8rpx; background: linear-gradient(135deg, #ff9145 0%, #ff5722 100%); color: #fff; font-size: 20rpx; font-weight: 800; }
.pass-price-hint { width: 100%; color: #888; font-size: 22rpx; }

.pass-open-btn { display: inline-flex; align-items: center; justify-content: center; min-height: 76rpx; padding: 0 44rpx; border-radius: 999rpx; color: #fff; font-size: 28rpx; font-weight: 800; background: linear-gradient(135deg, #1a73e8 0%, #005bbf 100%); box-shadow: 0 16rpx 36rpx rgba(0,91,191,0.32); flex: 0 0 auto; }

/* 主区 */
.saving-main {
  padding: 28rpx 32rpx 0;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.block-card {
  padding: 32rpx 32rpx 36rpx;
  border-radius: 36rpx;
  background: #fff;
  box-shadow: 0 20rpx 48rpx rgba(70,110,170,0.08);
}

.block-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24rpx; }
.block-h { color: #1a2a4a; font-size: 32rpx; font-weight: 900; }
.block-link { color: #8a98b5; font-size: 24rpx; }

/* 优惠券 3 列 */
.saving-coupon-row { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 16rpx; }
.saving-coupon { display: flex; flex-direction: column; align-items: center; gap: 8rpx; padding: 28rpx 12rpx 20rpx; border-radius: 24rpx; background: linear-gradient(180deg, #e6f0ff 0%, #f8fbff 100%); border: 2rpx solid #cfe0ff; }
.sc-amount { color: #ff5722; font-size: 56rpx; font-weight: 900; line-height: 1; letter-spacing: -1.2rpx; display: flex; align-items: baseline; }
.sc-currency { font-size: 28rpx; font-weight: 800; margin-right: 2rpx; }
.sc-cond { color: #2a3a5a; font-size: 24rpx; font-weight: 700; }
.sc-tag { color: #8a98b5; font-size: 20rpx; margin-top: 4rpx; }
.sc-btn { width: 100%; margin-top: 12rpx; min-height: 56rpx; border-radius: 999rpx; background: linear-gradient(135deg, #1a73e8 0%, #005bbf 100%); color: #fff; font-size: 22rpx; font-weight: 800; display: flex; align-items: center; justify-content: center; }

/* 商品 3 列 */
.saving-product-row { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 20rpx; }
.saving-product { display: flex; flex-direction: column; align-items: center; padding: 16rpx 12rpx 20rpx; border-radius: 24rpx; background: #f7fbff; border: 2rpx solid #e8eef9; }
.saving-product image { width: 100%; height: 140rpx; background: #fff; border-radius: 16rpx; padding: 12rpx; }
.sp-name { margin-top: 12rpx; color: #1a2a4a; font-size: 24rpx; font-weight: 700; text-align: center; width: 100%; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.sp-price-line { display: flex; align-items: baseline; gap: 8rpx; margin-top: 8rpx; }
.sp-price { color: #ff5722; font-size: 30rpx; font-weight: 900; letter-spacing: -0.8rpx; }
.sp-origin { color: #b0b8c8; font-size: 22rpx; text-decoration: line-through; }

/* 权益 5 列 */
.saving-benefit-grid { display: grid; grid-template-columns: repeat(5, minmax(0,1fr)); gap: 12rpx; }
.sb-item { display: flex; flex-direction: column; align-items: center; gap: 12rpx; padding: 16rpx 4rpx; }
.sb-icon { display: flex; align-items: center; justify-content: center; width: 80rpx; height: 80rpx; border-radius: 50%; background: #eaf3ff; }
.sb-icon image { width: 52rpx; height: 52rpx; }
.sb-label { color: #5a6a85; font-size: 22rpx; font-weight: 600; text-align: center; white-space: nowrap; }

/* 规则 */
.saving-rule-list { color: #6a7a99; font-size: 24rpx; line-height: 1.7; }
.srl-item + .srl-item { margin-top: 8rpx; }

/* 浮动开通条(在导航上方) */
.saving-floating-bar {
  position: fixed;
  left: 24rpx; right: 24rpx;
  bottom: calc(172rpx + env(safe-area-inset-bottom));
  z-index: 9;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx 20rpx 16rpx 28rpx;
  border-radius: 999rpx;
  background: #fff;
  box-shadow: 0 24rpx 64rpx rgba(0,91,191,0.2), 0 0 0 2rpx rgba(0,91,191,0.06);
}
.sfb-mascot { width: 80rpx; height: 80rpx; border-radius: 50%; background: #eaf3ff; flex: 0 0 auto; }
.sfb-text { display: flex; flex-direction: column; gap: 4rpx; flex: 1 1 auto; min-width: 0; }
.sfb-title { color: #1a2a4a; font-size: 26rpx; font-weight: 900; line-height: 1.1; }
.sfb-sub { color: #8a98b5; font-size: 22rpx; line-height: 1.1; }
.sfb-btn { display: inline-flex; align-items: center; gap: 8rpx; min-height: 72rpx; padding: 0 28rpx; border-radius: 999rpx; background: linear-gradient(135deg, #ff9145 0%, #ff5722 100%); color: #fff; font-weight: 800; flex: 0 0 auto; box-shadow: 0 12rpx 28rpx rgba(255,87,34,0.32); }
.sfb-yuan { font-size: 32rpx; font-weight: 900; }
.sfb-btn text:last-child { font-size: 24rpx; }

/* 底部导航(沿用 mine 同款) */
.bottom-nav { position: fixed; left: 0; right: 0; bottom: 0; z-index: 10; display: grid; grid-template-columns: repeat(5, minmax(0,1fr)); min-height: 156rpx; padding: 16rpx 16rpx calc(16rpx + env(safe-area-inset-bottom)); background: rgba(255,255,255,0.96); border-top: 1rpx solid rgba(0,91,191,0.1); box-shadow: 0 -16rpx 40rpx rgba(0,91,191,0.08); }
.nav-item { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4rpx; color: #5c6a80; font-size: 24rpx; }
.nav-icon { display: flex; align-items: center; justify-content: center; width: 68rpx; height: 68rpx; }
.nav-logo-icon { width: 56rpx; height: 56rpx; filter: grayscale(1) brightness(0.55); opacity: 0.9; }
.nav-item.is-active { color: #005bbf; }
.nav-item.is-active .nav-logo-icon { filter: none; opacity: 1; }
