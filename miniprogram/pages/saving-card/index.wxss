.saving-hero {
  padding: 32rpx;
  border-radius: 24rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #123f9c 0%, #1f5eff 62%, #5f8cff 100%);
  box-shadow: 0 24rpx 48rpx rgba(31, 94, 255, 0.2);
}

.saving-title {
  margin-top: 20rpx;
  font-size: 56rpx;
  font-weight: 900;
  line-height: 1.15;
}

.saving-text {
  margin-top: 16rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 24rpx;
  line-height: 1.58;
}

.hero-price-line {
  margin-top: 24rpx;
}

.hero-price {
  color: #ffffff;
  font-size: 40rpx;
  font-weight: 900;
}

.hero-price-note {
  display: block;
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 22rpx;
}

.saving-hero .hero-badge {
  color: #1f5eff;
  background: #ffffff;
}

.saving-hero .button-secondary {
  color: #ffffff;
  border-color: rgba(255, 255, 255, 0.18);
  background: rgba(255, 255, 255, 0.14);
}

.plan-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.plan-card {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 24rpx;
  border: 1rpx solid transparent;
  border-radius: 20rpx;
  text-align: left;
  background: #f7f9fd;
}

.plan-name {
  font-size: 28rpx;
  font-weight: 800;
}

.plan-price {
  color: #ff7a1a;
  font-size: 40rpx;
  font-weight: 900;
}

.plan-note {
  color: #6d7788;
  font-size: 22rpx;
  line-height: 1.45;
}

.plan-card.is-active {
  border-color: #cfdcff;
  background: #eaf1ff;
}

.member-coupon {
  padding: 24rpx;
  border: 1rpx dashed #ffc99f;
  border-radius: 20rpx;
  background: #fff1e6;
}

.member-coupon-title {
  display: block;
  color: #ff7a1a;
  font-size: 28rpx;
  font-weight: 800;
}

.member-coupon-desc {
  display: block;
  margin-top: 8rpx;
  color: #6d7788;
  font-size: 22rpx;
}

.benefit-item {
  display: grid;
  grid-template-columns: 56rpx minmax(0, 1fr);
  gap: 20rpx;
  align-items: flex-start;
}

.old-price {
  color: #98a2b3;
  font-size: 24rpx;
  text-decoration: line-through;
}
