<view class="saving-shell">

  <view class="saving-topbar">
    <view class="saving-brand-mini">
      <image class="sb-mini-icon" src="/images/icons/brand-cloud.svg" mode="aspectFit"/>
      <text>云豹小点</text>
    </view>
    <view class="saving-page-title">省钱卡</view>
    <view class="saving-rule">规则说明</view>
  </view>

  <view class="pass-hero">
    <view class="pass-card">
      <image class="pass-mascot" src="/images/saving-mascot-card.png" mode="widthFix"/>

      <view class="pass-card-row">
        <view class="pass-card-title">云豹省钱卡</view>
        <view class="pass-card-tag">月卡 ›</view>
      </view>
      <view class="pass-save-line">预计本月可省 <text class="pass-save-num">¥48</text></view>

      <view class="pass-footer">
        <view class="pass-price-block">
          <view class="pass-price-amount">
            <text class="pp-yuan">¥</text><text class="pp-int">18</text><text class="pp-mo">/月</text>
          </view>
          <view class="pass-price-badge">首月特惠</view>
          <view class="pass-price-hint">查看全部券 ›</view>
        </view>
        <view class="pass-open-btn" bindtap="openCard">立即开通</view>
      </view>
    </view>
  </view>

  <view class="saving-main">

    <view class="block-card">
      <view class="block-head">
        <view class="block-h">专享优惠券</view>
        <view class="block-link">查看全部 (8) ›</view>
      </view>
      <view class="saving-coupon-row">
        <view class="saving-coupon" wx:for="{{coupons}}" wx:key="id">
          <view class="sc-amount"><text class="sc-currency">¥</text>{{item.discountAmount}}</view>
          <view class="sc-cond">{{item.conditionText}}</view>
          <view class="sc-tag">饮品通用</view>
          <view class="sc-btn" bindtap="claimCoupon" data-id="{{item.id}}">立即领取</view>
        </view>
        <view wx:if="{{coupons.length === 0}}">
          <view class="saving-coupon">
            <view class="sc-amount"><text class="sc-currency">¥</text>5</view>
            <view class="sc-cond">满 20 减</view>
            <view class="sc-tag">开通后领取</view>
            <view class="sc-btn" bindtap="claimCoupon" data-id="C-001">立即领取</view>
          </view>
        </view>
      </view>
    </view>

    <view class="block-card">
      <view class="block-head">
        <view class="block-h">省钱价商品</view>
        <navigator class="block-link" url="/pages/menu/index" open-type="redirect">查看更多 ›</navigator>
      </view>
      <view class="saving-product-row">
        <navigator class="saving-product" url="/pages/detail/index?id=P-1003" open-type="navigate">
          <image src="/images/menu-product-milk-tea.png" mode="aspectFit"/>
          <view class="sp-name">满杯西柚绿茶</view>
          <view class="sp-price-line">
            <text class="sp-price">¥12.8</text>
            <text class="sp-origin">¥13.9</text>
          </view>
        </navigator>
        <navigator class="saving-product" url="/pages/detail/index?id=P-1001" open-type="navigate">
          <image src="/images/menu-product-latte.png" mode="aspectFit"/>
          <view class="sp-name">橙香美式</view>
          <view class="sp-price-line">
            <text class="sp-price">¥13.8</text>
            <text class="sp-origin">¥15.9</text>
          </view>
        </navigator>
        <navigator class="saving-product" url="/pages/detail/index?id=P-1006" open-type="navigate">
          <image src="/images/menu-product-wrap.png" mode="aspectFit"/>
          <view class="sp-name">芝士烤吐司</view>
          <view class="sp-price-line">
            <text class="sp-price">¥8.8</text>
            <text class="sp-origin">¥9.9</text>
          </view>
        </navigator>
      </view>
    </view>

    <view class="block-card">
      <view class="block-head"><view class="block-h">会员权益</view></view>
      <view class="saving-benefit-grid">
        <view class="sb-item"><view class="sb-icon"><image src="/images/icons/sb-cal.svg" mode="aspectFit"/></view><view class="sb-label">每周福利</view></view>
        <view class="sb-item"><view class="sb-icon"><image src="/images/icons/sb-diam.svg" mode="aspectFit"/></view><view class="sb-label">专享折扣</view></view>
        <view class="sb-item"><view class="sb-icon"><image src="/images/icons/sb-star.svg" mode="aspectFit"/></view><view class="sb-label">集邮加速</view></view>
        <view class="sb-item"><view class="sb-icon"><image src="/images/icons/sb-tea.svg" mode="aspectFit"/></view><view class="sb-label">下午茶套餐</view></view>
        <view class="sb-item"><view class="sb-icon"><image src="/images/icons/sb-gift.svg" mode="aspectFit"/></view><view class="sb-label">生日礼遇</view></view>
      </view>
    </view>

    <view class="block-card">
      <view class="block-head"><view class="block-h">开通须知</view></view>
      <view class="saving-rule-list">
        <view class="srl-item">1. 开通即享当月所有专享优惠券,到期自动失效;</view>
        <view class="srl-item">2. 省钱价商品仅在会员有效期内享受优惠价;</view>
        <view class="srl-item">3. 首月特惠仅限新会员,开通后不支持退款。</view>
      </view>
    </view>

  </view>

  <view class="saving-floating-bar">
    <image class="sfb-mascot" src="/images/saving-mascot-card.png" mode="aspectFill"/>
    <view class="sfb-text">
      <view class="sfb-title">云豹省钱卡</view>
      <view class="sfb-sub">预计本月可省 ¥48</view>
    </view>
    <view class="sfb-btn" bindtap="openCard">
      <text class="sfb-yuan">¥18</text>
      <text>立即开通</text>
    </view>
  </view>

  <view class="bottom-nav">
    <navigator class="nav-item" url="/pages/home/index" open-type="redirect"><view class="nav-icon"><image class="nav-logo-icon" src="/images/nav-home.svg" mode="aspectFit"/></view><text>首页</text></navigator>
    <navigator class="nav-item" url="/pages/menu/index" open-type="redirect"><view class="nav-icon"><image class="nav-logo-icon" src="/images/nav-menu.svg" mode="aspectFit"/></view><text>点餐</text></navigator>
    <navigator class="nav-item is-active" url="/pages/saving-card/index" open-type="redirect"><view class="nav-icon"><image class="nav-logo-icon" src="/images/nav-saving-active.svg" mode="aspectFit"/></view><text>省钱卡</text></navigator>
    <navigator class="nav-item" url="/pages/order/index" open-type="redirect"><view class="nav-icon"><image class="nav-logo-icon" src="/images/nav-order.svg" mode="aspectFit"/></view><text>订单</text></navigator>
    <navigator class="nav-item" url="/pages/mine/index" open-type="redirect"><view class="nav-icon"><image class="nav-logo-icon" src="/images/nav-mine.svg" mode="aspectFit"/></view><text>我的</text></navigator>
  </view>
</view>
