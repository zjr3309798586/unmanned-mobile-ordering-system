<view class="saving-shell">
  <view class="saving-topbar">
    <navigator class="saving-back" url="/pages/home/index" open-type="redirect">‹</navigator>
    <view class="saving-page-title">省钱卡</view>
    <view class="saving-rule">
      <text>规则</text>
    </view>
  </view>

  <view class="saving-main">
    <view class="saving-pass-card">
      <view class="pass-ambient pass-ambient-a"></view>
      <view class="pass-ambient pass-ambient-b"></view>

      <view class="pass-head">
        <view class="pass-brand">
          <view class="pass-brand-mark">
            <image src="/images/icons/brand-cloud.svg" mode="aspectFit"/>
          </view>
          <text>云豹小点</text>
        </view>
        <view class="pass-status">{{opened ? '已开通' : '校园月卡'}}</view>
      </view>

      <view class="pass-content">
        <view class="pass-copy">
          <view class="pass-kicker">{{heroPlanName}}</view>
          <view class="pass-title">云豹省钱卡</view>
          <view class="pass-save">预计本月可省 <text>¥48</text></view>
          <view class="pass-tags">
            <text>每月券包</text>
            <text>专属价格</text>
            <text>集杯加速</text>
          </view>
        </view>
        <image class="pass-mascot" src="/images/saving/saving-mascot-card.png" mode="aspectFill"/>
      </view>

      <view class="pass-buy-panel">
        <view class="pass-price">
          <text class="pass-price-main">{{heroPriceText}}</text>
          <text class="pass-price-unit">/月</text>
          <text class="pass-price-badge">首月特惠</text>
          <text class="pass-price-origin">原价 ¥28</text>
        </view>
        <view class="pass-open-btn {{opened || opening ? 'is-disabled' : ''}}" bindtap="openCard">
          {{openButtonText}}
        </view>
      </view>
    </view>

    <view class="saving-stats">
      <view class="stat-card">
        <text>4 张</text>
        <view>每月券包</view>
      </view>
      <view class="stat-card">
        <text>85 折</text>
        <view>省钱价</view>
      </view>
      <view class="stat-card">
        <text>2 倍</text>
        <view>集杯加速</view>
      </view>
    </view>

    <view class="saving-block ticket-block">
      <view class="saving-section-head">
        <view>
          <view class="section-eyebrow">Coupons</view>
          <view class="section-title">本月券包</view>
        </view>
        <view class="section-link">{{couponCountText}}</view>
      </view>

      <view class="ticket-list" wx:if="{{coupons.length}}">
        <view class="saving-ticket {{item.ticketTone}}" wx:for="{{coupons}}" wx:key="id">
          <view class="ticket-value"><text>¥</text>{{item.discountAmountText}}</view>
          <view class="ticket-main">
            <view class="ticket-title">{{item.title}}</view>
            <view class="ticket-cond">{{item.conditionText}}</view>
          </view>
          <view class="ticket-btn {{item.claimed ? 'is-claimed' : (!opened ? 'is-locked' : '')}}" bindtap="claimCoupon" data-id="{{item.id}}">
            {{item.claimText}}
          </view>
        </view>
      </view>
      <view class="saving-empty" wx:else>暂无可领取优惠券</view>
    </view>

    <view class="saving-block">
      <view class="saving-section-head">
        <view>
          <view class="section-eyebrow">Member Price</view>
          <view class="section-title">省钱价商品</view>
        </view>
        <navigator class="section-link" url="/pages/menu/index" open-type="redirect">查看更多</navigator>
      </view>

      <view class="saving-product-list" wx:if="{{products.length}}">
        <view class="saving-product" wx:for="{{products}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
          <image src="{{item.imageUrl}}" mode="aspectFill"/>
          <view class="product-copy">
            <view class="product-name">{{item.name}}</view>
            <view class="product-save">{{item.savedText}}</view>
            <view class="product-price-line">
              <text>{{item.savingPriceText}}</text>
              <text>{{item.priceText}}</text>
            </view>
          </view>
          <view class="product-add">+</view>
        </view>
      </view>
      <view class="saving-empty" wx:else>暂无省钱价商品</view>
    </view>

    <view class="saving-block benefit-block">
      <view class="saving-section-head">
        <view>
          <view class="section-eyebrow">Benefits</view>
          <view class="section-title">会员权益</view>
        </view>
      </view>
      <view class="benefit-grid">
        <view class="benefit-card">
          <view class="benefit-icon">券</view>
          <view class="benefit-title">每月券包</view>
          <view class="benefit-desc">饮品、轻食满减券免费领</view>
        </view>
        <view class="benefit-card">
          <view class="benefit-icon">价</view>
          <view class="benefit-title">专属价格</view>
          <view class="benefit-desc">热门商品开卡后更划算</view>
        </view>
        <view class="benefit-card">
          <view class="benefit-icon">杯</view>
          <view class="benefit-title">集杯加速</view>
          <view class="benefit-desc">集杯任务进度更快完成</view>
        </view>
        <view class="benefit-card">
          <view class="benefit-icon">礼</view>
          <view class="benefit-title">生日福利</view>
          <view class="benefit-desc">生日当月享专属好礼</view>
        </view>
      </view>
    </view>

    <view class="saving-block rule-block">
      <view class="saving-section-head">
        <view>
          <view class="section-eyebrow">Rules</view>
          <view class="section-title">开通须知</view>
        </view>
      </view>
      <view class="saving-rules">
        <view>1. 开通后可领取省钱卡专属优惠券，优惠券有效期以页面展示为准。</view>
        <view>2. 省钱价商品仅在会员有效期内享受，实际价格以下单页为准。</view>
        <view>3. 当前项目未接入真实支付，开通按钮用于模拟会员状态。</view>
      </view>
    </view>
  </view>

  <view class="saving-floating-bar">
    <image class="floating-mascot" src="/images/saving/saving-mascot-card.png" mode="aspectFill"/>
    <view class="floating-copy">
      <view>云豹省钱卡</view>
      <text>预计本月可省 ¥48</text>
    </view>
    <view class="floating-open-btn {{opened || opening ? 'is-disabled' : ''}}" bindtap="openCard">
      <text>{{heroPriceText}}</text>
      <text>{{openButtonText}}</text>
    </view>
  </view>

  <view class="bottom-nav">
    <navigator class="nav-item" url="/pages/home/index" open-type="redirect"><view class="nav-icon"><image class="nav-logo-icon" src="/images/nav/nav-home.svg" mode="aspectFit"/></view><text>首页</text></navigator>
    <navigator class="nav-item" url="/pages/menu/index" open-type="redirect"><view class="nav-icon"><image class="nav-logo-icon" src="/images/nav/nav-menu.svg" mode="aspectFit"/></view><text>点餐</text></navigator>
    <navigator class="nav-item is-active" url="/pages/saving-card/index" open-type="redirect"><view class="nav-icon"><image class="nav-logo-icon" src="/images/nav/nav-saving-active.svg" mode="aspectFit"/></view><text>省钱卡</text></navigator>
    <navigator class="nav-item" url="/pages/order/index" open-type="redirect"><view class="nav-icon"><image class="nav-logo-icon" src="/images/nav/nav-order.svg" mode="aspectFit"/></view><text>订单</text></navigator>
    <navigator class="nav-item" url="/pages/mine/index" open-type="redirect"><view class="nav-icon"><image class="nav-logo-icon" src="/images/nav/nav-mine.svg" mode="aspectFit"/></view><text>我的</text></navigator>
  </view>
</view>
