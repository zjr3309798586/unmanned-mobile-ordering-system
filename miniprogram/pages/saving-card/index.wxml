<view class="app-shell">
  <view class="pass-header">
    <view class="pass-card">
      <view class="pass-card-head">
        <text class="pass-brand">YUNBAO PASS</text>
        <text class="pass-status">会员权益卡</text>
      </view>
      <view class="saving-title">云豹省钱卡</view>
      <view class="saving-text">开通后可领取专属券，指定饮品享省钱价，下单自动校验可用优惠。</view>
      <view class="hero-price-line">
        <text class="hero-price">{{heroPriceText}}</text>
        <text class="hero-price-note">/ 月卡 · 预计月省 28 元</text>
      </view>
      <view class="pass-actions">
        <button class="button button-primary" disabled="{{opened}}" bindtap="openCard">{{openButtonText}}</button>
        <button class="button button-secondary" bindtap="goMenu">去点餐</button>
      </view>
    </view>
  </view>

  <view class="page-main pass-main">
    <view class="benefit-overview">
      <view class="benefit-cell"><text>专属券</text><text>开卡领取</text></view>
      <view class="benefit-cell"><text>省钱价</text><text>指定商品</text></view>
      <view class="benefit-cell"><text>会员日</text><text>每周加码</text></view>
    </view>

    <view class="section-card">
      <view class="section-head compact-head">
        <view>
          <view class="section-title">选择开通方案</view>
          <view class="section-note">价格来自后端配置，可在后台维护</view>
        </view>
      </view>
      <view class="plan-grid">
        <button class="plan-card {{index === 0 ? 'is-active' : ''}}" wx:for="{{plans}}" wx:key="id">
          <text class="plan-name">{{item.name}}</text>
          <text class="plan-price">{{item.priceText}}</text>
          <text class="plan-note">{{item.description}}</text>
        </button>
      </view>
    </view>

    <view class="section-card">
      <view class="section-head">
        <view>
          <view class="section-title">专属优惠券</view>
          <view class="section-note">必须先开通省钱卡，领取后提交订单可使用</view>
        </view>
      </view>
      <view class="coupon-stack">
        <view class="member-coupon" wx:for="{{coupons}}" wx:key="id">
          <text class="coupon-value">减 {{item.discountAmountText}}</text>
          <view>
            <text class="member-coupon-title">{{item.title}}</text>
            <text class="member-coupon-desc">{{item.conditionText}} · 减 {{item.discountText}}</text>
          </view>
          <button class="coupon-claim" data-id="{{item.id}}" disabled="{{item.claimed}}" bindtap="claimCoupon">{{item.claimText}}</button>
        </view>
      </view>
    </view>

    <view class="section-card">
      <view class="section-head">
        <view>
          <view class="section-title">省钱价商品</view>
          <view class="section-note">常点饮品优先展示</view>
        </view>
        <text class="section-link" bindtap="goMenu">全部商品</text>
      </view>
      <view class="product-stack">
        <view class="product-card" wx:for="{{products}}" wx:key="id" data-id="{{item.id}}" bindtap="goDetail">
          <image class="cover-thumb" src="{{item.imageUrl}}" mode="aspectFill" />
          <view class="product-body">
            <view class="product-name">{{item.name}}</view>
            <view class="product-desc">{{item.description}}</view>
            <view class="price-line">
              <text class="price">{{item.savingPriceText}}</text>
              <text class="old-price">{{item.priceText}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="section-card">
      <view class="section-head">
        <view>
          <view class="section-title">权益说明</view>
          <view class="section-note">优惠券是否可用由订单金额和领取状态决定</view>
        </view>
      </view>
      <view class="benefit-list">
        <view class="benefit-item"><text class="benefit-icon">券</text><view><view class="info-title">开卡后领取</view><view class="info-text">未开通时只能查看券，开通后才能领取专属券。</view></view></view>
        <view class="benefit-item"><text class="benefit-icon">核</text><view><view class="info-title">下单自动校验</view><view class="info-text">提交订单时会根据满减门槛判断优惠券是否可用。</view></view></view>
        <view class="benefit-item"><text class="benefit-icon">价</text><view><view class="info-title">专属商品价</view><view class="info-text">部分商品显示会员参考价，实际金额以后端订单结算为准。</view></view></view>
      </view>
    </view>
  </view>

  <view class="bottom-nav">
    <navigator class="nav-item" url="/pages/home/index" open-type="redirect"><view class="nav-icon"><image class="nav-logo-icon" src="/images/nav-home.svg" mode="aspectFit" /></view><text>首页</text></navigator>
    <navigator class="nav-item" url="/pages/menu/index" open-type="redirect"><view class="nav-icon"><image class="nav-logo-icon" src="/images/nav-menu.svg" mode="aspectFit" /></view><text>点餐</text></navigator>
    <navigator class="nav-item is-active" url="/pages/saving-card/index" open-type="redirect"><view class="nav-icon"><image class="nav-logo-icon" src="/images/nav-saving.svg" mode="aspectFit" /></view><text>省钱卡</text></navigator>
    <navigator class="nav-item" url="/pages/order/index" open-type="redirect"><view class="nav-icon"><image class="nav-logo-icon" src="/images/nav-order.svg" mode="aspectFit" /></view><text>订单</text></navigator>
    <navigator class="nav-item" url="/pages/mine/index" open-type="redirect"><view class="nav-icon"><image class="nav-logo-icon" src="/images/nav-mine.svg" mode="aspectFit" /></view><text>我的</text></navigator>
  </view>
</view>
