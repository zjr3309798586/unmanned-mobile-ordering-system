.tip-card {
  margin-top: 0;
  border-color: #cfdcff;
  background: #eaf1ff;
  box-shadow: none;
}

.tip-card .section-title {
  color: #1f5eff;
}

.cart-item {
  align-items: center;
  box-shadow: 0 8rpx 28rpx rgba(20, 48, 96, 0.04);
}

.cart-item-main {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.cart-item-head {
  align-items: flex-start;
}

.checkout-bar .button-primary {
  min-width: 224rpx;
}
