page { background: #F4F8FF; }

.cart-shell {
  background: #F4F8FF;
  min-height: 100vh;
  padding-bottom: 380rpx;
  color: #191c23;
}

.cart-topbar { position: sticky; top: 0; z-index: 40; display: flex; align-items: center; justify-content: space-between; height: 104rpx; padding: 0 32rpx; background: #F4F8FF; }
.ct-back { display: inline-flex; align-items: center; justify-content: center; width: 88rpx; height: 88rpx; }
.ct-back-icon { width: 40rpx; height: 40rpx; }
.ct-title { flex: 1 1 auto; text-align: center; font-size: 36rpx; font-weight: 700; color: #191c23; }
.ct-edit { display: inline-flex; align-items: center; justify-content: center; min-height: 88rpx; color: #1a73e8; font-size: 28rpx; font-weight: 500; padding: 0 24rpx; }

.cart-main { padding: 8rpx 32rpx 32rpx; display: flex; flex-direction: column; gap: 28rpx; }

.store-card { position: relative; display: flex; align-items: stretch; padding: 32rpx; border-radius: 32rpx; background: #fff; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04); }
.sc-main { flex: 1 1 auto; min-width: 0; }
.sc-head { display: flex; align-items: center; gap: 16rpx; margin-bottom: 12rpx; }
.sc-pickup { display: inline-flex; align-items: center; justify-content: center; padding: 4rpx 20rpx; border-radius: 999rpx; background: #191c23; color: #fff; font-size: 22rpx; font-weight: 700; flex: 0 0 auto; }
.sc-store-name { font-size: 36rpx; font-weight: 700; color: #191c23; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.sc-arrow-icon { width: 28rpx; height: 28rpx; opacity: 0.56; }
.sc-addr { color: #575f6b; font-size: 24rpx; line-height: 1.5; }
.sc-divider { margin: 28rpx 0 20rpx; height: 1rpx; background: #f3f4f6; }
.sc-queue { color: #575f6b; font-size: 26rpx; }
.sc-queue-num { color: #1a73e8; font-weight: 700; margin: 0 4rpx; }
.sc-locate { display: inline-flex; align-items: center; justify-content: center; width: 88rpx; flex: 0 0 auto; }
.sc-locate-icon { width: 42rpx; height: 42rpx; }

.cart-card { padding: 32rpx; border-radius: 32rpx; background: #fff; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04); }
.delivery-panel { display: flex; flex-direction: column; gap: 18rpx; }
.delivery-address-card { display: flex; align-items: center; justify-content: space-between; gap: 24rpx; padding: 22rpx; border: 2rpx solid #dfeaff; border-radius: 28rpx; background: #f8fbff; }
.delivery-card-main { flex: 1 1 auto; min-width: 0; display: flex; flex-direction: column; gap: 8rpx; }
.delivery-card-title { color: #102033; font-size: 30rpx; font-weight: 900; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.delivery-card-desc { color: #6f7d95; font-size: 24rpx; line-height: 1.45; }
.delivery-card-action { color: #1f6fff; font-size: 26rpx; font-weight: 900; flex: 0 0 auto; }
.delivery-field { display: flex; align-items: center; gap: 18rpx; min-height: 92rpx; padding: 0 24rpx; border: 2rpx solid #e6edf5; border-radius: 24rpx; background: #ffffff; }
.delivery-field text { width: 136rpx; color: #59687f; font-size: 26rpx; font-weight: 800; flex: 0 0 auto; }
.delivery-field input { flex: 1 1 auto; min-width: 0; color: #102033; font-size: 26rpx; }
.delivery-fee-tip { color: #7a8aa0; font-size: 24rpx; line-height: 1.45; }
.fulfill-card {
  padding: 18rpx;
}
.fulfill-tabs {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}
.fulfill-tab {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 116rpx;
  padding: 18rpx;
  border: 2rpx solid #e3ecf8;
  border-radius: 28rpx;
  background: #f8fbff;
}
.fulfill-tab.is-active {
  border-color: #1f6fff;
  background: linear-gradient(135deg, #ffffff 0%, #eef6ff 100%);
  box-shadow: 0 14rpx 34rpx rgba(31,111,255,0.12);
}
.fulfill-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border-radius: 22rpx;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 900;
  flex: 0 0 auto;
}
.fulfill-icon image {
  width: 44rpx;
  height: 44rpx;
}
.fulfill-icon-pickup {
  background: linear-gradient(135deg, #1f6fff 0%, #075de8 100%);
}
.fulfill-icon-delivery {
  background: linear-gradient(135deg, #ff7a2f 0%, #f04b1f 100%);
}
.fulfill-title,
.fulfill-sub {
  display: block;
}
.fulfill-title {
  color: #102033;
  font-size: 28rpx;
  font-weight: 900;
}
.fulfill-sub {
  margin-top: 6rpx;
  color: #6f7d95;
  font-size: 22rpx;
}
.fulfill-fee-tip {
  margin-top: 14rpx;
  padding: 14rpx 18rpx;
  border-radius: 20rpx;
  color: #6f7d95;
  background: #f3f7ff;
  font-size: 24rpx;
  line-height: 1.4;
}
.cc-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 28rpx; }
.cc-title { font-size: 30rpx; font-weight: 700; color: #191c23; }
.cc-title-row { display: inline-flex; align-items: center; gap: 12rpx; }
.cc-help { display: inline-flex; align-items: center; justify-content: center; width: 28rpx; height: 28rpx; border-radius: 50%; border: 2rpx solid #d1d5db; color: #9ca3af; font-size: 20rpx; }
.cc-meta { color: #575f6b; font-size: 24rpx; }

.cart-items { display: flex; flex-direction: column; gap: 24rpx; margin-top: 24rpx; margin-bottom: 24rpx; }
.cart-item { display: flex; align-items: flex-start; gap: 24rpx; }
.ci-thumb { position: relative; width: 152rpx; height: 152rpx; border-radius: 20rpx; background: #f3f4f6; overflow: hidden; flex: 0 0 auto; }
.ci-thumb image { width: 100%; height: 100%; }
.ci-new { position: absolute; top: 8rpx; left: 8rpx; padding: 2rpx 12rpx; border-radius: 8rpx; background: #1a73e8; color: #fff; font-size: 20rpx; font-weight: 700; }
.ci-body { flex: 1 1 auto; min-width: 0; display: flex; flex-direction: column; gap: 12rpx; }
.ci-row1 { display: flex; align-items: baseline; justify-content: space-between; gap: 24rpx; }
.ci-name { font-size: 30rpx; font-weight: 600; color: #191c23; }
.ci-price { display: inline-flex; align-items: baseline; color: #191c23; }
.ci-yuan { font-size: 28rpx; font-weight: 700; }
.ci-int { font-size: 44rpx; font-weight: 700; letter-spacing: -1rpx; line-height: 1; }
.ci-spec { color: #575f6b; font-size: 24rpx; }
.ci-row3 { display: flex; align-items: center; justify-content: space-between; gap: 24rpx; }
.ci-promo { display: inline-flex; align-items: center; padding: 4rpx 16rpx; border-radius: 12rpx; background: rgba(255,77,79,0.08); color: #FF4D4F; font-size: 22rpx; font-weight: 500; white-space: nowrap; }
.ci-promo-placeholder { flex: 1 1 auto; }
.ci-qty { color: #575f6b; font-size: 26rpx; }

.cc-total { margin-top: 24rpx; text-align: right; color: #575f6b; font-size: 26rpx; }
.cc-strong { color: #191c23; font-weight: 700; margin: 0 4rpx; }
.cc-total-price { display: inline-flex; align-items: baseline; color: #191c23; margin-left: 8rpx; }
.cc-tp-yuan { font-size: 28rpx; font-weight: 700; }
.cc-tp-int { font-size: 36rpx; font-weight: 700; letter-spacing: -1rpx; }

.addon-row { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 24rpx; }
.addon-item { display: flex; flex-direction: column; padding: 16rpx; border-radius: 32rpx; background: #fafafa; border: 1rpx solid #f3f4f6; }
.ao-cover { position: relative; width: 100%; height: 240rpx; border-radius: 24rpx; background: #f3f4f6; overflow: hidden; margin-bottom: 20rpx; }
.ao-cover image { width: 100%; height: 100%; }
.ao-save { position: absolute; top: 12rpx; right: 12rpx; padding: 4rpx 16rpx; border-radius: 999rpx; background: #ffe4e6; color: #FF4D4F; font-size: 22rpx; font-weight: 600; }
.ao-info { padding: 0 8rpx 8rpx; }
.ao-name { font-size: 28rpx; font-weight: 500; color: #191c23; margin-bottom: 12rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.ao-row { display: flex; align-items: center; justify-content: space-between; }
.ao-price { display: inline-flex; align-items: baseline; color: #FF4D4F; }
.ao-yuan { font-size: 24rpx; font-weight: 700; }
.ao-int { font-size: 36rpx; font-weight: 700; letter-spacing: -0.8rpx; line-height: 1; }
.ao-dec { font-size: 24rpx; font-weight: 700; }
.ao-origin { margin-left: 12rpx; color: #9ca3af; font-size: 24rpx; text-decoration: line-through; }
.ao-add { display: inline-flex; align-items: center; justify-content: center; width: 88rpx; height: 88rpx; border-radius: 50%; background: #191c23; color: #fff; font-size: 44rpx; font-weight: 300; line-height: 1; flex: 0 0 auto; }

.discount-row { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.dr-name { flex: 1 1 auto; color: #191c23; font-size: 28rpx; }
.dr-amount { color: #FF4D4F; font-size: 30rpx; font-weight: 700; flex: 0 0 auto; }
.dr-hint { display: block; margin-top: 16rpx; color: #575f6b; font-size: 24rpx; }

/* 空购物车占位 */
.cart-empty-card { padding: 80rpx 32rpx; }
.cart-empty-body { display: flex; flex-direction: column; align-items: center; gap: 32rpx; }
.cart-empty-text { color: #9ca3af; font-size: 28rpx; }
.cart-empty-btn { display: inline-flex; align-items: center; justify-content: center; min-height: 88rpx; padding: 0 56rpx; border-radius: 999rpx; background: #1a73e8; color: #fff; font-size: 28rpx; font-weight: 600; }

/* 优惠券抽屉 */
.coupon-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 60;
  background: rgba(0,0,0,0.45);
  opacity: 0; pointer-events: none;
  transition: opacity .2s;
}
.coupon-mask.is-open { opacity: 1; pointer-events: auto; }
.coupon-drawer {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 70;
  max-height: 75vh;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  box-shadow: 0 -12rpx 40rpx rgba(0,0,0,0.12);
  transform: translateY(100%);
  transition: transform .25s;
  display: flex; flex-direction: column;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}
.coupon-drawer.is-open { transform: translateY(0); }
.cd-head {
  display: flex; align-items: center; justify-content: space-between;
  padding: 32rpx 32rpx 16rpx;
}
.cd-head-title { font-size: 32rpx; font-weight: 700; color: #191c23; }
.cd-close { display: inline-flex; align-items: center; justify-content: center; min-height: 88rpx; color: #6b7280; font-size: 28rpx; padding: 0 20rpx; }
.cd-list {
  flex: 1 1 auto; min-height: 0; overflow-y: auto;
  padding: 0 32rpx 16rpx;
}
.cd-coupon {
  display: flex; align-items: center; gap: 24rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #f8f9fb;
  border: 2rpx solid transparent;
  margin-bottom: 16rpx;
}
.cd-coupon.is-selected {
  background: #f0f7ff;
  border-color: #1a73e8;
}
.cd-coupon.is-disabled {
  opacity: 0.55;
  background: #f8f9fb;
}
.cd-coupon.is-disabled .cdc-amount { color: #9ca3af; }
.cdc-amount {
  display: inline-flex; align-items: baseline;
  color: #FF4D4F;
  flex: 0 0 auto;
}
.cdc-yuan { font-size: 24rpx; font-weight: 700; }
.cdc-int { font-size: 52rpx; font-weight: 800; letter-spacing: -1rpx; line-height: 1; }
.cdc-body { flex: 1 1 auto; min-width: 0; }
.cdc-title { display: block; font-size: 28rpx; font-weight: 600; color: #191c23; }
.cdc-cond { display: block; margin-top: 4rpx; color: #6b7280; font-size: 24rpx; }
.cdc-gap {
  display: inline-block;
  margin-left: 8rpx;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  background: #fff0f0;
  color: #FF4D4F;
  font-size: 22rpx;
  font-weight: 600;
}
.cd-coupon-empty {
  padding: 80rpx 0;
  display: flex; flex-direction: column; align-items: center; gap: 8rpx;
  color: #9ca3af;
  font-size: 26rpx;
}
.cd-coupon-empty-sub { color: #1a73e8; font-size: 24rpx; }
.cd-no-coupon {
  margin: 16rpx 32rpx 0;
  padding: 24rpx 0;
  border-radius: 999rpx;
  background: #f3f4f6;
  color: #4b5563;
  font-size: 28rpx;
  text-align: center;
}

.pay-bar { position: fixed; left: 0; right: 0; bottom: calc(156rpx + env(safe-area-inset-bottom)); z-index: 45; background: #fff; box-shadow: 0 -4rpx 32rpx rgba(0,0,0,0.05); }
.pb-bonus { display: flex; align-items: center; justify-content: center; gap: 12rpx; padding: 16rpx 32rpx; background: #fafafa; color: #575f6b; font-size: 24rpx; }
.pb-bonus-icon { width: 28rpx; height: 28rpx; flex: 0 0 auto; }
.pb-bonus-num { color: #1a73e8; font-weight: 700; margin: 0 4rpx; }
.pb-bonus-help { display: inline-flex; align-items: center; justify-content: center; width: 28rpx; height: 28rpx; border-radius: 50%; border: 2rpx solid #d1d5db; color: #9ca3af; font-size: 20rpx; }

.pb-main { display: flex; align-items: center; justify-content: space-between; padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom)); }
.pb-left { display: flex; flex-direction: column; gap: 8rpx; }
.pb-pay-row { display: inline-flex; align-items: baseline; color: #FF4D4F; }
.pb-pay-label { color: #191c23; font-size: 28rpx; font-weight: 500; margin-right: 4rpx; }
.pb-yuan { font-size: 28rpx; font-weight: 700; }
.pb-pay-int { font-size: 52rpx; font-weight: 800; letter-spacing: -1.2rpx; line-height: 1; }
.pb-pay-dec { font-size: 36rpx; font-weight: 700; }
.pb-pay-origin { margin-left: 16rpx; color: #9ca3af; font-size: 26rpx; text-decoration: line-through; }
.pb-saved { color: #575f6b; font-size: 24rpx; }
.pb-saved-num { color: #FF4D4F; font-weight: 700; }
.pb-go-btn { display: inline-flex; align-items: center; justify-content: center; padding: 28rpx 64rpx; border-radius: 999rpx; background: #191c23; color: #fff; font-size: 32rpx; font-weight: 700; box-shadow: 0 16rpx 40rpx rgba(0,0,0,0.15); }

/* UI polish: cleaner cart spacing, no business changes. */
.cart-shell {
  padding-bottom: 356rpx;
}

.cart-topbar {
  height: 100rpx;
  padding: 0 28rpx;
}

.ct-title {
  line-height: 1.24;
}

.cart-main {
  padding: 8rpx 28rpx 28rpx;
  gap: 24rpx;
}

.store-card,
.cart-card {
  border: 1rpx solid rgba(31, 111, 255, 0.08);
  box-shadow: 0 20rpx 48rpx rgba(31, 111, 255, 0.08);
}

.store-card {
  padding: 28rpx;
}

.sc-head {
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.sc-store-name {
  line-height: 1.26;
}

.sc-addr {
  line-height: 1.52;
}

.sc-divider {
  margin: 24rpx 0 18rpx;
}

.cart-card {
  padding: 28rpx;
}

.cc-head {
  margin-bottom: 22rpx;
}

.cart-items {
  gap: 20rpx;
  margin-top: 20rpx;
  margin-bottom: 20rpx;
}

.cart-item {
  gap: 20rpx;
}

.ci-thumb {
  width: 144rpx;
  height: 144rpx;
}

.ci-body {
  gap: 10rpx;
}

.ci-name {
  line-height: 1.3;
}

.addon-row {
  gap: 18rpx;
}

.addon-item {
  padding: 14rpx;
}

.ao-cover {
  height: 212rpx;
  margin-bottom: 16rpx;
}

.ao-name,
.dr-name,
.dr-hint {
  line-height: 1.35;
}

.coupon-drawer {
  border-radius: 36rpx 36rpx 0 0;
}

.pay-bar {
  bottom: calc(148rpx + env(safe-area-inset-bottom));
}

.pb-main {
  gap: 20rpx;
  padding: 22rpx 28rpx calc(22rpx + env(safe-area-inset-bottom));
}

.pb-go-btn {
  min-width: 260rpx;
  padding: 0 48rpx;
  min-height: 92rpx;
  line-height: 92rpx;
}
