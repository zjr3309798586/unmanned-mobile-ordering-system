<view class="cart-shell">

  <view class="cart-topbar">
    <view class="ct-back" bindtap="goBack">
      <image class="ct-back-icon" src="/images/icons/d-back.svg" mode="aspectFit"/>
    </view>
    <text class="ct-title">购物车</text>
    <view class="ct-edit" bindtap="onEdit">编辑</view>
  </view>

  <view class="cart-main">

    <!-- 门店卡 -->
    <view class="store-card">
      <view class="sc-main">
        <view class="sc-head">
          <text class="sc-pickup">{{pickupTypeText}}</text>
          <text class="sc-store-name">{{storeName}}</text>
          <image class="sc-arrow-icon" src="/images/icons/chev-right.svg" mode="aspectFit"/>
        </view>
        <text class="sc-addr">{{storeAddress}}</text>
        <view class="sc-divider"></view>
        <text class="sc-queue">前方<text class="sc-queue-num">{{queueCupCount}}杯</text>/<text class="sc-queue-num">{{queueOrderCount}}单</text>制作中</text>
      </view>
      <view class="sc-locate"><image class="sc-locate-icon" src="/images/icons/fn-pin.svg" mode="aspectFit"/></view>
    </view>

    <view class="cart-card fulfill-card">
      <view class="fulfill-tabs">
        <view class="fulfill-tab {{pickupType === 'SELF_PICKUP' ? 'is-active' : ''}}" data-type="SELF_PICKUP" bindtap="switchPickupType">
          <view class="fulfill-icon fulfill-icon-pickup"><image src="/images/icons/fulfill-pickup.svg" mode="aspectFit"/></view>
          <view>
            <text class="fulfill-title">到店自取</text>
            <text class="fulfill-sub">约 8 分钟可取</text>
          </view>
        </view>
        <view class="fulfill-tab {{pickupType === 'DELIVERY' ? 'is-active' : ''}}" data-type="DELIVERY" bindtap="switchPickupType">
          <view class="fulfill-icon fulfill-icon-delivery"><image src="/images/icons/fulfill-delivery.svg" mode="aspectFit"/></view>
          <view>
            <text class="fulfill-title">平台外送</text>
            <text class="fulfill-sub">满 35 元免配送费</text>
          </view>
        </view>
      </view>
      <view class="fulfill-fee-tip">{{deliveryFeeText}}</view>
    </view>

    <view class="cart-card delivery-panel" wx:if="{{pickupType === 'DELIVERY'}}">
      <view class="delivery-address-card" bindtap="chooseAddress">
        <view class="delivery-card-main">
          <text class="delivery-card-title">{{addressTitle}}</text>
          <text class="delivery-card-desc">{{addressDesc}}</text>
        </view>
        <text class="delivery-card-action">选择地址</text>
      </view>
      <view class="delivery-field">
        <text>配送地址</text>
        <input type="text" value="{{deliveryAddress}}" placeholder="例如：3 号宿舍楼 502" bindinput="inputDeliveryAddress"/>
      </view>
      <view class="delivery-field">
        <text>联系电话</text>
        <input type="number" value="{{deliveryContact}}" placeholder="例如：13800000000" bindinput="inputDeliveryContact"/>
      </view>
      <text class="delivery-fee-tip">{{deliveryFeeText}}</text>
    </view>

    <!-- 商品明细 -->
    <view class="cart-card" wx:if="{{!isEmpty}}">
      <text class="cc-title">商品明细</text>
      <view class="cart-items">
        <view class="cart-item" wx:for="{{items}}" wx:key="id">
          <view class="ci-thumb">
            <image src="{{item.imageUrl}}" mode="aspectFill"/>
            <text class="ci-new" wx:if="{{item.isNew}}">新</text>
          </view>
          <view class="ci-body">
            <view class="ci-row1">
              <text class="ci-name">{{item.name}}</text>
              <view class="ci-price"><text class="ci-yuan">¥</text><text class="ci-int">{{item.priceText}}</text></view>
            </view>
            <text class="ci-spec">{{item.specText}}</text>
            <view class="ci-row3">
              <text class="ci-promo" wx:if="{{item.promoText}}">{{item.promoText}}</text>
              <text class="ci-promo-placeholder" wx:else></text>
              <text class="ci-qty">x{{item.quantity}}</text>
            </view>
          </view>
        </view>
      </view>
      <view class="cc-total">
        <text>共<text class="cc-strong">{{totalQty}}</text>件商品,总计 </text>
        <view class="cc-total-price">
          <text class="cc-tp-yuan">¥</text>
          <text class="cc-tp-int">{{totalAmount}}</text>
        </view>
      </view>
    </view>

    <!-- 空购物车占位 -->
    <view class="cart-card cart-empty-card" wx:if="{{isEmpty}}">
      <view class="cart-empty-body">
        <text class="cart-empty-text">购物车空空,先去点点单</text>
        <view class="cart-empty-btn" bindtap="goMenu">去点餐</view>
      </view>
    </view>

    <!-- 超值加购 -->
    <view class="cart-card">
      <view class="cc-head">
        <view class="cc-title-row">
          <text class="cc-title">超值加购 </text>
          <text class="cc-help">?</text>
        </view>
        <text class="cc-meta">一起搭配更划算</text>
      </view>
      <view class="addon-row">
        <view class="addon-item" wx:for="{{addons}}" wx:key="id" data-id="{{item.id}}" bindtap="addAddon">
          <view class="ao-cover">
            <image src="{{item.imageUrl}}" mode="aspectFill"/>
            <text class="ao-save">{{item.save}}</text>
          </view>
          <view class="ao-info">
            <text class="ao-name">{{item.name}}</text>
            <view class="ao-row">
              <view class="ao-price">
                <text class="ao-yuan">¥</text>
                <text class="ao-int">{{item.priceInt}}</text>
                <text class="ao-dec">.{{item.priceDec}}</text>
                <text class="ao-origin" wx:if="{{item.origin}}">¥{{item.origin}}</text>
              </view>
              <view class="ao-add"><text>+</text></view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 优惠券入口 -->
    <view class="cart-card coupon-entry" bindtap="openDrawer">
      <view class="cc-head">
        <text class="cc-title">优惠券</text>
        <text class="cc-meta">选择优惠券 ›</text>
      </view>
      <view class="discount-row">
        <text class="dr-name">{{drNameText}}</text>
        <text class="dr-amount">{{drAmountText}}</text>
      </view>
      <text class="dr-hint">{{drHintText}}</text>
    </view>
  </view>

  <!-- 选优惠券抽屉 -->
  <view class="coupon-mask {{drawerOpen ? 'is-open' : ''}}" bindtap="closeDrawer"></view>
  <view class="coupon-drawer {{drawerOpen ? 'is-open' : ''}}" catchtap="noop">
    <view class="cd-head">
      <text class="cd-head-title">选择优惠券</text>
      <text class="cd-close" bindtap="closeDrawer">取消</text>
    </view>
    <view class="cd-list">
      <block wx:if="{{couponDisplay.length === 0}}">
        <view class="cd-coupon-empty">
          <text>还没有可用优惠券</text>
          <text class="cd-coupon-empty-sub">去省钱卡领一张</text>
        </view>
      </block>
      <block wx:else>
        <view
          class="cd-coupon {{item.id === selectedCouponId ? 'is-selected' : ''}} {{item.usable ? '' : 'is-disabled'}}"
          wx:for="{{couponDisplay}}"
          wx:key="id"
          data-id="{{item.id}}"
          data-usable="{{item.usable ? 1 : 0}}"
          data-gap="{{item.gap}}"
          bindtap="pickCoupon"
        >
          <view class="cdc-amount">
            <text class="cdc-yuan">¥</text>
            <text class="cdc-int">{{item.discountAmount}}</text>
          </view>
          <view class="cdc-body">
            <text class="cdc-title">{{item.title}}</text>
            <view class="cdc-cond">
              <text>{{item.conditionText}}</text>
              <text class="cdc-gap" wx:if="{{!item.usable}}">还差 ¥{{item.gap}}</text>
            </view>
          </view>
        </view>
      </block>
    </view>
    <view class="cd-no-coupon" bindtap="clearCoupon">不使用优惠券</view>
  </view>

  <!-- 底部支付条 -->
  <view class="pay-bar">
    <view class="pb-bonus">
      <image class="pb-bonus-icon" src="/images/icons/coupon-blue.svg" mode="aspectFit"/>
      <text>优惠券按使用门槛自动校验</text>
      <text class="pb-bonus-help">?</text>
    </view>
    <view class="pb-main">
      <view class="pb-left">
        <view class="pb-pay-row">
          <text class="pb-pay-label">实付 </text>
          <text class="pb-yuan">¥</text>
          <text class="pb-pay-int">{{payInt}}</text>
          <text class="pb-pay-dec">.{{payDec}}</text>
          <text class="pb-pay-origin">¥{{payOrigin}}</text>
        </view>
        <text class="pb-saved">总计优惠 <text class="pb-saved-num">¥{{saved}}</text></text>
      </view>
      <view class="pb-go-btn" bindtap="onPay">立即支付</view>
    </view>
  </view>

  <view class="bottom-nav cart-bottom-nav">
    <navigator class="nav-item" url="/pages/home/index" open-type="redirect"><view class="nav-icon"><image class="nav-logo-icon" src="/images/nav/nav-home.svg" mode="aspectFit"/></view><text>首页</text></navigator>
    <navigator class="nav-item is-active" url="/pages/menu/index" open-type="redirect"><view class="nav-icon"><image class="nav-logo-icon" src="/images/nav/nav-menu.svg" mode="aspectFit"/></view><text>点餐</text></navigator>
    <navigator class="nav-item" url="/pages/saving-card/index" open-type="redirect"><view class="nav-icon"><image class="nav-logo-icon" src="/images/nav/nav-saving.svg" mode="aspectFit"/></view><text>省钱卡</text></navigator>
    <navigator class="nav-item" url="/pages/order/index" open-type="redirect"><view class="nav-icon"><image class="nav-logo-icon" src="/images/nav/nav-order.svg" mode="aspectFit"/></view><text>订单</text></navigator>
    <navigator class="nav-item" url="/pages/mine/index" open-type="redirect"><view class="nav-icon"><image class="nav-logo-icon" src="/images/nav/nav-mine.svg" mode="aspectFit"/></view><text>我的</text></navigator>
  </view>
</view>
