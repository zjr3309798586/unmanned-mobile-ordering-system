<view class="app-shell">
  <view class="top-area">
    <view class="store-card compact-store">
      <view class="store-header">
        <view>
          <text class="store-label">当前购物车</text>
          <view class="store-name">{{storeName}}</view>
        </view>
        <text class="status-pill">支持继续加购</text>
      </view>
      <view class="store-address">已选商品将保存在当前门店购物车中，可直接跳转提交订单页。</view>
    </view>
  </view>

  <view class="page-main with-floating-bar">
    <view class="section-card tip-card">
      <view class="section-head compact-head">
        <view>
          <view class="section-title">优惠提示</view>
          <view class="section-note">当前可用满减券与省钱卡优惠</view>
        </view>
      </view>
      <view class="info-text">{{tipText}}</view>
    </view>

    <view class="section-card" wx:if="{{needsLogin}}">
      <view class="empty-state">
        <view class="empty-title">请先登录</view>
        <view class="section-note">登录后购物车会按你的账号保存，之后可继续提交订单。</view>
        <button class="button button-primary" bindtap="login">去登录</button>
      </view>
    </view>

    <view wx:if="{{loggedIn}}">
      <view class="section-card">
        <view class="section-head">
          <view>
            <view class="section-title">已选商品</view>
            <view class="section-note">支持数量修改与删除</view>
          </view>
          <navigator class="section-link" url="/pages/menu/index" open-type="redirect">继续点餐</navigator>
        </view>
        <view class="cart-item-list" wx:if="{{!cart.isEmpty}}">
          <view class="cart-item" wx:for="{{cart.items}}" wx:key="id">
            <image class="cover-thumb" src="{{item.imageUrl}}" mode="aspectFill" />
            <view class="cart-item-main">
              <view class="cart-item-head">
                <view>
                  <view class="product-name">{{item.productName}}</view>
                  <view class="product-desc">{{item.specText}}</view>
                </view>
                <button class="text-action" data-id="{{item.id}}" bindtap="removeItem">删除</button>
              </view>
              <view class="price-line">
                <text class="price small-price">{{item.subtotalText}}</text>
                <view class="stepper">
                  <button data-id="{{item.id}}" data-quantity="{{item.quantity}}" data-delta="-1" bindtap="changeQuantity">-</button>
                  <text>{{item.quantity}}</text>
                  <button data-id="{{item.id}}" data-quantity="{{item.quantity}}" data-delta="1" bindtap="changeQuantity">+</button>
                </view>
              </view>
            </view>
          </view>
        </view>
        <view class="empty-state" wx:if="{{cart.isEmpty}}">
          <view class="empty-title">购物车暂时为空</view>
          <view class="section-note">可以从菜单页继续选择商品，加入后会显示在这里。</view>
          <button class="button button-primary" bindtap="goMenu">返回点餐页</button>
        </view>
      </view>

      <view class="section-card">
        <view class="section-head compact-head">
          <view>
            <view class="section-title">费用明细</view>
            <view class="section-note">当前金额来自购物车已选商品</view>
          </view>
        </view>
        <view class="summary-list">
          <view class="summary-row"><text>商品总价</text><text>{{cart.totalText}}</text></view>
          <view class="summary-row"><text>包装费</text><text>¥ 0.00</text></view>
          <view class="summary-row"><text>优惠金额</text><text class="discount-price">- ¥ 0.00</text></view>
          <view class="summary-row total-row"><text>应付金额</text><text class="accent-price">{{cart.totalText}}</text></view>
        </view>
      </view>
    </view>
  </view>

  <view class="floating-bar checkout-bar" wx:if="{{loggedIn && !cart.isEmpty}}">
    <view class="floating-summary">
      <text class="floating-label">待结算金额</text>
      <text class="floating-price">{{cart.totalText}}</text>
      <text class="floating-label">{{cart.totalQuantity}} 件商品</text>
    </view>
    <navigator class="button button-primary" url="/pages/submit-order/index" open-type="redirect">去结算</navigator>
  </view>

  <view class="bottom-nav">
    <navigator class="nav-item" url="/pages/home/index" open-type="redirect"><text class="nav-icon">首</text><text>首页</text></navigator>
    <navigator class="nav-item" url="/pages/menu/index" open-type="redirect"><text class="nav-icon">餐</text><text>点餐</text></navigator>
    <navigator class="nav-item" url="/pages/saving-card/index" open-type="redirect"><text class="nav-icon">卡</text><text>省钱卡</text></navigator>
    <navigator class="nav-item" url="/pages/order/index" open-type="redirect"><text class="nav-icon">单</text><text>订单</text></navigator>
    <navigator class="nav-item" url="/pages/mine/index" open-type="redirect"><text class="nav-icon">我</text><text>我的</text></navigator>
  </view>
</view>
