.submit-top-area {
  padding-bottom: 0;
}

.submit-item-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  padding: 20rpx 0;
}

.submit-item-row + .submit-item-row {
  border-top: 1rpx solid #e5eaf1;
}

.coupon-select {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  width: 100%;
  padding: 24rpx;
  border: 1rpx solid transparent;
  border-radius: 20rpx;
  color: #6d7788;
  text-align: left;
  background: #f7f9fd;
}

.coupon-title {
  color: #182033;
  font-size: 28rpx;
  font-weight: 800;
}

.coupon-note {
  margin-top: 8rpx;
  color: #6d7788;
  font-size: 22rpx;
}

.coupon-select text {
  color: #1f5eff;
  font-size: 22rpx;
  font-weight: 800;
}

.coupon-select.is-active {
  color: #1f5eff;
  border-color: #cfdcff;
  background: #eaf1ff;
}
