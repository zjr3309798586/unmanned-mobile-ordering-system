<view class="app-shell">
  <view class="top-area submit-top-area">
    <text class="back-link" bindtap="goCart">返回购物车</text>
    <view class="page-title">提交订单</view>
  </view>

  <view class="page-main with-floating-bar">
    <view class="section-card">
      <view class="section-head compact-head">
        <view>
          <view class="section-title">取餐方式</view>
          <view class="section-note">选择后会随订单一起提交</view>
        </view>
      </view>
      <view class="choice-row">
        <button class="choice-chip {{item.active ? 'is-active' : ''}}" wx:for="{{pickupTypes}}" wx:key="id" data-id="{{item.id}}" bindtap="selectPickup">{{item.name}}</button>
      </view>
    </view>

    <view class="section-card" wx:if="{{store}}">
      <view class="section-head compact-head">
        <view>
          <view class="section-title">门店信息</view>
          <view class="section-note">当前订单所属门店</view>
        </view>
      </view>
      <view class="info-row no-divider">
        <view>
          <view class="info-title">{{store.name}}</view>
          <view class="info-text">{{store.address}}</view>
        </view>
      </view>
    </view>

    <view class="section-card">
      <view class="section-head">
        <view>
          <view class="section-title">商品清单</view>
          <view class="section-note">与购物车页保持结构一致</view>
        </view>
      </view>
      <view class="submit-item-list">
        <view class="submit-item-row" wx:for="{{cart.items}}" wx:key="id">
          <view>
            <view class="info-title">{{item.productName}}</view>
            <view class="info-text">{{item.specText}} × {{item.quantity}}</view>
          </view>
          <text>{{item.subtotalText}}</text>
        </view>
      </view>
      <view class="empty-state" wx:if="{{cart.isEmpty}}">
        <view class="empty-title">购物车为空</view>
      </view>
    </view>

    <view class="section-card">
      <view class="section-head compact-head">
        <view>
          <view class="section-title">优惠券选择</view>
          <view class="section-note">默认不使用，点击优惠券后才抵扣</view>
        </view>
      </view>
      <view class="coupon-select-list">
        <button class="coupon-select {{selectedCouponId === '' ? 'is-active' : ''}}" data-id="" bindtap="selectCoupon">
          <view><view class="coupon-title">不使用优惠券</view><view class="coupon-note">保持原价结算</view></view>
          <text>当前选择</text>
        </button>
        <button class="coupon-select {{item.active ? 'is-active' : ''}}" wx:for="{{coupons}}" wx:key="id" data-id="{{item.id}}" bindtap="selectCoupon">
          <view><view class="coupon-title">{{item.title}}</view><view class="coupon-note">{{item.conditionText}} · 有效期至 {{item.validUntil}}</view></view>
          <text>-{{item.discountText}}</text>
        </button>
        <view class="empty-state compact-empty" wx:if="{{coupons.length === 0}}">
          <view class="empty-title">暂无可用优惠券</view>
          <view class="empty-text">可以先去省钱卡页面领取，再回来结算。</view>
          <button class="button button-secondary" bindtap="goSavingCard">去领取优惠券</button>
        </view>
      </view>
    </view>

    <view class="section-card">
      <view class="section-head compact-head">
        <view>
          <view class="section-title">桌号 / 取餐号</view>
          <view class="section-note">根据取餐方式灵活切换</view>
        </view>
      </view>
      <input class="text-input" placeholder="A08 桌 / 到店取餐" value="{{tableNo}}" bindinput="onTableInput" />
    </view>

    <view class="section-card">
      <view class="section-head compact-head">
        <view>
          <view class="section-title">备注</view>
          <view class="section-note">会随订单备注提交保存</view>
        </view>
      </view>
      <textarea class="text-area" placeholder="少冰、不要吸管、尽快出餐" value="{{remark}}" bindinput="onRemarkInput" />
    </view>

    <view class="section-card">
      <view class="section-head compact-head">
        <view>
          <view class="section-title">金额明细</view>
          <view class="section-note">金额可根据优惠券切换</view>
        </view>
      </view>
      <view class="summary-list">
        <view class="summary-row"><text>商品总价</text><text>{{cart.totalText}}</text></view>
        <view class="summary-row"><text>优惠金额</text><text class="discount-price">- {{discountText}}</text></view>
        <view class="summary-row total-row"><text>实付金额</text><text class="accent-price">{{payableText}}</text></view>
      </view>
    </view>
  </view>

  <view class="floating-bar submit-bar">
    <view class="floating-summary">
      <text class="floating-label">待支付</text>
      <text class="floating-price">{{payableText}}</text>
      <text class="floating-label">提交后生成取餐订单</text>
    </view>
    <button class="button button-primary" bindtap="submitOrder">提交订单</button>
  </view>

  <view class="bottom-nav">
    <navigator class="nav-item" url="/pages/home/index" open-type="redirect"><view class="nav-icon"><image class="nav-logo-icon" src="/images/nav-home.svg" mode="aspectFit" /></view><text>首页</text></navigator>
    <navigator class="nav-item" url="/pages/menu/index" open-type="redirect"><view class="nav-icon"><image class="nav-logo-icon" src="/images/nav-menu.svg" mode="aspectFit" /></view><text>点餐</text></navigator>
    <navigator class="nav-item" url="/pages/saving-card/index" open-type="redirect"><view class="nav-icon"><image class="nav-logo-icon" src="/images/nav-saving.svg" mode="aspectFit" /></view><text>省钱卡</text></navigator>
    <navigator class="nav-item" url="/pages/order/index" open-type="redirect"><view class="nav-icon"><image class="nav-logo-icon" src="/images/nav-order.svg" mode="aspectFit" /></view><text>订单</text></navigator>
    <navigator class="nav-item" url="/pages/mine/index" open-type="redirect"><view class="nav-icon"><image class="nav-logo-icon" src="/images/nav-mine.svg" mode="aspectFit" /></view><text>我的</text></navigator>
  </view>
</view>
