.support-shell {
  height: 100vh;
  overflow: hidden;
  box-sizing: border-box;
  color: #102033;
  background:
    radial-gradient(circle at 18% -4%, rgba(31, 111, 255, 0.14), rgba(31, 111, 255, 0) 34%),
    linear-gradient(180deg, #f8fbff 0%, #eef5ff 380rpx, #f4f8ff 100%);
}

.support-tap {
  opacity: 0.72;
  transform: scale(0.97);
}

.support-top {
  position: sticky;
  top: 0;
  z-index: 40;
  display: grid;
  grid-template-columns: 88rpx minmax(0, 1fr) 104rpx;
  align-items: center;
  gap: 12rpx;
  min-height: 104rpx;
  padding: 12rpx 24rpx 10rpx;
  border-bottom: 1rpx solid rgba(219, 231, 246, 0.88);
  background: rgba(248, 251, 255, 0.97);
  box-shadow: 0 8rpx 20rpx rgba(31, 111, 255, 0.045);
}

.support-back,
.support-top-link {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  border-radius: 999rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 20rpx rgba(31, 111, 255, 0.07);
}

.support-back {
  width: 88rpx;
  color: #071a44;
  font-size: 50rpx;
  line-height: 1;
}

.support-top-link {
  color: #1f6fff;
  font-size: 23rpx;
  font-weight: 900;
}

.support-title-group {
  min-width: 0;
  text-align: center;
}

.support-title {
  display: block;
  color: #071a44;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.2;
}

.support-title-sub {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  margin-top: 4rpx;
  color: #24b47e;
  font-size: 21rpx;
  font-weight: 800;
}

.online-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #24b47e;
  box-shadow: 0 0 0 8rpx rgba(36, 180, 126, 0.12);
}

.support-chat-main {
  display: flex;
  flex-direction: column;
  height: calc(100vh - 192rpx);
  min-height: 0;
  padding: 16rpx 20rpx 0;
  box-sizing: border-box;
  overflow: hidden;
}

.support-chat-head {
  position: relative;
  display: grid;
  grid-template-columns: 64rpx minmax(0, 1fr) auto;
  align-items: center;
  flex: 0 0 auto;
  gap: 12rpx;
  padding: 16rpx;
  border: 1rpx solid rgba(31, 111, 255, 0.12);
  border-radius: 24rpx;
  background: linear-gradient(135deg, #ffffff 0%, #edf6ff 100%);
  box-shadow: 0 10rpx 26rpx rgba(31, 111, 255, 0.075);
}

.support-chat-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  background: #eaf3ff;
}

.support-card-title {
  display: block;
  color: #071a44;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.25;
}

.support-card-sub {
  margin-top: 4rpx;
  color: #64748b;
  font-size: 20rpx;
  line-height: 1.42;
}

.support-service-status {
  min-height: 48rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  color: #0b63d8;
  font-size: 21rpx;
  font-weight: 900;
  line-height: 48rpx;
  background: #e7f1ff;
}

.support-official-badge {
  display: none;
  position: absolute;
  right: 20rpx;
  bottom: -18rpx;
  padding: 6rpx 16rpx;
  border: 1rpx solid #dbe7f6;
  border-radius: 999rpx;
  color: #1f6fff;
  font-size: 20rpx;
  font-weight: 900;
  background: #ffffff;
  box-shadow: 0 8rpx 18rpx rgba(31, 111, 255, 0.06);
}

.support-chat-panel {
  flex: 1;
  height: 0;
  min-height: 0;
  margin-top: 16rpx;
  padding: 0 2rpx 188rpx;
  box-sizing: border-box;
}

.support-chat-panel.is-tools-open {
  padding-bottom: 388rpx;
}

.support-date-divider {
  width: 92rpx;
  margin: 0 auto 18rpx;
  padding: 8rpx 0;
  border-radius: 999rpx;
  color: #7a8aa0;
  font-size: 22rpx;
  font-weight: 800;
  text-align: center;
  background: rgba(255, 255, 255, 0.78);
}

.support-bot-thread,
.support-chat-list,
.support-inline-thread {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.support-inline-thread {
  margin-top: 14rpx;
}

.support-chat-item {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.support-bubble-row {
  display: flex;
  gap: 10rpx;
}

.support-bubble-row.is-user {
  justify-content: flex-end;
}

.support-bubble-row.is-service {
  align-items: flex-start;
  justify-content: flex-start;
}

.service-avatar {
  flex: 0 0 auto;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #eaf3ff;
}

.support-bubble {
  max-width: 80%;
  padding: 16rpx 18rpx;
  border: 1rpx solid rgba(219, 231, 246, 0.95);
  border-radius: 26rpx;
  color: #102033;
  background: #ffffff;
  box-shadow: 0 6rpx 18rpx rgba(31, 111, 255, 0.055);
}

.is-user .support-bubble {
  color: #ffffff;
  border-color: transparent;
  border-bottom-right-radius: 10rpx;
  background: linear-gradient(135deg, #2f80ff 0%, #1f6fff 100%);
}

.is-service .support-bubble {
  border-bottom-left-radius: 10rpx;
}

.support-bot-bubble {
  max-width: calc(100% - 72rpx);
}

.support-bubble.pending {
  border-color: #fed7aa;
  background: #fff7ed;
}

.support-bubble.replied {
  border-color: #bbf7d0;
  background: #f0fdf4;
}

.support-bubble.closed {
  opacity: 0.78;
}

.bubble-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  color: #1f6fff;
  font-size: 23rpx;
  font-weight: 900;
}

.bubble-pill {
  padding: 5rpx 12rpx;
  border-radius: 999rpx;
  color: #24b47e;
  font-size: 20rpx;
  background: rgba(36, 180, 126, 0.1);
}

.bubble-content {
  display: block;
  margin-top: 8rpx;
  color: inherit;
  font-size: 26rpx;
  line-height: 1.5;
  white-space: pre-wrap;
}

.support-service-card {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  margin-top: 12rpx;
  padding: 14rpx;
  border: 1rpx solid #dce8f8;
  border-radius: 20rpx;
  background: #f6faff;
}

.service-card-title {
  color: #0f172a;
  font-size: 24rpx;
  font-weight: 900;
}

.service-card-desc {
  color: #64748b;
  font-size: 22rpx;
  line-height: 1.45;
}

.bot-action-row {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 8rpx;
  margin-top: 12rpx;
}

.bot-action-btn {
  min-height: 72rpx;
  margin: 0;
  padding: 0 12rpx;
  border: 1rpx solid #d2e2f6;
  border-radius: 18rpx;
  color: #1f6fff;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 72rpx;
  background: #ffffff;
}

.bot-action-btn::after,
.composer-more-btn::after,
.support-submit::after {
  border: 0;
}

.bot-action-btn.is-primary {
  grid-column: 1 / -1;
  color: #ffffff;
  border-color: transparent;
  background: linear-gradient(135deg, #2f80ff 0%, #1f6fff 100%);
}

.message-footer {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 12rpx;
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 21rpx;
}

.message-receipt {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-weight: 900;
}

.message-receipt::before {
  content: "";
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: currentColor;
}

.message-receipt.is-read {
  color: rgba(255, 255, 255, 0.88);
}

.message-receipt.is-unread {
  color: #ffe08a;
}

.service-time {
  margin-top: 8rpx;
  color: #94a3b8;
  font-size: 21rpx;
  text-align: right;
}

.support-loading,
.support-empty {
  margin-left: 74rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid #dbe7f6;
  border-radius: 22rpx;
  color: #75839a;
  font-size: 23rpx;
  text-align: left;
  background: rgba(255, 255, 255, 0.82);
}

.empty-title {
  display: block;
  margin-bottom: 6rpx;
  color: #0f172a;
  font-size: 25rpx;
  font-weight: 900;
}

.empty-sub {
  color: #64748b;
  font-size: 22rpx;
  line-height: 1.5;
}

.support-composer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 120;
  padding: 12rpx 20rpx calc(12rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  border-top: 1rpx solid rgba(219, 231, 246, 0.95);
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 -8rpx 24rpx rgba(15, 23, 42, 0.065);
}

.composer-tools {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10rpx;
  margin-bottom: 10rpx;
  padding: 14rpx;
  border: 1rpx solid #dbe7f6;
  border-radius: 24rpx;
  background: #f7fbff;
}

.composer-tool-title {
  grid-column: 1 / -1;
  color: #64748b;
  font-size: 24rpx;
  font-weight: 800;
}

.composer-tools .support-input {
  grid-column: 1 / -1;
}

.picker-value,
.support-input {
  min-height: 88rpx;
  padding: 0 20rpx;
  border: 1rpx solid #d2e2f6;
  border-radius: 999rpx;
  color: #102033;
  font-size: 24rpx;
  line-height: 88rpx;
  background: #ffffff;
}

.composer-input-row {
  display: grid;
  grid-template-columns: 72rpx minmax(0, 1fr) 112rpx;
  align-items: center;
  gap: 10rpx;
}

.composer-more-btn {
  width: 72rpx;
  height: 72rpx;
  margin: 0;
  padding: 0;
  border-radius: 50%;
  color: #1f6fff;
  font-size: 38rpx;
  font-weight: 800;
  line-height: 72rpx;
  background: #eaf3ff;
}

.composer-more-btn.is-open {
  color: #ffffff;
  background: #1f6fff;
}

.support-textarea {
  display: block;
  width: 100%;
  min-width: 0;
  height: 72rpx;
  min-height: 72rpx;
  padding: 0 22rpx;
  border: 1rpx solid #d2e2f6;
  border-radius: 24rpx;
  box-sizing: border-box;
  color: #102033;
  font-size: 27rpx;
  line-height: 72rpx;
  background: #f7fbff;
}

.support-submit {
  width: 112rpx;
  min-height: 72rpx;
  margin: 0;
  padding: 0;
  border-radius: 999rpx;
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 72rpx;
  background: linear-gradient(135deg, #2f80ff 0%, #1f6fff 100%);
}

.support-bottom-anchor {
  height: 1rpx;
}

/* H5 parity pass: compact ecommerce chat layout and safe fixed composer. */
.support-top {
  min-height: 176rpx;
  padding: 88rpx 20rpx 14rpx !important;
  box-sizing: border-box;
}

.support-chat-main {
  height: calc(100vh - 176rpx);
  padding: 16rpx 20rpx 0;
}

.support-chat-head {
  gap: 16rpx;
  padding: 20rpx;
  border-radius: 32rpx;
  box-shadow: 0 10rpx 28rpx rgba(31, 111, 255, 0.08);
}

.support-chat-avatar,
.service-avatar {
  width: 64rpx;
  height: 64rpx;
}

.support-card-title {
  font-size: 28rpx;
  line-height: 1.25;
}

.support-card-sub {
  font-size: 22rpx;
}

.support-service-status {
  min-height: 44rpx;
  padding: 0 16rpx;
  font-size: 22rpx;
  line-height: 44rpx;
}

.support-chat-panel {
  margin-top: 16rpx;
  padding-bottom: 220rpx;
}

.support-chat-panel.is-tools-open {
  padding-bottom: 400rpx;
}

.support-bubble {
  max-width: 76%;
  padding: 18rpx 20rpx;
  border-radius: 30rpx;
}

.support-bot-bubble {
  max-width: calc(100% - 76rpx);
}

.bot-action-row {
  gap: 12rpx;
}

.bot-action-btn {
  min-height: 76rpx;
  border-radius: 32rpx;
  line-height: 76rpx;
}

.support-composer {
  z-index: 120;
  padding: 14rpx 20rpx calc(14rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -16rpx 40rpx rgba(15, 23, 42, 0.07);
}

.composer-tools {
  gap: 12rpx;
  margin-bottom: 12rpx;
  padding: 16rpx;
  border-radius: 32rpx;
}

.composer-input-row {
  grid-template-columns: 80rpx minmax(0, 1fr) 132rpx;
  gap: 14rpx;
}

.composer-more-btn {
  width: 80rpx;
  height: 80rpx;
  line-height: 80rpx;
}

.support-textarea {
  height: 80rpx;
  min-height: 80rpx;
  padding: 0 22rpx;
  border-radius: 36rpx;
  font-size: 28rpx;
  line-height: 80rpx;
  background: #f8fbff;
}

.support-submit {
  width: 132rpx;
  min-height: 80rpx;
  font-size: 28rpx;
  line-height: 80rpx;
}

/* Final chat composer polish: make the bottom area feel like a real ecommerce IM input. */
.support-chat-panel {
  padding-bottom: 176rpx;
}

.support-chat-panel.is-tools-open {
  padding-bottom: 340rpx;
}

.support-composer {
  padding: 10rpx 18rpx calc(10rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid rgba(219, 231, 246, 0.72);
  background: rgba(255, 255, 255, 0.985);
  box-shadow: 0 -10rpx 28rpx rgba(15, 23, 42, 0.06);
}

.composer-tools {
  gap: 10rpx;
  margin-bottom: 10rpx;
  padding: 14rpx;
  border-radius: 28rpx;
  background: #f7fbff;
}

.composer-tool-title {
  font-size: 22rpx;
}

.picker-value,
.support-input {
  min-height: 72rpx;
  padding: 0 18rpx;
  font-size: 23rpx;
  line-height: 72rpx;
}

.composer-input-row {
  grid-template-columns: 64rpx minmax(0, 1fr) 108rpx;
  gap: 10rpx;
  align-items: center;
  min-height: 76rpx;
  padding: 6rpx;
  border: 1rpx solid #dbe7f6;
  border-radius: 999rpx;
  background: #f7fbff;
}

.composer-more-btn {
  width: 64rpx;
  height: 64rpx;
  color: #1f6fff;
  font-size: 34rpx;
  line-height: 64rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(31, 111, 255, 0.08);
}

.composer-more-btn.is-open {
  color: #ffffff;
  background: #1f6fff;
}

.support-textarea {
  height: 64rpx;
  min-height: 64rpx;
  padding: 0 8rpx;
  border: 0;
  border-radius: 0;
  font-size: 27rpx;
  line-height: 64rpx;
  background: transparent;
}

.support-submit {
  width: 108rpx;
  min-height: 64rpx;
  color: #ffffff;
  font-size: 25rpx;
  line-height: 64rpx;
  background: #b9d5ff;
  box-shadow: none;
}

.support-submit.is-ready {
  background: linear-gradient(135deg, #2f80ff 0%, #1f6fff 100%);
  box-shadow: 0 8rpx 18rpx rgba(31, 111, 255, 0.18);
}

/* Chat composer correction: separate circular plus, input, and send button. */
.composer-input-row {
  grid-template-columns: 72rpx minmax(0, 1fr) 108rpx;
  gap: 12rpx;
  min-height: 76rpx;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
}

.composer-more-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  min-height: 72rpx;
  padding: 0 !important;
  border: 1rpx solid #dbe7f6;
  border-radius: 50%;
  box-sizing: border-box;
  font-size: 38rpx;
  line-height: 1;
  background: #ffffff;
}

.support-textarea {
  height: 72rpx;
  min-height: 72rpx;
  padding: 0 24rpx;
  border: 1rpx solid #dbe7f6;
  border-radius: 999rpx;
  box-sizing: border-box;
  font-size: 26rpx;
  line-height: 72rpx;
  background: #f7fbff;
}

.support-submit {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 108rpx;
  min-height: 72rpx;
  padding: 0 !important;
  box-sizing: border-box;
  font-size: 25rpx;
  line-height: 1;
}

/* Final support composer hard guard: WeChat button has default min-width, so lock it. */
.support-composer {
  left: 0;
  right: 0;
  width: 100vw;
  max-width: 100vw;
  overflow: hidden;
}

.composer-input-row {
  display: flex;
  align-items: center;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
}

.composer-more-btn {
  flex: 0 0 72rpx !important;
  min-width: 72rpx !important;
  max-width: 72rpx !important;
  margin: 0 !important;
}

.support-textarea {
  flex: 1 1 auto;
  min-width: 0;
}

.support-submit {
  flex: 0 0 108rpx !important;
  min-width: 108rpx !important;
  max-width: 108rpx !important;
  margin: 0 !important;
}
