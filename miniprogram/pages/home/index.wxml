<view class="home-shell">

  <view class="home-topbar">
    <view class="ht-capsule">
      <view class="ht-cap-btn"><text class="ht-icon-dots">···</text></view>
      <view class="ht-cap-sep"></view>
      <view class="ht-cap-btn"><text class="ht-icon-loc">⊙</text></view>
    </view>
  </view>

  <swiper class="carousel" autoplay="true" interval="5000" duration="500" circular="true" current="{{slideIdx}}" bindchange="onSlide" indicator-dots="false">

    <swiper-item class="c-slide">
      <image class="c-banner-img" src="/images/home-banner-1.png" mode="aspectFill"/>
    </swiper-item>

    <swiper-item class="c-slide">
      <image class="c-banner-img" src="/images/home-banner-2.png" mode="aspectFill"/>
    </swiper-item>

    <swiper-item class="c-slide">
      <image class="c-banner-img" src="/images/home-banner-3.png" mode="aspectFill"/>
    </swiper-item>

  </swiper>

  <view class="c-indicators">
    <view class="c-dot {{slideIdx === 0 ? 'is-active' : ''}}"></view>
    <view class="c-dot {{slideIdx === 1 ? 'is-active' : ''}}"></view>
    <view class="c-dot {{slideIdx === 2 ? 'is-active' : ''}}"></view>
  </view>

  <view class="c-disclaim">*图片仅供参考,实际以出杯为准</view>

  <view class="content-overlay">

    <view class="member-progress-card">
      <view class="mpc-avatar">
        <text class="mpc-avatar-icon">👤</text>
      </view>
      <view class="mpc-body">
        <text class="mpc-name">爱嫩仙草满福的...</text>
        <view class="mpc-row">
          <view class="mpc-progress">
            <view class="mpc-progress-bg">
              <view class="mpc-progress-fill" style="width: 33%"></view>
            </view>
            <text class="mpc-count">1/3杯</text>
          </view>
          <view class="mpc-btn" bindtap="goPickup">去领取</view>
        </view>
      </view>
    </view>

    <view class="home-divider"></view>

    <view class="pickup-split">
      <view class="ps-side" data-mode="pickup" bindtap="chooseMode">
        <text class="ps-zh">自取</text>
        <text class="ps-en">Pickup</text>
      </view>
      <view class="ps-divider"></view>
      <view class="ps-side" data-mode="delivery" bindtap="chooseMode">
        <view class="ps-bubble"><text>最高享免配!</text></view>
        <text class="ps-zh">外卖</text>
        <text class="ps-en">Deliver</text>
      </view>
    </view>

    <view class="home-divider"></view>

    <view class="quick-grid">
      <navigator class="qg-item" url="/pages/menu/index" open-type="redirect">
        <view class="qg-icon qg-icon-99">
          <text class="qg-99-num">9.9</text>
          <text class="qg-99-tag">喝咖啡</text>
        </view>
        <text class="qg-h">高品质咖啡</text>
        <text class="qg-sub">全场9.9</text>
      </navigator>
      <navigator class="qg-item" url="/pages/saving-card/index" open-type="redirect">
        <view class="qg-icon qg-icon-30">
          <text class="qg-30-num">领30元</text>
          <text class="qg-30-tag">券</text>
        </view>
        <text class="qg-h">领30元券包</text>
        <text class="qg-sub">加入社群</text>
      </navigator>
      <navigator class="qg-item" url="/pages/mine/index" open-type="redirect">
        <view class="qg-icon qg-icon-points">
          <text class="qg-points-icon">🎁</text>
        </view>
        <text class="qg-h">积分兑换</text>
        <text class="qg-sub">专享福利</text>
      </navigator>
      <navigator class="qg-item" url="/pages/saving-card/index" open-type="redirect">
        <view class="qg-icon qg-icon-code">
          <text class="qg-code-icon">🎟</text>
        </view>
        <text class="qg-h">券码兑换</text>
        <text class="qg-sub">立享优惠</text>
      </navigator>
    </view>
  </view>

  <view class="bottom-nav home-bottom-nav">
    <navigator class="nav-item is-active" url="/pages/home/index" open-type="redirect"><view class="nav-icon"><image class="nav-logo-icon" src="/images/nav-home.svg" mode="aspectFit"/></view><text>首页</text></navigator>
    <navigator class="nav-item" url="/pages/menu/index" open-type="redirect"><view class="nav-icon"><image class="nav-logo-icon" src="/images/nav-menu.svg" mode="aspectFit"/></view><text>点餐</text></navigator>
    <navigator class="nav-item" url="/pages/saving-card/index" open-type="redirect"><view class="nav-icon"><image class="nav-logo-icon" src="/images/nav-saving.svg" mode="aspectFit"/></view><text>省钱卡</text></navigator>
    <navigator class="nav-item" url="/pages/order/index" open-type="redirect"><view class="nav-icon"><image class="nav-logo-icon" src="/images/nav-order.svg" mode="aspectFit"/></view><text>订单</text></navigator>
    <navigator class="nav-item" url="/pages/mine/index" open-type="redirect"><view class="nav-icon"><image class="nav-logo-icon" src="/images/nav-mine.svg" mode="aspectFit"/></view><text>我的</text></navigator>
  </view>
</view>
