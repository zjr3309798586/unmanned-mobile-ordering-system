<view class="page home-page">
  <view class="hero">
    <view>
      <text class="hero-badge">限时活动</text>
      <view class="hero-title">
        <view>今日鲜果饮</view>
        <view>第二杯半价</view>
      </view>
      <view class="hero-text">新人下单可领优惠券，支持到店自取和平台外送。</view>
      <view class="hero-actions">
        <button class="button primary" bindtap="goMenu">去点餐</button>
        <button class="button secondary" bindtap="goSavingCard">领优惠</button>
      </view>
    </view>
  </view>

  <view class="card" wx:if="{{store}}">
    <view class="row">
      <view>
        <text class="tag blue">当前门店</text>
        <view class="title mt">{{store.name}}</view>
      </view>
      <text class="tag">营业中</text>
    </view>
    <view class="muted mt">{{store.distance}} · 营业 {{store.businessHours}}</view>
    <view class="muted">{{store.address}}</view>
  </view>

  <view class="search">
    <text>搜</text>
    <input placeholder="搜索饮品、小食、套餐" value="{{keyword}}" bindinput="onKeywordInput" confirm-type="search" bindconfirm="goMenu" />
  </view>

  <view class="service-grid">
    <view class="service-card active">
      <text class="service-icon">取</text>
      <view class="section-title">到店自取</view>
      <view class="muted">提前下单，到店凭订单取餐。</view>
    </view>
    <view class="service-card">
      <text class="service-icon">送</text>
      <view class="section-title">平台外送</view>
      <view class="muted">适合办公室和宿舍场景。</view>
    </view>
  </view>

  <view class="card">
    <view class="row">
      <view class="section-title">热门推荐</view>
      <text class="muted" bindtap="goMenu">查看全部</text>
    </view>
    <view class="product-list">
      <view class="product-card" wx:for="{{products}}" wx:key="id" data-id="{{item.id}}" bindtap="goDetail">
        <image class="product-img" src="{{item.imageUrl}}" mode="aspectFill" />
        <view class="product-info">
          <view class="tag-row">
            <text class="tag" wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this">{{tag}}</text>
          </view>
          <view class="product-name">{{item.name}}</view>
          <view class="product-desc">{{item.description}}</view>
          <view class="row mt">
            <text class="price">{{item.priceText}}</text>
            <text class="muted">查看详情</text>
          </view>
        </view>
      </view>
      <view class="empty" wx:if="{{products.length === 0}}">
        <view class="empty-title">暂无推荐商品</view>
      </view>
    </view>
  </view>

  <view class="coupon-grid">
    <view class="coupon-card" wx:for="{{coupons}}" wx:key="id">
      <view class="section-title">{{item.title}}</view>
      <view class="muted">{{item.conditionText}} · 最高减 {{item.discountText}}</view>
    </view>
  </view>

  <view class="card">
    <view class="section-title">门店公告</view>
    <view class="muted mt">{{notice}}</view>
  </view>
</view>
