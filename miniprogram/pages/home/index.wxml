<view class="home-shell">

  <view class="home-topbar">
    <view class="ht-capsule">
      <view class="ht-cap-btn" aria-label="更多">
        <view class="ht-dots"><view></view><view></view><view></view></view>
      </view>
      <view class="ht-cap-sep"></view>
      <view class="ht-cap-btn" aria-label="位置">
        <view class="ht-loc"><view class="ht-loc-core"></view></view>
      </view>
    </view>
  </view>

  <swiper class="carousel" autoplay="true" interval="5000" duration="500" circular="true" current="{{slideIdx}}" bindchange="onSlide" indicator-dots="false">

    <swiper-item class="c-slide" wx:for="{{slides}}" wx:key="id" data-url="{{item.linkUrl}}" bindtap="openSlide">
      <image class="c-banner-img" src="{{item.image}}" mode="aspectFill"/>
      <view class="c-banner-caption" wx:if="{{item.title || item.subtitle}}">
        <text class="c-banner-title">{{item.title}}</text>
        <text class="c-banner-subtitle">{{item.subtitle}}</text>
      </view>
    </swiper-item>

  </swiper>

  <view class="c-indicators">
    <view class="c-dot {{slideIdx === index ? 'is-active' : ''}}" wx:for="{{slides}}" wx:key="id"></view>
  </view>

  <view class="c-disclaim">*图片仅供参考,实际以出杯为准</view>

  <view class="content-overlay">

    <view class="member-progress-card">
      <view class="mpc-avatar">
        <view class="mpc-avatar-icon">
          <view class="mpc-avatar-head"></view>
          <view class="mpc-avatar-body"></view>
        </view>
      </view>
      <view class="mpc-body">
        <text class="mpc-name">爱嫩仙草满福的...</text>
        <view class="mpc-row">
          <view class="mpc-progress">
            <view class="mpc-progress-bg">
              <view class="mpc-progress-fill" style="width: 33%"></view>
            </view>
            <text class="mpc-count">1/3杯</text>
          </view>
          <view class="mpc-btn" bindtap="goPickup">去领取</view>
        </view>
      </view>
    </view>

    <view class="home-divider"></view>

    <view class="pickup-split">
      <view class="ps-side" data-mode="pickup" bindtap="chooseMode">
        <text class="ps-zh">自取</text>
        <text class="ps-en">Pickup</text>
      </view>
      <view class="ps-divider"></view>
      <view class="ps-side" data-mode="delivery" bindtap="chooseMode">
        <view class="ps-bubble"><text>最高享免配!</text></view>
        <text class="ps-zh">外卖</text>
        <text class="ps-en">Deliver</text>
      </view>
    </view>

    <view class="home-divider"></view>

    <view class="quick-grid">
      <navigator class="qg-item" url="/pages/menu/index" open-type="reLaunch">
        <view class="qg-icon qg-icon-99">
          <text class="qg-99-num">9.9</text>
          <text class="qg-99-tag">喝咖啡</text>
        </view>
        <text class="qg-h">高品质咖啡</text>
        <text class="qg-sub">全场9.9</text>
      </navigator>
      <navigator class="qg-item" url="/pages/saving-card/index" open-type="reLaunch">
        <view class="qg-icon qg-icon-30">
          <text class="qg-30-num">领30元</text>
          <text class="qg-30-tag">券</text>
        </view>
        <text class="qg-h">领30元券包</text>
        <text class="qg-sub">加入社群</text>
      </navigator>
      <navigator class="qg-item" url="/pages/saving-card/index" open-type="reLaunch">
        <view class="qg-icon qg-icon-coupon">
          <view class="qg-coupon-shape">
            <view class="qg-coupon-box"></view>
            <view class="qg-coupon-dot"></view>
          </view>
        </view>
        <text class="qg-h">领券中心</text>
        <text class="qg-sub">专享福利</text>
      </navigator>
      <navigator class="qg-item" url="/pages/saving-card/index" open-type="reLaunch">
        <view class="qg-icon qg-icon-code">
          <view class="qg-code-shape">
            <view class="qg-code-line"></view>
          </view>
        </view>
        <text class="qg-h">券码兑换</text>
        <text class="qg-sub">立享优惠</text>
      </navigator>
    </view>

    <view class="home-recommend">
      <view class="home-section-head">
        <view>
          <text class="home-eyebrow">Popular</text>
          <text class="home-section-title">热门推荐</text>
        </view>
        <navigator class="home-section-more" url="/pages/menu/index" open-type="reLaunch">查看全部</navigator>
      </view>
      <scroll-view class="home-product-row" scroll-x="true" show-scrollbar="false">
        <navigator class="home-product-card" wx:for="{{recommendProducts}}" wx:key="id" url="/pages/detail/index?id={{item.id}}" open-type="navigate">
          <image src="{{item.imageUrl}}" mode="aspectFit"/>
          <text class="home-product-tag">{{item.tag}}</text>
          <text class="home-product-name">{{item.name}}</text>
          <text class="home-product-desc">{{item.description}}</text>
          <text class="home-product-price">¥{{item.priceText}}</text>
        </navigator>
      </scroll-view>
    </view>

    <view class="home-notice-card">
      <view class="home-notice-icon">
        <image src="/images/icons/notice-speaker.svg" mode="aspectFit"></image>
      </view>
      <view class="home-notice-main">
        <text class="home-notice-title">门店公告</text>
        <text class="home-notice-text">{{store.notice}}</text>
      </view>
    </view>
  </view>

  <view class="bottom-nav home-bottom-nav">
    <navigator class="nav-item is-active" url="/pages/home/index" open-type="reLaunch"><view class="nav-icon"><image class="nav-logo-icon" src="/images/nav/nav-home.svg" mode="aspectFit"/></view><text>首页</text></navigator>
    <navigator class="nav-item" url="/pages/menu/index" open-type="reLaunch"><view class="nav-icon"><image class="nav-logo-icon" src="/images/nav/nav-menu.svg" mode="aspectFit"/></view><text>点餐</text></navigator>
    <navigator class="nav-item" url="/pages/saving-card/index" open-type="reLaunch"><view class="nav-icon"><image class="nav-logo-icon" src="/images/nav/nav-saving.svg" mode="aspectFit"/></view><text>省钱卡</text></navigator>
    <navigator class="nav-item" url="/pages/order/index" open-type="reLaunch"><view class="nav-icon"><image class="nav-logo-icon" src="/images/nav/nav-order.svg" mode="aspectFit"/></view><text>订单</text></navigator>
    <navigator class="nav-item" url="/pages/mine/index" open-type="reLaunch"><view class="nav-icon"><image class="nav-logo-icon" src="/images/nav/nav-mine.svg" mode="aspectFit"/></view><text>我的</text></navigator>
  </view>
</view>
