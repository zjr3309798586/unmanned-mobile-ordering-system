<view class="app-shell">
  <view class="home-shop-header">
    <view class="home-store-bar" wx:if="{{store}}">
      <view>
        <text class="store-label">当前门店</text>
        <view class="store-name">{{store.name}}</view>
      </view>
      <text class="status-pill is-open">营业中</text>
    </view>

    <view class="search-bar home-search">
      <text class="search-icon">搜</text>
      <input class="search-input" placeholder="搜索奶茶、果茶、咖啡、小食" value="{{keyword}}" bindinput="onKeywordInput" confirm-type="search" bindconfirm="goMenu" />
    </view>
  </view>

  <view class="page-main home-main">
    <view class="home-banner home-hero-card">
      <view class="banner-content">
        <text class="hero-badge">{{bannerTag}}</text>
        <view class="banner-title">
          <view wx:for="{{bannerTitleLines}}" wx:key="*this">{{item}}</view>
        </view>
        <view class="banner-text">{{bannerText}}</view>
        <view class="hero-actions">
          <button class="button button-primary" bindtap="goMenu">{{bannerActionText}}</button>
        </view>
      </view>
      <view class="banner-visual">
        <image class="banner-image" src="/images/product-orange-coffee.svg" mode="aspectFill" />
        <image class="banner-side-image" src="/images/mascot-yunbao-144.png" mode="aspectFill" />
      </view>
    </view>

    <view class="order-mode-panel">
      <view class="order-mode-card is-active" bindtap="goMenu">
        <text class="mode-icon">取</text>
        <view>
          <text class="mode-title">门店自取</text>
          <text class="mode-copy">提前下单，到店即取</text>
        </view>
      </view>
      <view class="order-mode-card" bindtap="goMenu">
        <text class="mode-icon">送</text>
        <view>
          <text class="mode-title">平台外送</text>
          <text class="mode-copy">宿舍 / 办公室配送</text>
        </view>
      </view>
    </view>

    <view class="quick-strip">
      <navigator url="/pages/saving-card/index" open-type="redirect"><text>券</text><text>领券中心</text></navigator>
      <navigator url="/pages/saving-card/index" open-type="redirect"><text>卡</text><text>省钱卡</text></navigator>
      <navigator url="/pages/order/index" open-type="redirect"><text>单</text><text>我的订单</text></navigator>
      <navigator url="/pages/cart/index" open-type="redirect"><text>车</text><text>购物车</text></navigator>
    </view>

    <view class="coupon-ribbon" bindtap="goSavingCard">
      <view>
        <text class="ribbon-kicker">今日优惠</text>
        <text class="ribbon-title">{{couponTitle}}</text>
        <text class="ribbon-copy">{{couponCopy}}</text>
      </view>
      <text class="ribbon-action">{{couponActionText}}</text>
    </view>

    <view class="section-card hot-section">
      <view class="section-head">
        <view>
          <view class="section-title">本店热卖</view>
          <view class="section-note">按销量优先推荐，点击可查看详情</view>
        </view>
        <text class="section-link" bindtap="goMenu">全部</text>
      </view>
      <scroll-view class="product-stack home-product-scroll" scroll-x="true">
        <view class="product-card home-product-card" wx:for="{{products}}" wx:key="id" data-id="{{item.id}}" bindtap="goDetail">
          <view class="home-product-cover">
            <image class="cover-thumb" src="{{item.imageUrl}}" mode="aspectFill" />
            <text class="rank-badge">热卖 {{index + 1}}</text>
          </view>
          <view class="product-body">
            <view class="product-name">{{item.name}}</view>
            <view class="product-desc">{{item.description}}</view>
            <view class="price-line">
              <text class="price">{{item.priceText}}</text>
              <text class="mini-link product-buy-link">去选购</text>
            </view>
          </view>
        </view>
        <view class="section-note" wx:if="{{products.length === 0}}">暂无推荐商品。</view>
      </scroll-view>
    </view>

    <view class="section-card task-card">
      <view class="section-head compact-head">
        <view>
          <view class="section-title">集杯任务</view>
          <view class="section-note">{{taskNote}}</view>
        </view>
        <navigator class="section-link" url="/pages/saving-card/index" open-type="redirect">查看</navigator>
      </view>
      <view class="task-progress">
        <view class="progress-track"><view class="progress-fill" style="width: {{taskProgressWidth}}%;"></view></view>
        <view class="task-footnote">{{taskFootnote}}</view>
      </view>
    </view>

    <view class="section-card notice-card">
      <view class="section-head compact-head">
        <view>
          <view class="section-title">门店公告</view>
          <view class="section-note">当前门店通知</view>
        </view>
      </view>
      <view class="announcement-list">
        <view class="info-row">
          <view>
            <view class="info-title">门店公告</view>
            <view class="info-text">{{notice}}</view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="bottom-nav">
    <navigator class="nav-item is-active" url="/pages/home/index" open-type="redirect"><view class="nav-icon"><image class="nav-logo-icon" src="/images/nav-home.svg" mode="aspectFit" /></view><text>首页</text></navigator>
    <navigator class="nav-item" url="/pages/menu/index" open-type="redirect"><view class="nav-icon"><image class="nav-logo-icon" src="/images/nav-menu.svg" mode="aspectFit" /></view><text>点餐</text></navigator>
    <navigator class="nav-item" url="/pages/saving-card/index" open-type="redirect"><view class="nav-icon"><image class="nav-logo-icon" src="/images/nav-saving.svg" mode="aspectFit" /></view><text>省钱卡</text></navigator>
    <navigator class="nav-item" url="/pages/order/index" open-type="redirect"><view class="nav-icon"><image class="nav-logo-icon" src="/images/nav-order.svg" mode="aspectFit" /></view><text>订单</text></navigator>
    <navigator class="nav-item" url="/pages/mine/index" open-type="redirect"><view class="nav-icon"><image class="nav-logo-icon" src="/images/nav-mine.svg" mode="aspectFit" /></view><text>我的</text></navigator>
  </view>
</view>
