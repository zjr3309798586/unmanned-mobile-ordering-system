.home-shop-header {
  position: relative;
  z-index: 8;
  padding: 24rpx 24rpx 20rpx;
  background: rgba(244, 246, 250, 0.96);
}

.home-store-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.home-store-bar .store-label {
  min-height: auto;
  padding: 0;
  color: #6d7788;
  font-size: 22rpx;
  background: transparent;
}

.home-store-bar .store-name {
  margin-top: 6rpx;
  font-size: 38rpx;
  font-weight: 900;
}

.home-search {
  margin-top: 20rpx;
  border: 0;
  border-radius: 999rpx;
  background: #ffffff;
  box-shadow: none;
}

.home-main {
  padding-top: 0;
}

.home-hero-card {
  position: relative;
  display: grid;
  grid-template-columns: minmax(0, 1fr) 288rpx;
  min-height: 348rpx;
  margin-top: 4rpx;
  padding: 34rpx 28rpx 28rpx;
  border-radius: 40rpx;
  overflow: hidden;
  color: #ffffff;
  background: linear-gradient(135deg, #0b358a 0%, #1764e8 66%, #7fb0ff 100%);
  box-shadow: 0 28rpx 56rpx rgba(31, 94, 255, 0.17);
}

.banner-content {
  position: relative;
  z-index: 2;
}

.home-hero-card .hero-badge {
  color: #1453d9;
  background: #ffffff;
}

.banner-title {
  margin-top: 20rpx;
  font-size: 56rpx;
  font-weight: 900;
  line-height: 1.08;
}

.banner-text {
  max-width: 380rpx;
  margin-top: 16rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 24rpx;
  line-height: 1.55;
}

.home-hero-card .hero-actions {
  margin-top: 26rpx;
}

.home-hero-card .button {
  min-height: 68rpx;
  border-radius: 999rpx;
}

.home-hero-card .button-primary {
  color: #1453d9;
  background: #ffffff;
  box-shadow: none;
}

.banner-visual {
  position: relative;
  z-index: 1;
  min-height: 264rpx;
}

.banner-image {
  position: absolute;
  right: 16rpx;
  bottom: -4rpx;
  width: 232rpx;
  height: 272rpx;
  padding: 16rpx;
  border-radius: 52rpx;
  background: #ffffff;
  box-shadow: 0 36rpx 68rpx rgba(6, 25, 70, 0.22);
}

.banner-side-image {
  position: absolute;
  right: 220rpx;
  bottom: 16rpx;
  width: 84rpx;
  height: 84rpx;
  border: 6rpx solid #ffffff;
  border-radius: 50%;
  background: #ffffff;
}

.order-mode-panel {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20rpx;
  margin-top: 20rpx;
}

.order-mode-card {
  display: grid;
  grid-template-columns: 76rpx minmax(0, 1fr);
  gap: 16rpx;
  align-items: center;
  min-height: 148rpx;
  padding: 24rpx;
  border: 1rpx solid #edf1f7;
  border-radius: 34rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 40rpx rgba(20, 48, 96, 0.05);
}

.order-mode-card.is-active {
  border-color: #c8d8ff;
  background: #f5f8ff;
}

.mode-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 900;
  background: #1f5eff;
}

.mode-title {
  display: block;
  font-size: 30rpx;
  font-weight: 900;
}

.mode-copy {
  display: block;
  margin-top: 8rpx;
  color: #6d7788;
  font-size: 22rpx;
}

.quick-strip {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 20rpx;
  padding: 24rpx 16rpx;
  border-radius: 36rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 40rpx rgba(20, 48, 96, 0.05);
}

.quick-strip navigator {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
  color: #182033;
  font-size: 24rpx;
  font-weight: 900;
}

.quick-strip text:first-child {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border-radius: 24rpx;
  color: #1f5eff;
  font-weight: 900;
  background: #eaf1ff;
}

.coupon-ribbon {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-top: 20rpx;
  padding: 24rpx 26rpx;
  border-radius: 34rpx;
  color: #6a3a12;
  background: linear-gradient(135deg, #fff1df 0%, #fff8f0 100%);
}

.ribbon-kicker {
  display: block;
  color: #ef5f20;
  font-size: 22rpx;
  font-weight: 900;
}

.ribbon-title {
  display: block;
  margin-top: 8rpx;
  font-size: 28rpx;
  font-weight: 900;
}

.ribbon-copy {
  display: block;
  margin-top: 8rpx;
  color: rgba(106, 58, 18, 0.72);
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.35;
}

.ribbon-action {
  flex: 0 0 auto;
  min-height: 64rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 64rpx;
  background: #ef5f20;
}

.home-main .section-card {
  border: 0;
  border-radius: 36rpx;
  box-shadow: 0 16rpx 40rpx rgba(20, 48, 96, 0.05);
}

.hot-section {
  overflow: hidden;
}

.home-product-scroll {
  white-space: nowrap;
}

.home-product-card {
  display: inline-block;
  width: 284rpx;
  margin-right: 20rpx;
  padding: 0;
  border: 1rpx solid #edf1f7;
  border-radius: 32rpx;
  overflow: hidden;
  vertical-align: top;
  background: #ffffff;
}

.home-product-cover {
  position: relative;
  display: block;
  width: 100%;
  height: 252rpx;
  overflow: hidden;
  background: #eef4ff;
}

.home-product-cover .cover-thumb {
  width: 100%;
  height: 100%;
  border-radius: 0;
}

.rank-badge {
  position: absolute;
  left: 16rpx;
  top: 16rpx;
  min-height: 44rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 44rpx;
  background: rgba(17, 24, 39, 0.72);
}

.home-product-card .product-body {
  padding: 18rpx;
}

.home-product-card .product-name {
  font-size: 28rpx;
  font-weight: 900;
}

.home-product-card .product-desc {
  display: -webkit-box;
  overflow: hidden;
  min-height: 62rpx;
  margin-top: 10rpx;
  color: #6d7788;
  font-size: 22rpx;
  line-height: 1.4;
  white-space: normal;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.home-product-card .price-line {
  margin-top: 16rpx;
}

.home-product-card .price {
  color: #ef5f20;
  font-size: 36rpx;
}

.product-buy-link {
  min-height: 52rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  color: #ffffff;
  font-size: 22rpx;
  line-height: 52rpx;
  background: #1f5eff;
}

.task-card {
  color: #ffffff;
  background: #111827;
}

.task-card .section-title,
.task-card .section-note,
.task-card .task-footnote {
  color: rgba(255, 255, 255, 0.88);
}

.task-card .section-link {
  color: #b8ccff;
}

.progress-track {
  height: 16rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
}

.progress-fill {
  display: block;
  width: 50%;
  height: 100%;
  border-radius: inherit;
  background: #ffffff;
}

.task-footnote {
  margin-top: 18rpx;
  font-size: 24rpx;
  font-weight: 700;
}
