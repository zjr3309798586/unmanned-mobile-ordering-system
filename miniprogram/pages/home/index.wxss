.hero {
  min-height: 330rpx;
  padding: 36rpx 30rpx;
  border-radius: 0 0 38rpx 38rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #ff7a1a 0%, #ff9f45 55%, #ffd0a1 100%);
  box-shadow: 0 18rpx 38rpx rgba(255, 122, 26, 0.22);
}

.hero-badge {
  display: inline-flex;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  color: #ff7a1a;
  font-size: 22rpx;
  font-weight: 800;
  background: #ffffff;
}

.hero-title {
  margin-top: 20rpx;
  white-space: pre-line;
  font-size: 54rpx;
  font-weight: 900;
  line-height: 1.14;
}

.hero-text {
  margin-top: 16rpx;
  max-width: 520rpx;
  color: rgba(255, 255, 255, 0.88);
  font-size: 26rpx;
  line-height: 1.55;
}

.hero-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 26rpx;
}

.hero .button.primary {
  color: #ff7a1a;
  background: #ffffff;
}

.hero .button.secondary {
  color: #ffffff;
  background: rgba(255, 255, 255, 0.18);
}

.service-grid,
.coupon-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  margin-top: 20rpx;
}

.service-card,
.coupon-card {
  padding: 22rpx;
  border: 1rpx solid #e7ebf2;
  border-radius: 24rpx;
  background: #ffffff;
}

.service-card.active {
  border-color: #ffd8bc;
  background: #fff7f0;
}

.service-icon {
  display: inline-flex;
  width: 54rpx;
  height: 54rpx;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  color: #ff7a1a;
  font-weight: 900;
  background: #fff1e6;
}

.product-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 18rpx;
}
