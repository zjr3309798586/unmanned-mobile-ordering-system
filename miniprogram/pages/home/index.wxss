page { background: #fff; }

.home-shell {
  background: #ffffff;
  min-height: 100vh;
  padding-bottom: 200rpx;
  color: #191c23;
}

/* 顶部胶囊 */
.home-topbar { position: absolute; top: 0; left: 0; width: 100%; z-index: 40; padding: 96rpx 32rpx 16rpx; display: flex; justify-content: flex-end; }
.ht-capsule { display: inline-flex; align-items: center; padding: 8rpx 24rpx; border-radius: 999rpx; border: 1rpx solid #e0e2ec; background: rgba(255,255,255,0.85); color: #414754; box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.04); }
.ht-cap-btn { display: inline-flex; align-items: center; justify-content: center; padding: 0 12rpx; }
.ht-cap-sep { width: 2rpx; height: 28rpx; background: #c1c6d6; margin: 0 12rpx; }
.ht-icon-dots { font-size: 28rpx; letter-spacing: -2rpx; }
.ht-icon-loc { font-size: 24rpx; }

/* 轮播 */
.carousel { width: 100%; height: 600rpx; position: relative; }
.c-slide { position: relative; width: 100%; height: 100%; overflow: hidden; }

.c-banner-img { width: 100%; height: 100%; }

.c-banner-caption { position: absolute; left: 32rpx; bottom: 84rpx; z-index: 30; max-width: 70%; padding: 20rpx 24rpx; border-radius: 32rpx; color: #071a44; background: rgba(255,255,255,0.76); border: 1rpx solid rgba(255,255,255,0.76); box-shadow: 0 24rpx 64rpx rgba(31,111,255,0.13); }
.c-banner-title { display: block; font-size: 36rpx; line-height: 1.18; font-weight: 800; }
.c-banner-subtitle { display: block; margin-top: 6rpx; font-size: 24rpx; color: #5c6a80; line-height: 1.35; }

.c-banner-content { position: absolute; top: 120rpx; left: 40rpx; z-index: 30; }

.c-title-row { display: flex; align-items: center; margin-bottom: 8rpx; }
.c-title { font-size: 56rpx; font-weight: 700; color: #191c23; letter-spacing: -1rpx; }
.c-badge-circ { margin-left: 16rpx; display: inline-flex; align-items: center; justify-content: center; width: 48rpx; height: 48rpx; border-radius: 50%; background: #005bbf; color: #fff; font-size: 18rpx; line-height: 1.1; text-align: center; }

.c-price-row { display: flex; align-items: baseline; color: #005bbf; font-weight: 700; }
.c-pyuan { font-size: 36rpx; }
.c-pint { font-size: 72rpx; margin: 0 4rpx; letter-spacing: -2rpx; line-height: 1; }
.c-pdec { font-size: 40rpx; margin-right: 4rpx; }
.c-pstart { font-size: 24rpx; font-weight: 500; padding: 0 8rpx; border: 1rpx solid #005bbf; border-radius: 999rpx; margin-left: 8rpx; line-height: 1.4; }
.c-pdrink { font-size: 40rpx; color: #191c23; margin-left: 12rpx; }

.c-product { position: absolute; right: 0; bottom: 160rpx; width: 540rpx; height: 540rpx; z-index: 5; }

.c-banner-card { padding: 24rpx 40rpx; border-radius: 32rpx; box-shadow: 0 16rpx 48rpx rgba(0,0,0,0.1); }
.c-banner-card-blue { background: rgba(0,91,191,0.92); color: #fff; }
.c-banner-card-white { background: rgba(255,255,255,0.88); color: #005bbf; }
.c-banner-h { font-size: 48rpx; font-weight: 700; letter-spacing: -0.6rpx; }
.c-banner-h-blue { color: #005bbf; }
.c-banner-p { display: block; margin-top: 8rpx; font-size: 28rpx; opacity: 0.9; }
.c-banner-p-dim { color: #414754; opacity: 1; }

.c-mascot { position: absolute; right: 0; bottom: 120rpx; width: 620rpx; height: 620rpx; z-index: 5; }

/* 指示器(放在 swiper 之外悬浮) */
.c-indicators { position: absolute; top: 540rpx; left: 50%; transform: translateX(-50%); display: flex; gap: 12rpx; z-index: 35; }
.c-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: rgba(0,91,191,0.2); transition: all 0.3s ease; }
.c-dot.is-active { width: 36rpx; border-radius: 12rpx; background: #005bbf; }

.c-disclaim { display: none; }

/* 内容覆盖 */
.content-overlay { position: relative; z-index: 20; margin-top: -48rpx; background: #fff; border-top-left-radius: 56rpx; border-top-right-radius: 56rpx; padding: 0 32rpx 200rpx; box-shadow: 0 -20rpx 60rpx rgba(0,0,0,0.05); }

/* 会员卡 */
.member-progress-card { display: flex; align-items: center; padding: 48rpx 40rpx 40rpx; margin-top: 16rpx; margin-bottom: 32rpx; }
.mpc-avatar { width: 104rpx; height: 104rpx; border-radius: 50%; border: 2rpx solid #005bbf; margin-right: 24rpx; display: flex; align-items: center; justify-content: center; flex: 0 0 auto; }
.mpc-avatar-icon { font-size: 56rpx; color: #9ca3af; }
.mpc-body { flex: 1 1 auto; min-width: 0; }
.mpc-name { font-size: 30rpx; color: #191c23; margin-bottom: 16rpx; white-space: nowrap; overflow: hidden; }
.mpc-row { display: flex; align-items: center; justify-content: space-between; gap: 24rpx; }
.mpc-progress { display: flex; align-items: center; gap: 16rpx; flex: 1 1 auto; min-width: 0; }
.mpc-progress-bg { width: 192rpx; height: 12rpx; border-radius: 6rpx; background: #f2f3fd; overflow: hidden; }
.mpc-progress-fill { height: 100%; background: #005bbf; border-radius: 6rpx; }
.mpc-count { color: #414754; font-size: 24rpx; }
.mpc-btn { display: inline-flex; align-items: center; justify-content: center; padding: 8rpx 28rpx; border-radius: 999rpx; background: #005bbf; color: #fff; font-size: 24rpx; font-weight: 500; flex: 0 0 auto; }

.home-divider { margin: 0 16rpx; height: 1rpx; background: #e0e2ec; }

/* 自取/外卖 */
.pickup-split { padding: 16rpx 0; margin: 48rpx 0 64rpx; display: flex; align-items: center; }
.ps-side { flex: 1 1 0; display: flex; flex-direction: column; align-items: center; justify-content: center; position: relative; }
.ps-zh { font-size: 56rpx; font-weight: 400; color: #191c23; margin-bottom: 8rpx; }
.ps-en { font-size: 28rpx; color: #414754; font-weight: 300; }
.ps-divider { width: 2rpx; height: 96rpx; background: #e0e2ec; margin: 0 32rpx; }
.ps-bubble { position: absolute; top: -48rpx; right: 50%; transform: translateX(50%); background: #005bbf; color: #fff; font-size: 20rpx; padding: 4rpx 12rpx; border-radius: 8rpx; white-space: nowrap; }

/* 快捷入口 */
.quick-grid { display: grid; grid-template-columns: repeat(4, minmax(0,1fr)); gap: 16rpx; margin-bottom: 16rpx; }
.qg-item { display: flex; flex-direction: column; align-items: center; padding: 8rpx; }
.qg-icon { position: relative; display: flex; align-items: center; justify-content: center; width: 104rpx; height: 104rpx; margin-bottom: 16rpx; }
.qg-icon-99 { border: 2rpx solid #191c23; border-radius: 50%; }
.qg-99-num { font-size: 44rpx; font-weight: 700; color: #191c23; }
.qg-99-tag { position: absolute; top: -8rpx; right: -20rpx; background: #005bbf; color: #fff; font-size: 18rpx; padding: 4rpx 8rpx; border-radius: 4rpx; }
.qg-icon-30 { background: #FF6B00; border-radius: 50%; }
.qg-30-num { color: #fff; font-size: 24rpx; font-weight: 700; line-height: 1.1; text-align: center; }
.qg-30-tag { position: absolute; top: -8rpx; right: -8rpx; width: 32rpx; height: 32rpx; border-radius: 50%; background: #005bbf; color: #fff; font-size: 18rpx; font-weight: 500; display: flex; align-items: center; justify-content: center; border: 2rpx solid #fff; }
.qg-icon-points, .qg-icon-code { display: flex; align-items: center; justify-content: center; }
.qg-points-icon, .qg-code-icon { font-size: 56rpx; }

.qg-h { font-size: 26rpx; color: #191c23; margin-bottom: 4rpx; }
.qg-sub { font-size: 22rpx; color: #414754; }

.home-recommend { margin-top: 44rpx; }
.home-section-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 32rpx; margin-bottom: 24rpx; }
.home-eyebrow { display: block; margin-bottom: 4rpx; font-size: 22rpx; font-weight: 800; letter-spacing: 3rpx; color: #1f6fff; text-transform: uppercase; }
.home-section-title { display: block; color: #071a44; font-size: 40rpx; line-height: 1.2; font-weight: 800; }
.home-section-more { color: #6b7890; font-size: 26rpx; }
.home-product-row { width: 100%; white-space: nowrap; padding: 4rpx 4rpx 16rpx; }
.home-product-card { display: inline-flex; flex-direction: column; vertical-align: top; width: 264rpx; min-height: 396rpx; margin-right: 24rpx; border-radius: 36rpx; overflow: hidden; background: #fff; border: 1rpx solid rgba(31,111,255,0.1); box-shadow: 0 28rpx 68rpx rgba(31,111,255,0.1); color: #071a44; }
.home-product-card image { width: 100%; height: 208rpx; background: #f4f8ff; }
.home-product-name { margin-top: 18rpx; padding: 0 20rpx; font-size: 28rpx; line-height: 1.25; font-weight: 800; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.home-product-desc { margin-top: 8rpx; padding: 0 20rpx; min-height: 60rpx; color: #6b7890; font-size: 22rpx; line-height: 1.35; white-space: normal; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.home-product-price { margin-top: 16rpx; padding: 0 20rpx 20rpx; color: #f04b1f; font-size: 32rpx; font-weight: 800; }

.home-notice-card { display: flex; align-items: center; gap: 24rpx; margin: 24rpx 0 8rpx; padding: 26rpx 28rpx; border-radius: 36rpx; background: linear-gradient(135deg, #f5f9ff, #ffffff); border: 1rpx solid rgba(31,111,255,0.1); box-shadow: 0 24rpx 64rpx rgba(31,111,255,0.08); }
.home-notice-icon { flex: 0 0 auto; width: 72rpx; height: 72rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #1f6fff; background: rgba(31,111,255,0.1); font-size: 32rpx; font-weight: 900; }
.home-notice-main { min-width: 0; flex: 1 1 auto; }
.home-notice-title { display: block; color: #071a44; font-size: 28rpx; font-weight: 800; }
.home-notice-text { display: block; margin-top: 6rpx; color: #6b7890; font-size: 24rpx; line-height: 1.45; }

/* 底部导航 */
.bottom-nav { position: fixed; left: 0; right: 0; bottom: 0; z-index: 50; display: grid; grid-template-columns: repeat(5, minmax(0,1fr)); min-height: 156rpx; padding: 16rpx 16rpx calc(16rpx + env(safe-area-inset-bottom)); background: rgba(255,255,255,0.96); border-top: 1rpx solid rgba(31,111,255,0.1); box-shadow: 0 -16rpx 40rpx rgba(31,111,255,0.08); }
.nav-item { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4rpx; color: #5c6a80; font-size: 24rpx; }
.nav-icon { display: flex; align-items: center; justify-content: center; width: 68rpx; height: 68rpx; }
.nav-logo-icon { width: 56rpx; height: 56rpx; filter: grayscale(1) brightness(0.55); opacity: 0.9; }
.nav-item.is-active { color: #1f6fff; }
.nav-item.is-active .nav-logo-icon { filter: none; opacity: 1; }
